kbi:R2_int1 a kb:BlueprintFindingRecommendation,
        owl:NamedIndividual ;
    rdfs:label "R2 integration: blueprint finding F71 (proposed)"@en ;
    kb:externalReference "Proposed finding number F71 is illustrative; actual integration number is the ratifier's call." ;
    kb:proposedAddendumText "Quality does not propagate across RDODI stages — each stage gates its own output. An upstream PASS never licenses a downstream PASS. The widget-stage adoption (Stage4.H–K) is this principle's structural response." ;
    skos:definition "Recommended integration: a blueprint finding (proposed F71) stating that quality does not propagate across RDODI stages and the widget-stage adoption is its structural response."@en .

