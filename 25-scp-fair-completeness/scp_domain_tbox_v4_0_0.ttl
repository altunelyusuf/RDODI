@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scp: <http://rdodi.org/scp/domain#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

scp:PrefixGlossary a owl:NamedIndividual ;
    scp:prefixGlossary "{\"@prefix\": \"a declaration that defines a short alias (prefix) for a long namespace IRI, so you can write owl:Thing instead of the full address\", \"owl:\": \"the Web Ontology Language vocabulary (http://www.w3.org/2002/07/owl#) \\u2014 terms for classes, properties and logical axioms\", \"rdf:\": \"the core RDF vocabulary \\u2014 the basic \\\"type\\\" relation and graph primitives\", \"rdfs:\": \"RDF Schema (http://www.w3.org/2000/01/rdf-schema#) \\u2014 classes, subclass hierarchies, property domains/ranges\", \"prov:\": \"PROV-O, the W3C provenance vocabulary (http://www.w3.org/ns/prov#) \\u2014 who/what/when produced a piece of data\", \"sh:\": \"SHACL, the Shapes Constraint Language namespace (http://www.w3.org/ns/shacl#) \\u2014 data-validation constraints\", \"skos:\": \"SKOS (http://www.w3.org/2004/02/skos/core#) \\u2014 a vocabulary for thesauri, taxonomies and concept labels\", \"schema:\": \"schema.org \\u2014 the web-wide vocabulary search engines read for products, people, events, etc.\", \"bfo:\": \"Basic Formal Ontology \\u2014 the standard upper-ontology namespace used to align domain ontologies\", \"xsd:\": \"XML Schema Datatypes \\u2014 value types such as xsd:decimal, xsd:string, xsd:dateTime\", \"wd:\": \"a Wikidata entity (e.g. wd:Q762 is Leonardo da Vinci)\", \"wdt:\": \"a Wikidata property used in a truthy statement (e.g. wdt:P569 = date of birth)\", \":\": \"the default/local namespace of this document \\u2014 your own terms, like ex:tshirt_A\"}" .

scp:PrimitivesPrimer a owl:NamedIndividual ;
    scp:primerData "{\"intro\": \"Before the standards (RDF, OWL, SPARQL) make sense, four small ideas have to be clear: the triple, the class, the property, and the individual. Everything in semantic technology is built from these. This primer defines each in plain language, shows how they fit together, and ends with one worked example that uses all of them at once.\", \"triple\": {\"title\": \"The triple \\u2014 the atom of meaning\", \"text\": \"Every fact in a knowledge graph is a triple: three parts \\u2014 subject, predicate, object \\u2014 read like a tiny sentence. The subject is what the fact is about, the predicate is the relationship, and the object is the value or the other thing. \\u201can example t-shirt \\u2014 has brand \\u2014 ExBrand\\u201d is one triple. Millions of triples sharing subjects and objects form a graph.\", \"parts\": [[\"Subject\", \"what the fact is about\", \"ex:tshirt_A\"], [\"Predicate\", \"the relationship (a property)\", \"hasBrand\"], [\"Object\", \"the value or related thing\", \"\\\"ExBrand\\\"\"]], \"code\": \"ex:tshirt_A   :hasBrand   \\\"ExBrand\\\" .\\n#  subject    predicate    object\", \"lang\": \"turtle\"}, \"primitives\": [{\"name\": \"Class\", \"icon\": \"\\u25a2\", \"color\": \"#4a7c8c\", \"is\": \"A class is a category or type of thing \\u2014 a set of individuals that share characteristics. \\u201cProduct\\u201d, \\u201cStore\\u201d, \\u201cClothing\\u201d are classes. A class is like a table definition or an OOP class: it describes a kind, not a specific item.\", \"repr\": \"declared with rdf:type owl:Class; arranged into a hierarchy with rdfs:subClassOf\", \"code\": \":Product  a owl:Class .\\n:Clothing a owl:Class ; rdfs:subClassOf :Product .\\n:TShirt   a owl:Class ; rdfs:subClassOf :Clothing .\", \"analogy\": \"\\u2248 a table / an OOP class / a category\"}, {\"name\": \"Individual\", \"icon\": \"\\u25cf\", \"color\": \"#5b8a72\", \"is\": \"An individual (or instance) is a specific, concrete thing that belongs to a class. \\u201cex:tshirt_A\\u201d is an individual of class \\u201cTShirt\\u201d; \\u201cex:store_1\\u201d is an individual of class \\u201cStore\\u201d. Individuals live in the data (the ABox); classes live in the schema (the TBox).\", \"repr\": \"linked to its class with rdf:type (written a in Turtle)\", \"code\": \"ex:tshirt_A   a :TShirt .\\nex:store_1 a :Store .\", \"analogy\": \"\\u2248 a row / an object instance / a specific thing\"}, {\"name\": \"Property\", \"icon\": \"\\u2192\", \"color\": \"#b5803a\", \"is\": \"A property is a kind of relationship or attribute that connects things. Properties are the predicates of triples. There are two kinds: an object property links two individuals (Item \\u2192 Store), and a datatype property links an individual to a literal value (Item \\u2192 \\u201c199.99\\u201d).\", \"repr\": \"object property: owl:ObjectProperty; datatype property: owl:DatatypeProperty; each can declare rdfs:domain (subject class) and rdfs:range (object class/type)\", \"code\": \":soldInStore a owl:ObjectProperty ;\\n  rdfs:domain :Product ; rdfs:range :Store .\\n:price a owl:DatatypeProperty ;\\n  rdfs:domain :Product ; rdfs:range xsd:decimal .\", \"analogy\": \"\\u2248 a column / a foreign key / an attribute\"}, {\"name\": \"Literal\", \"icon\": \"\\u201c\\u201d\", \"color\": \"#9a5b6e\", \"is\": \"A literal is a raw data value \\u2014 a number, string, date, or boolean \\u2014 as opposed to a thing with an identity (an IRI). \\u201cExBrand\\u201d, 199.99, and 2026-07-01 are literals. Literals only ever appear as the object of a triple, never as a subject, and they carry a datatype.\", \"repr\": \"a quoted value, optionally with a datatype (^^xsd:decimal) or language tag (@tr)\", \"code\": \"ex:tshirt_A :price \\\"199.99\\\"^^xsd:decimal ;\\n          :name  \\\"Pamuklu Ti\\u015f\\u00f6rt\\\"@tr .\", \"analogy\": \"\\u2248 a cell value / a primitive (int, string, date)\"}], \"relations\": [[\"Individual\", \"rdf:type / a\", \"Class\", \"an individual is an instance of a class\", \"ex:tshirt_A a :TShirt\"], [\"Class\", \"rdfs:subClassOf\", \"Class\", \"one class is a kind of another (inheritance)\", \":TShirt rdfs:subClassOf :Clothing\"], [\"Individual\", \"object property\", \"Individual\", \"two individuals linked by a relationship\", \"ex:tshirt_A :soldInstore ex:store_1\"], [\"Individual\", \"datatype property\", \"Literal\", \"an individual given a data value\", \"ex:tshirt_A :price \\\"199.99\\\"\"], [\"Property\", \"rdfs:domain\", \"Class\", \"the property applies to subjects of this class\", \":price rdfs:domain :Product\"], [\"Property\", \"rdfs:range\", \"Class / datatype\", \"the property points to this class or value type\", \":price rdfs:range xsd:decimal\"]], \"tbox_abox\": \"Classes and properties together form the schema \\u2014 the TBox (\\u201cterminology box\\u201d): what kinds of things and relationships can exist. Individuals and their literal values form the data \\u2014 the ABox (\\u201cassertion box\\u201d): what actually exists. The same vocabulary describes both, which is why one query can move seamlessly from schema to data.\", \"worked\": {\"title\": \"One example using class, subclass, individual, object property, datatype property, and literal together\", \"code\": \"@prefix owl:  <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .\\n\\n# --- TBox: classes ---\\n:Product  a owl:Class .\\n:Clothing a owl:Class ; rdfs:subClassOf :Product .\\n:TShirt   a owl:Class ; rdfs:subClassOf :Clothing .\\n:Store    a owl:Class .\\n\\n# --- TBox: properties ---\\n:soldInStore a owl:ObjectProperty ;\\n  rdfs:domain :Product ; rdfs:range :Store .\\n:price a owl:DatatypeProperty ;\\n  rdfs:domain :Product ; rdfs:range xsd:decimal .\\n\\n# --- ABox: individuals + literals ---\\nex:tshirt_A   a :TShirt ;\\n  :soldInstore ex:store_1 ;\\n  :price \\\"199.99\\\"^^xsd:decimal .\\nex:store_1 a :Store .\", \"lang\": \"turtle\", \"steps\": [\"Define classes: Product \\u2290 Clothing \\u2290 TShirt, and Store\", \"Define an object property (soldInStore) and a datatype property (price) with domain/range\", \"Create individual ex:tshirt_A, typed as a TShirt\", \"Link it to individual ex:store_1 via the object property\", \"Give it a literal value via the datatype property\", \"A reasoner now knows ex:tshirt_A is also a Clothing and a Product (via subclass)\"], \"result\": {\"cols\": [\"element\", \"kind\", \"from\"], \"rows\": [[\"Product / Clothing / TShirt / Store\", \"Class\", \"TBox\"], [\"soldInStore\", \"Object property\", \"TBox\"], [\"price\", \"Datatype property\", \"TBox\"], [\"ex:tshirt_A, ex:store_1\", \"Individual\", \"ABox\"], [\"\\\"199.99\\\", \\\"ExBrand\\\"\", \"Literal\", \"ABox\"], [\"ex:tshirt_A is a Product\", \"inferred\", \"reasoner (subclass)\"]]}}, \"closing\": \"These four primitives \\u2014 class, individual, property, literal \\u2014 connected by the triple, are the whole foundation. RDF gives you triples; RDFS adds classes and the subclass/domain/range relationships; OWL adds richer property and class axioms; SPARQL queries the result. Every later concept on this page is a refinement of these same ideas.\"}" .

scp:ProvenanceLegend a owl:NamedIndividual ;
    scp:provLegend "{\"title\": \"How to read the data in these examples\", \"text\": \"Academic honesty requires distinguishing real, cited facts from invented teaching data. Every example here is labelled with one of three provenance markers:\", \"levels\": [{\"tag\": \"REAL \\u00b7 CITED\", \"color\": \"#3f7a4d\", \"mark\": \"\\u25c9\", \"desc\": \"A genuine, publicly verifiable fact, with a link to its source (e.g. a public standard\\u2019s real codes, linked to its official site).\"}, {\"tag\": \"PUBLIC PATTERN\", \"color\": \"#4a7c8c\", \"mark\": \"\\u25d0\", \"desc\": \"A real, standard structure or vocabulary used as the public documents define it (e.g. schema.org, SNOMED CT, Wikidata) \\u2014 the pattern is real, the specific instance is representative.\"}, {\"tag\": \"ILLUSTRATIVE\", \"color\": \"#b5803a\", \"mark\": \"\\u25cb\", \"desc\": \"Synthetic data invented only to demonstrate a concept, written in the example namespace ex: . NOT a real record. Never a real company\\u2019s actual SKU, store code, or price.\"}], \"rule\": \"Rule enforced throughout: no real company\\u2019s specific operational data (SKUs, store codes, prices) is asserted unless it is REAL\\u00b7CITED with a source. Invented specifics use the ex: namespace and are marked ILLUSTRATIVE.\"}" .

scp:TaxonomyExplainer a owl:NamedIndividual ;
    scp:taxonomyPageData "{\"intro\": \"A taxonomy is a controlled, structured way of organizing concepts into a hierarchy of broader and narrower terms. It is the oldest and most intuitive knowledge-organization structure \\u2014 Linnaeus classified life with one in 1735 \\u2014 and it remains the backbone of every search facet, content catalogue, and product navigation you use. In semantic technologies the taxonomy is the entry layer: the simplest formal structure on which richer ontologies and knowledge graphs are built.\", \"definition\": {\"text\": \"At its core a taxonomy is a set of concepts connected by hierarchical relationships. The defining relationship is broader/narrower (a parent\\u2013child, generic\\u2013specific, or whole\\u2013part link). Crucially, a concept is a unit of meaning, distinct from the words used to name it \\u2014 so one concept can carry a preferred label and many alternative labels across languages. This separation of concept from term is what lets a Turkish shopper's 'ti\\u015f\\u00f6rt' and an analyst's 'T-shirt' resolve to the same node.\", \"blocks\": [[\"Concept\", \"a unit of meaning with a stable identity (an IRI), not a word\"], [\"Preferred label\", \"the one canonical name for the concept\"], [\"Alternative labels\", \"synonyms and translations pointing to the same concept\"], [\"Broader / narrower\", \"the hierarchical parent\\u2013child relationship\"], [\"Related\", \"a non-hierarchical associative link between concepts\"], [\"Concept scheme\", \"the container that bounds one taxonomy/vocabulary\"]]}, \"types\": [{\"type\": \"Flat\", \"desc\": \"A single level of mutually exclusive categories, no nesting.\", \"ex\": \"Order status: New \\u00b7 Paid \\u00b7 Shipped \\u00b7 Returned\", \"shape\": \"flat\"}, {\"type\": \"Hierarchical (monohierarchy)\", \"desc\": \"Each concept has exactly one parent; a clean tree. Easy to maintain, but forces artificial choices.\", \"ex\": \"Women \\u2192 Clothing \\u2192 T-Shirt\", \"shape\": \"tree\"}, {\"type\": \"Polyhierarchy\", \"desc\": \"A concept may have more than one parent when the relationship is genuinely valid in each.\", \"ex\": \"\\\"Wetsuit\\\" under both Swimwear and Sportswear\", \"shape\": \"poly\"}, {\"type\": \"Faceted\", \"desc\": \"Several independent, mutually-exclusive dimensions combined at query time (post-coordination).\", \"ex\": \"Size \\u00d7 Colour \\u00d7 Brand \\u00d7 Price filters together\", \"shape\": \"facet\"}, {\"type\": \"Network\", \"desc\": \"Concepts linked by associative (related) relationships, not just hierarchy \\u2014 the bridge toward an ontology.\", \"ex\": \"\\\"Allergy\\\" related to \\\"Antihistamine\\\"\", \"shape\": \"network\"}], \"ontology_rel\": {\"text\": \"Taxonomies and ontologies are points on a spectrum of increasing formal expressivity, not rival technologies. A taxonomy gives you concepts and a broader/narrower hierarchy. A thesaurus adds related and synonym relationships. An ontology adds named relationship types, properties, logical axioms (disjointness, cardinality, inverses) and the ability to reason. Every ontology contains a taxonomy as its class hierarchy (rdfs:subClassOf) \\u2014 so a taxonomy is the skeleton an ontology puts muscle on.\", \"spectrum\": [[\"Controlled vocabulary\", \"a flat list of approved terms\", \"low\"], [\"Taxonomy\", \"+ broader/narrower hierarchy\", \"low-mid\"], [\"Thesaurus\", \"+ related + synonyms (SKOS)\", \"mid\"], [\"Ontology\", \"+ typed relations, properties, logical axioms, reasoning (OWL)\", \"high\"], [\"Knowledge graph\", \"+ populated instances (ABox) at scale\", \"high\"]]}, \"usage\": [{\"use\": \"Navigation & browse\", \"how\": \"Faceted menus and category trees on e-commerce and content sites.\", \"ex\": \"an online retailer\\u2019s Women \\u2192 Clothing \\u2192 T-Shirt menu\"}, {\"use\": \"Search & retrieval\", \"how\": \"Synonyms and hierarchy broaden/narrow queries; \\\"ti\\u015f\\u00f6rt\\\" finds T-shirts.\", \"ex\": \"A search for \\\"outerwear\\\" returns coats AND jackets\"}, {\"use\": \"Tagging & metadata\", \"how\": \"Consistent classification of documents, assets, products.\", \"ex\": \"DAM systems tagging images by subject\"}, {\"use\": \"Data integration\", \"how\": \"A shared taxonomy reconciles category names across systems.\", \"ex\": \"Aligning two chains\\u2019 product categories\"}, {\"use\": \"Analytics & rollup\", \"how\": \"Aggregate metrics up the hierarchy (sales by category \\u2192 department).\", \"ex\": \"Revenue rolled up Women\\u2019s \\u2192 Apparel\"}, {\"use\": \"AI grounding\", \"how\": \"A taxonomy constrains and disambiguates LLM outputs and labels training data.\", \"ex\": \"Classifying support tickets into known categories\"}], \"discovery\": [{\"method\": \"Top-down (deductive)\", \"how\": \"Start from domain experts and existing standards; decompose the domain into categories. Fast, authoritative, but can miss real usage.\"}, {\"method\": \"Bottom-up (inductive)\", \"how\": \"Cluster real content, search logs, and tags; let categories emerge from the data. Reflects actual usage, but noisier.\"}, {\"method\": \"Reuse existing standards\", \"how\": \"Adopt/extend a published scheme (GS1 GPC, schema.org, LCSH, SNOMED CT) instead of inventing one.\"}, {\"method\": \"Card sorting & user research\", \"how\": \"Have users group and label concepts; surfaces the user\\u2019s mental model and their language vs. domain language.\"}, {\"method\": \"LLM-assisted extraction\", \"how\": \"Use an LLM to propose candidate concepts/synonyms from a corpus, then have a steward + SHACL validate. Accelerates the draft; keeps humans in the loop.\"}, {\"method\": \"Validate with competency questions\", \"how\": \"List the questions the taxonomy must answer; if it can\\u2019t, it\\u2019s incomplete.\"}], \"multiple\": {\"text\": \"Real organizations run many taxonomies at once \\u2014 a product taxonomy, a geography taxonomy, an org-structure taxonomy, a topic taxonomy. SKOS handles this cleanly: each is a separate concept scheme with its own hierarchy type (generic-specific, whole-part, instances). The schemes stay internally consistent and are then connected by mapping relations (exactMatch, closeMatch, broadMatch) rather than by tangling their hierarchies together. This is how you keep multiple taxonomies aligned without merging them.\", \"mappings\": [[\"skos:exactMatch\", \"two concepts in different schemes mean the same thing\"], [\"skos:closeMatch\", \"near-equivalent, safe for retrieval but not for inference\"], [\"skos:broadMatch / narrowMatch\", \"a hierarchical link across schemes\"], [\"skos:relatedMatch\", \"an associative link across schemes\"]]}, \"comparison\": [{\"dim\": \"Storage\", \"trad\": \"Adjacency-list or nested-set tables; SharePoint Term Store; spreadsheets\", \"sem\": \"SKOS concepts in RDF, identified by IRIs\"}, {\"dim\": \"Identity\", \"trad\": \"A row id or a string label\", \"sem\": \"A global IRI \\u2014 stable across systems and languages\"}, {\"dim\": \"Synonyms\", \"trad\": \"A separate synonyms table, app-specific\", \"sem\": \"skos:altLabel, standard and multilingual\"}, {\"dim\": \"Polyhierarchy\", \"trad\": \"Hard in nested-set; bespoke in adjacency-list\", \"sem\": \"Native \\u2014 a concept can have multiple skos:broader\"}, {\"dim\": \"Multiple taxonomies\", \"trad\": \"Separate tables/systems, manual reconciliation\", \"sem\": \"Concept schemes + mapping relations\"}, {\"dim\": \"Interoperability\", \"trad\": \"Locked in the host system (CMS/DAM)\", \"sem\": \"Vendor-neutral linked data, reusable across systems\"}, {\"dim\": \"Querying\", \"trad\": \"Recursive SQL for ancestors/descendants\", \"sem\": \"SPARQL property paths (skos:broader+)\"}, {\"dim\": \"Governance\", \"trad\": \"Spreadsheet + steward\", \"sem\": \"Spreadsheet + steward too \\u2014 plus SHACL validation & versioning\"}], \"examples\": [{\"title\": \"Define a taxonomy concept with synonyms (SKOS)\", \"lang\": \"turtle\", \"code\": \"@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\\n:RetailScheme a skos:ConceptScheme .\\n:T-Shirt a skos:Concept ;\\n  skos:inScheme :RetailScheme ;\\n  skos:broader :Clothing ;\\n  skos:prefLabel \\\"T-Shirt\\\"@en ; skos:altLabel \\\"Ti\\u015f\\u00f6rt\\\"@tr .\", \"note\": \"One concept, one IRI, a parent, and multilingual labels \\u2014 the whole taxonomy node in five lines.\"}, {\"title\": \"Walk the hierarchy (SPARQL) vs recursive SQL\", \"lang\": \"sparql\", \"code\": \"# all descendants of :Clothing, any depth\\nSELECT ?c WHERE { ?c skos:broader+ :Clothing . }\", \"note\": \"A property path expresses \\\"any number of levels\\\" natively; the SQL equivalent needs a recursive CTE.\"}, {\"title\": \"Map across two taxonomies (multiple schemes)\", \"lang\": \"turtle\", \"code\": \":T-Shirt       skos:exactMatch gs1:TShirts .\\n:T-Shirt       skos:closeMatch other:Tops .\", \"note\": \"Two independently-maintained taxonomies stay separate but interoperable through mapping relations.\"}], \"graph_views\": [{\"name\": \"Tree (monohierarchy)\", \"desc\": \"The classic taxonomy shape \\u2014 one parent per node.\", \"shape\": \"tree\"}, {\"name\": \"DAG (polyhierarchy)\", \"desc\": \"Multiple parents \\u2014 a directed acyclic graph, not a pure tree.\", \"shape\": \"poly\"}, {\"name\": \"Facet matrix\", \"desc\": \"Independent dimensions combined at query time.\", \"shape\": \"facet\"}, {\"name\": \"Network (related links)\", \"desc\": \"Associative links turn the tree into a graph \\u2014 the bridge to ontology.\", \"shape\": \"network\"}], \"closing\": \"A taxonomy is where knowledge organization begins and where most projects should start: it is cheap to build, easy to govern with a spreadsheet and a steward, and immediately useful for navigation, search, and integration. Modeling it in SKOS rather than in a proprietary table costs little and buys global identity, multilingual synonyms, native polyhierarchy, clean multi-taxonomy mapping, and a direct upgrade path \\u2014 because the taxonomy you build today is exactly the class hierarchy your ontology will use tomorrow.\"}" .

scp:TermGlossary a owl:NamedIndividual ;
    scp:termGlossary "{\"a \": \"shorthand for rdf:type \\u2014 \\\"is a\\\"\", \"rdfs:subClassOf\": \"declares one class is a kind of another \\u2014 the IS-A / type hierarchy (transitive)\", \"rdfs:subPropertyOf\": \"one property is a specialization of another\", \"rdfs:domain\": \"the class a property applies to\", \"rdfs:range\": \"the class a property points to\", \"owl:Class\": \"declares a category of things\", \"owl:ObjectProperty\": \"a relationship between two things\", \"owl:inverseOf\": \"two properties are reverses of each other\", \"owl:disjointWith\": \"no individual can belong to both classes\", \"owl:TransitiveProperty\": \"if A\\u2192B and B\\u2192C then A\\u2192C is inferred\", \"SELECT\": \"choose which variables to return\", \"WHERE\": \"the graph pattern to match\", \"ORDER BY\": \"sort the results\", \"GROUP BY\": \"aggregate rows into groups\", \"wd:\": \"a Wikidata entity (e.g. wd:Q762 = Leonardo da Vinci)\", \"wdt:\": \"a Wikidata property (e.g. wdt:P569 = date of birth)\", \"sh:NodeShape\": \"a set of constraints on nodes\", \"sh:targetClass\": \"which class the shape validates\", \"sh:property\": \"one constraint on a property\", \"sh:path\": \"which property is constrained\", \"sh:minCount\": \"minimum number of values required\", \"sh:maxCount\": \"maximum number of values allowed\", \"sh:hasValue\": \"the property must have this specific value\", \"sh:datatype\": \"the required value type\", \"sh:not\": \"negates a constraint\", \"skos:Concept\": \"a unit of meaning (not a word)\", \"skos:ConceptScheme\": \"the container bounding one taxonomy/vocabulary\", \"skos:prefLabel\": \"the preferred name\", \"skos:altLabel\": \"an alternative name / synonym\", \"skos:broader\": \"a broader (parent) concept\", \"skos:inScheme\": \"says which scheme a concept belongs to\", \"skos:exactMatch\": \"two concepts in different schemes mean the same thing\", \"skos:closeMatch\": \"near-equivalent across schemes\", \"prov:wasGeneratedBy\": \"which activity produced this entity\", \"prov:wasAttributedTo\": \"which agent is responsible\", \"prov:used\": \"what an activity consumed\", \"prov:generatedAtTime\": \"when the entity was produced\", \"schema:\": \"schema.org \\u2014 the web-wide vocabulary for products, people, events\", \"@context\": \"maps JSON keys to IRIs (JSON-LD)\", \"@type\": \"the entity\\u2019s class\", \"bfo:\": \"the Basic Formal Ontology namespace (upper ontology)\", \"SELECT \": \"choose which columns to return (SQL)\", \"FROM\": \"which table to read\", \"JOIN\": \"combine rows from two tables on a key\", \"GROUP BY \": \"aggregate rows (SQL)\", \"PRIMARY KEY\": \"the unique identifier of a row\", \"FOREIGN KEY\": \"a link to another table\\u2019s key\", \"CHECK\": \"a constraint forbidding invalid values\", \"INSERT\": \"add a new row\", \"WITH RECURSIVE\": \"a recursive query (walks a hierarchy)\", \"MATCH\": \"Cypher\\u2019s pattern-matching clause\", \"RETURN\": \"what to output (Cypher)\", \"CREATE\": \"create nodes/relationships (Cypher)\", \"kg.query\": \"retrieve a subgraph with a query\", \"llm.generate\": \"the model writes an answer from given context\", \"predict_link\": \"score how likely a missing edge is\", \":inCategory\": \"relates a product to its category (a domain object property)\"}" .

scp:TradVsSemantic a scp:ComparisonPage,
        owl:NamedIndividual ;
    scp:comparisonData "{\"intro\": \"Semantic technologies do not replace traditional software development — they shift where meaning lives. In a traditional system, meaning is implicit: encoded in code, database schemas, and the heads of developers. In a semantic system, meaning is explicit: declared in ontologies and graphs that both humans and machines can read and reason over. This page compares the two paradigms across the dimensions that matter in practice, and shows how modern teams synthesize them.\", \"differences\": [{\"dim\": \"Where meaning lives\", \"trad\": \"Implicit — in code, schema, and developers’ heads\", \"sem\": \"Explicit — declared in ontologies and graphs, machine-readable\"}, {\"dim\": \"Data model\", \"trad\": \"Fixed relational tables / typed objects\", \"sem\": \"Flexible triples forming a graph; schema can evolve\"}, {\"dim\": \"Schema change\", \"trad\": \"Migrations; often breaking and costly\", \"sem\": \"Add new classes/properties without breaking existing data\"}, {\"dim\": \"Integration\", \"trad\": \"Point-to-point; N systems → ~N² connectors\", \"sem\": \"Align to shared vocabularies/upper ontology → ~N\"}, {\"dim\": \"Logic / rules\", \"trad\": \"Hand-coded in application code\", \"sem\": \"Declared as axioms; a reasoner derives consequences\"}, {\"dim\": \"Validation\", \"trad\": \"Imperative checks scattered in code\", \"sem\": \"Declarative SHACL shapes, centralized & reusable\"}, {\"dim\": \"Querying\", \"trad\": \"SQL over known tables\", \"sem\": \"SPARQL graph patterns, paths, federation\"}, {\"dim\": \"Open vs closed world\", \"trad\": \"Closed-world: absent = false\", \"sem\": \"Open-world: absent = unknown (DL); SHACL adds closed checks\"}, {\"dim\": \"Interoperability\", \"trad\": \"Bespoke APIs and message formats\", \"sem\": \"Global IRIs + shared vocabularies (schema.org, FIBO, SNOMED)\"}], \"similarities\": [\"Both need disciplined modeling — an ER diagram and a TBox are both deliberate conceptual models.\", \"Both have versioning, testing, CI/CD, and code review (ontologies are versioned and tested too).\", \"Both separate schema (DDL / TBox) from data (rows / ABox).\", \"Both use query languages with formal semantics (SQL and SPARQL share relational-algebra roots).\", \"Both care about constraints and integrity (CHECK constraints ↔ SHACL shapes).\", \"Both are engineering disciplines with methodologies, tools, and design patterns.\"], \"methodologies\": [{\"stage\": \"Requirements\", \"trad\": \"User stories, use cases\", \"sem\": \"Competency questions the ontology must answer\"}, {\"stage\": \"Design\", \"trad\": \"UML class/ER diagrams\", \"sem\": \"Ontology modeling (Protégé), reuse of upper/domain ontologies\"}, {\"stage\": \"Build\", \"trad\": \"Code + DB schema (DDL)\", \"sem\": \"TBox axioms + ABox population + SHACL shapes\"}, {\"stage\": \"Test\", \"trad\": \"Unit/integration tests\", \"sem\": \"SHACL validation + competency-question SPARQL + reasoner consistency\"}, {\"stage\": \"Process\", \"trad\": \"Agile / Scrum / DevOps\", \"sem\": \"Iterative ontology engineering (e.g. NeOn, METHONTOLOGY, agile ontology dev)\"}, {\"stage\": \"Maintenance\", \"trad\": \"Refactoring, migrations\", \"sem\": \"Ontology evolution, alignment, modular imports\"}], \"tools\": [{\"cat\": \"Modeling / IDE\", \"trad\": [[\"IntelliJ IDEA\", \"https://www.jetbrains.com/idea/\"], [\"VS Code\", \"https://code.visualstudio.com/\"], [\"dbdiagram.io\", \"https://dbdiagram.io/\"]], \"sem\": [[\"Protégé\", \"https://protege.stanford.edu/\"], [\"TopBraid EDG\", \"https://www.topquadrant.com/\"], [\"WebVOWL\", \"https://service.tib.eu/webvowl/\"]]}, {\"cat\": \"Storage\", \"trad\": [[\"PostgreSQL\", \"https://www.postgresql.org/\"], [\"MySQL\", \"https://www.mysql.com/\"], [\"MongoDB\", \"https://www.mongodb.com/\"]], \"sem\": [[\"GraphDB\", \"https://graphdb.ontotext.com/\"], [\"Apache Jena\", \"https://jena.apache.org/\"], [\"Stardog\", \"https://www.stardog.com/\"], [\"Neo4j\", \"https://neo4j.com/\"]]}, {\"cat\": \"Query / access\", \"trad\": [[\"SQL\", \"https://www.iso.org/standard/76583.html\"], [\"Hibernate\", \"https://hibernate.org/\"], [\"Prisma\", \"https://www.prisma.io/\"]], \"sem\": [[\"SPARQL\", \"https://www.w3.org/TR/sparql11-query/\"], [\"RDFLib\", \"https://rdflib.readthedocs.io/\"], [\"rdf.js\", \"https://rdf.js.org/\"]]}, {\"cat\": \"Validation\", \"trad\": [[\"JSON Schema\", \"https://json-schema.org/\"], [\"Hibernate Validator\", \"https://hibernate.org/validator/\"]], \"sem\": [[\"SHACL\", \"https://www.w3.org/TR/shacl/\"], [\"pySHACL\", \"https://github.com/RDFLib/pySHACL\"], [\"ShEx\", \"https://shex.io/\"]]}, {\"cat\": \"Reasoning\", \"trad\": [[\"(logic in app code)\", \"\"]], \"sem\": [[\"HermiT\", \"http://www.hermit-reasoner.com/\"], [\"Openllet\", \"https://github.com/Galigator/openllet\"], [\"ELK\", \"https://github.com/liveontologies/elk-reasoner\"]]}, {\"cat\": \"Standards\", \"trad\": [[\"OpenAPI\", \"https://www.openapis.org/\"], [\"gRPC\", \"https://grpc.io/\"]], \"sem\": [[\"RDF 1.1\", \"https://www.w3.org/TR/rdf11-concepts/\"], [\"OWL 2\", \"https://www.w3.org/TR/owl2-overview/\"], [\"JSON-LD\", \"https://json-ld.org/\"]]}, {\"cat\": \"AI integration\", \"trad\": [[\"LangChain\", \"https://www.langchain.com/\"], [\"Pinecone\", \"https://www.pinecone.io/\"]], \"sem\": [[\"Microsoft GraphRAG\", \"https://github.com/microsoft/graphrag\"], [\"LightRAG\", \"https://github.com/HKUDS/LightRAG\"], [\"PyKEEN\", \"https://pykeen.readthedocs.io/\"]]}], \"synthesis\": [{\"pattern\": \"Semantic layer over relational data\", \"how\": \"Keep the relational system of record; expose it as RDF via R2RML mappings (Ontop, Morph) so a knowledge graph sits *over* the database without replacing it.\", \"impact\": \"Adds integration & reasoning with zero migration of the source system.\"}, {\"pattern\": \"JSON-LD in ordinary APIs\", \"how\": \"Annotate existing REST/JSON responses with a JSON-LD @context. The payload stays normal JSON for app developers but becomes linked data for machines and search engines.\", \"impact\": \"Semantic interoperability with no change to client code.\"}, {\"pattern\": \"Ontology as the integration backbone\", \"how\": \"Each microservice keeps its own store; a shared domain ontology + IRIs reconcile their data into one queryable graph for analytics and AI.\", \"impact\": \"Turns N² point-to-point integration into N alignments.\"}, {\"pattern\": \"GraphRAG for trustworthy AI\", \"how\": \"Wrap a traditional app’s data in a knowledge graph and use GraphRAG so an LLM answers only from verified facts.\", \"impact\": \"Adds a governable natural-language interface to legacy systems.\"}, {\"pattern\": \"SHACL as a validation service\", \"how\": \"Run SHACL shapes at ingestion boundaries (even for data still stored relationally) to centralize integrity rules currently scattered in code.\", \"impact\": \"One declarative, reusable contract instead of duplicated imperative checks.\"}], \"worked\": {\"title\": \"Worked example — \\\"find all products a discontinued brand still appears in\\\"\", \"trad\": {\"lang\": \"sql\", \"code\": \"-- traditional: explicit joins, brand status in a column,\\n-- rule lives in the query / app code\\nSELECT p.id, p.name\\nFROM products p\\nJOIN brands b ON p.brand_id = b.id\\nWHERE b.status = 'discontinued';\", \"note\": \"Works, but the rule \\\"discontinued brands shouldn’t be on active products\\\" lives in application code; another query can forget it. New data sources need their schema reconciled first.\"}, \"sem\": {\"lang\": \"turtle\", \"code\": \"# semantic: the rule is a declared SHACL shape, enforced everywhere\\n:ActiveProductShape a sh:NodeShape ;\\n  sh:targetClass :Product ;\\n  sh:property [ sh:path (:brand :status) ;\\n    sh:hasValue :active ] .   # brand must be active\\n# a reasoner/validator flags EVERY violating product, in any dataset\", \"note\": \"The rule is declared once, centrally, and the validator applies it to all data — including newly integrated sources aligned to the same vocabulary. The constraint is reusable and machine-checkable.\"}}, \"closing\": \"The pragmatic answer is rarely “either/or.” Traditional development remains the right default for stable, well-understood, transaction-heavy systems. Semantic technologies earn their place where meaning must be shared across boundaries, where data is heterogeneous and evolving, where rules should be declared rather than buried in code, and where AI must be grounded in verifiable facts. The strongest architectures are hybrids: a relational core for transactions, a semantic layer for integration, reasoning, and trustworthy AI.\", \"worked_multi\": [{\"title\": \"1. Enforce a business rule (\\\"active products only carry active brands\\\")\", \"trad\": {\"lang\": \"sql\", \"code\": \"-- rule lives in each query / the app layer\\nSELECT p.* FROM products p JOIN brands b ON p.brand_id=b.id\\nWHERE b.status='active';\", \"note\": \"The rule must be repeated in every query that needs it; another developer can forget it. Integrity is procedural.\"}, \"sem\": {\"lang\": \"turtle\", \"code\": \":ActiveProductShape a sh:NodeShape ;\\n  sh:targetClass :Product ;\\n  sh:property [ sh:path (:brand :status) ; sh:hasValue :active ] .\", \"note\": \"Declared once as a SHACL shape; the validator enforces it on ALL data, including newly integrated sources. Integrity is declarative and reusable.\"}}, {\"title\": \"2. Answer a multi-hop question (\\\"which suppliers ultimately reach store ex:store_1?\\\")\", \"trad\": {\"lang\": \"sql\", \"code\": \"-- variable-depth chains need recursive CTEs, hard to read & tune\\nWITH RECURSIVE chain AS (\\n  SELECT supplier_id, node_id FROM supplies WHERE node_id='DC1'\\n  UNION ALL\\n  SELECT s.supplier_id, s.node_id FROM supplies s JOIN chain c ON s.node_id=c.node_id)\\nSELECT DISTINCT supplier_id FROM chain;\", \"note\": \"Possible, but recursive SQL is verbose and brittle; depth changes mean query changes.\"}, \"sem\": {\"lang\": \"sparql\", \"code\": \"SELECT DISTINCT ?supplier WHERE {\\n  ?supplier :supplies+ ex:store_1 .   # + = one-or-more hops\\n}\", \"note\": \"A property path expresses \\\"any number of hops\\\" natively — concise, depth-independent, and standard.\"}}, {\"title\": \"3. Integrate a newly acquired system’s data\", \"trad\": {\"lang\": \"sql\", \"code\": \"-- map every new table to the existing schema (ETL), per source\\nINSERT INTO products(id,name,category_id)\\nSELECT ext_id, title, map_category(dept) FROM acquired.items;\", \"note\": \"Each new source needs bespoke ETL into the master schema — effort grows with every system (toward N²).\"}, \"sem\": {\"lang\": \"turtle\", \"code\": \"# align the new vocabulary to the shared one; no central schema to break\\nacq:Item rdfs:subClassOf :Product .\\nacq:dept rdfs:subPropertyOf :category .\", \"note\": \"Add a few alignment axioms; the new data joins the graph immediately. Effort grows linearly (N).\"}}, {\"title\": \"4. Add a trustworthy natural-language interface\", \"trad\": {\"lang\": \"python\", \"code\": \"# plain RAG over text chunks — may blur facts across documents\\nchunks = vector_store.search(embed(question), k=5)\\nanswer = llm.generate(question, context=chunks)\", \"note\": \"Grounds in passages, not facts; multi-hop relationships are easily missed; answers are hard to trace.\"}, \"sem\": {\"lang\": \"python\", \"code\": \"# GraphRAG — retrieve a verified subgraph, answer only from it\\nsub = kg.query(sparql_for(question))\\nanswer = llm.generate(question, context=sub)   # traceable to triples\", \"note\": \"Grounds in structured facts; supports multi-hop reasoning; every claim traces to a triple. ~90% hallucination reduction reported in production.\"}}], \"decision\": {\"use_traditional\": [\"Stable, well-understood schema that rarely changes (e.g. accounting ledgers).\", \"High-volume OLTP transactions needing strict ACID guarantees and millisecond writes.\", \"A single, self-contained application with no cross-system integration need.\", \"Team & tooling are SQL-native and the problem is genuinely tabular.\"], \"use_semantic\": [\"Data is heterogeneous and must be integrated across many systems or organizations.\", \"The schema evolves often, or you cannot agree one up front.\", \"Relationships and multi-hop questions are central (fraud rings, supply chains, lineage).\", \"Rules/meaning must be explicit, shared, and machine-checkable (governance, compliance).\", \"You need to ground an LLM in verifiable facts (GraphRAG).\"], \"replace_when\": [{\"sig\": \"Integration cost is exploding (N² connectors)\", \"reason\": \"A shared ontology + IRIs replaces point-to-point ETL with linear alignment — replace the integration layer, not the systems of record.\"}, {\"sig\": \"Business rules are duplicated and drifting across the codebase\", \"reason\": \"Move them to declarative SHACL shapes / OWL axioms — one enforced source of truth replaces scattered imperative checks.\"}, {\"sig\": \"Queries are mostly variable-depth traversals\", \"reason\": \"Graph queries (SPARQL/Cypher) replace brittle recursive SQL; the relational store can remain underneath via R2RML.\"}, {\"sig\": \"You need explainable, grounded AI over enterprise data\", \"reason\": \"GraphRAG replaces plain vector-RAG where factual precision and traceability matter.\"}], \"keep_both\": \"Most often the answer is hybrid: keep the relational/operational core for transactions, add a semantic layer for integration, reasoning, and AI grounding. Replacement is usually of a LAYER (integration, rules, AI retrieval), rarely of the whole system.\"}, \"fitgap\": [{\"need\": \"ACID transactions, high write throughput\", \"trad\": \"Strong fit\", \"sem\": \"Gap — triplestores trade write speed for flexibility\", \"verdict\": \"Traditional\"}, {\"need\": \"Integrating 10+ heterogeneous sources\", \"trad\": \"Gap — N² ETL\", \"sem\": \"Strong fit — align to shared vocabulary\", \"verdict\": \"Semantic\"}, {\"need\": \"Multi-hop / path queries\", \"trad\": \"Partial — recursive SQL\", \"sem\": \"Strong fit — property paths\", \"verdict\": \"Semantic\"}, {\"need\": \"Declarative, shared business rules\", \"trad\": \"Gap — logic in code\", \"sem\": \"Strong fit — OWL/SHACL\", \"verdict\": \"Semantic\"}, {\"need\": \"Mature ops, staffing, tooling\", \"trad\": \"Strong fit — decades of ecosystem\", \"sem\": \"Partial — smaller talent pool\", \"verdict\": \"Traditional\"}, {\"need\": \"Grounded, explainable LLM answers\", \"trad\": \"Gap\", \"sem\": \"Strong fit — GraphRAG\", \"verdict\": \"Semantic\"}, {\"need\": \"Simple CRUD app, one schema\", \"trad\": \"Strong fit — overkill to add semantics\", \"sem\": \"Gap — unnecessary complexity\", \"verdict\": \"Traditional\"}], \"risks_benefits\": {\"trad\": {\"benefits\": [\"Mature, battle-tested, vast talent pool\", \"Excellent OLTP performance & ACID\", \"Predictable, well-understood tooling & ops\"], \"risks\": [\"Rigid schema; migrations are costly & breaking\", \"Integration cost grows ~N² across systems\", \"Business rules buried in code, hard to audit\", \"Relationships are second-class (inferred from joins)\"]}, \"sem\": {\"benefits\": [\"Schema-flexible; add data without breaking existing\", \"Integration scales ~N via shared vocabularies\", \"Declarative, machine-checkable rules & reasoning\", \"Relationships are first-class; grounds trustworthy AI\"], \"risks\": [\"Smaller talent pool & ecosystem maturity\", \"Triplestore write/throughput below tuned RDBMS\", \"Open-world semantics can surprise newcomers\", \"Reasoning at scale needs care (profile selection)\"]}}, \"best_practices\": [\"Reuse before you build: adopt established vocabularies (schema.org, FIBO, SNOMED CT, GS1) rather than inventing your own.\", \"Keep the relational system of record; expose it as RDF with R2RML/Ontop instead of migrating wholesale.\", \"Drive design with competency questions — the SPARQL queries the ontology must answer — and test against them.\", \"Validate at ingestion with SHACL shapes; treat shapes as versioned, reviewed code.\", \"Choose the lightest OWL profile (EL/QL/RL) that meets the reasoning need; full OWL DL only when required.\", \"For AI, prefer GraphRAG/LightRAG where factual precision and traceability matter; use cost-aware indexing (e.g. LazyGraphRAG).\", \"Let LLMs accelerate KG construction (entity/relation extraction), but keep human review and SHACL gates in the loop.\"], \"statistics\": [{\"stat\": \"Enterprise knowledge-graph market\", \"value\": \"~$2.9B in 2025 → ~$13B by 2033 (CAGR ~21%)\", \"src\": \"Grand View Research / multiple analysts, 2025-2026\"}, {\"stat\": \"Property graphs share of the KG market (2025)\", \"value\": \"~65%\", \"src\": \"Grand View Research, 2025\"}, {\"stat\": \"Large enterprises integrating semantic frameworks\", \"value\": \"~65% (across 10+ internal systems)\", \"src\": \"Econ Market Research, 2026\"}, {\"stat\": \"Orgs reporting faster data discovery with KGs\", \"value\": \"~72% report ≥40% improvement\", \"src\": \"Econ Market Research, 2026\"}, {\"stat\": \"GraphRAG hallucination reduction (production)\", \"value\": \"up to ~90% vs traditional RAG\", \"src\": \"FalkorDB / practitioner reports, 2025\"}, {\"stat\": \"LinkedIn GraphRAG support deployment\", \"value\": \"ticket resolution 40h → 15h (~63% faster)\", \"src\": \"reported case study, 2025\"}, {\"stat\": \"LazyGraphRAG indexing cost reduction\", \"value\": \"10–90% lower than original GraphRAG\", \"src\": \"Microsoft Research, Nov 2024\"}], \"state_of_art\": [\"GraphRAG (Microsoft Research, 2024) is the current reference architecture for grounding LLMs in knowledge graphs; LazyGraphRAG and LightRAG cut its indexing cost by 10–90×, making it production-viable.\", \"Hybrid retrieval — a query router over vector search + graph traversal + SQL — is becoming the dominant enterprise pattern in 2025-2026.\", \"LLMs now construct knowledge graphs from unstructured text, removing the historical bottleneck of manual KG construction (with human + SHACL review kept in the loop).\", \"Agentic GraphRAG — LLM agents that dynamically orchestrate retrieval strategies, with the knowledge graph as persistent structured memory — is the emerging frontier (LLM+Graph @VLDB 2025).\", \"The relationship is bidirectional: graphs ground and explain LLMs, while LLMs build and enrich graphs (Pan et al., 2024).\", {\"point\": \"GraphRAG and graph-grounded retrieval have moved from research into mainstream RAG architectures (2025–2026), combining vector recall with knowledge-graph structure for traceable, multi-hop answers.\", \"tag\": \"directional\"}], \"graph_types\": [{\"name\": \"RDF / directed labelled graph\", \"use\": \"Integration, reasoning, linked data\", \"shape\": \"rdf\"}, {\"name\": \"Property graph\", \"use\": \"Operational traversal, fraud, recommendations\", \"shape\": \"pg\"}, {\"name\": \"Taxonomy / tree (SKOS)\", \"use\": \"Classification, navigation, controlled vocab\", \"shape\": \"tree\"}, {\"name\": \"Bipartite graph\", \"use\": \"Users↔items (recommendation), authors↔papers\", \"shape\": \"bipartite\"}, {\"name\": \"Hypergraph\", \"use\": \"N-ary relations (an event linking many parties)\", \"shape\": \"hyper\"}]}" .

scp:WorkedCorpus a owl:NamedIndividual ;
    scp:corpusData "{\"title\": \"The worked corpus \\u2014 one small dataset behind the examples\", \"intro\": \"To keep the examples coherent rather than scattered, most of them draw on one small, shared ILLUSTRATIVE dataset: a fictional apparel retailer modeled on typical, publicly observable e-commerce category structures. Every schema element and every instance here is synthetic, written in the ex: namespace.\", \"real_grounding\": {\"label\": \"Illustrative grounding (the schema side)\", \"facts\": [[\"A typical apparel retailer organizes products as Department \\u2192 Category \\u2192 Product type (e.g. Women \\u2192 Clothing \\u2192 T-Shirt)\", \"ILLUSTRATIVE\", \"\\u2014\"], [\"\\u201cT-Shirt\\u201d, \\u201cTop\\u201d and \\u201cBody\\u201d are commonly sibling product types in one category (not synonyms)\", \"ILLUSTRATIVE\", \"\\u2014\"], [\"Retailers commonly run several sub-brands over one shared category tree\", \"ILLUSTRATIVE\", \"\\u2014\"]]}, \"illustrative_instances\": {\"label\": \"Illustrative instances (the data side \\u2014 synthetic, ex: namespace)\", \"note\": \"These are invented for teaching. They are NOT any real company\\u2019s SKUs, store codes, or prices.\", \"items\": [[\"ex:tshirt_A\", \"an individual T-shirt product\", \"illustrative stand-in for \\\"a women\\u2019s t-shirt\\\"\"], [\"ex:store_1\", \"an individual store\", \"illustrative stand-in for \\\"a retail store\\\"\"], [\"ex:price values (e.g. \\\"199.99\\\")\", \"a datatype value\", \"illustrative, not a real listed price\"]]}, \"closing\": \"So when an example shows ex:tshirt_A a :TShirt, both the CLASS and the instance are honest, clearly-marked synthetic teaching data \\u2014 the structure mirrors real retail practice without asserting any real company\\u2019s records.\"}" .

scp:addsExpressivity a owl:ObjectProperty ;
    rdfs:label "adds expressivity to" ;
    rdfs:comment "A layer that extends the expressive power of a lower layer." ;
    rdfs:domain scp:SemanticTechnology ;
    rdfs:range scp:SemanticTechnology .

scp:anchorsTo a owl:ObjectProperty ;
    rdfs:label "anchors to" ;
    rdfs:comment "A domain/application ontology anchored to a more abstract ontology." ;
    rdfs:domain scp:OntologyTier ;
    rdfs:range scp:OntologyTier ;
    owl:inverseOf scp:anchorFor .

scp:axiomReference a owl:AnnotationProperty .

scp:builtOn a owl:ObjectProperty ;
    rdfs:label "built on" ;
    rdfs:comment "A technology/layer that is defined on top of another (stack dependency)." ;
    rdfs:domain scp:SemanticTechnology ;
    rdfs:range scp:SemanticTechnology ;
    owl:inverseOf scp:foundationFor .

scp:caseCode a owl:AnnotationProperty .

scp:caseCodeLang a owl:AnnotationProperty .

scp:caseExecResult a owl:AnnotationProperty .

scp:caseExecSteps a owl:AnnotationProperty .

scp:caseGraph a owl:AnnotationProperty .

scp:case_ApplicationOntology_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:PerishableSKU rdfs:subClassOf ex:Product .  # adds shelf-life rules for one app""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "An application ontology specializes domain concepts for one running system." ;
    scp:ofConcept scp:ApplicationOntology .

scp:case_DLReasoning_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:Penicillin rdfs:subClassOf ex:Antibiotic .
ex:Antibiotic rdfs:subClassOf ex:Drug .
ex:dose1 a ex:Penicillin .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "Description-logic reasoning classifies individuals and detects unsatisfiable classes — here a subclass inference." ;
    scp:ofConcept scp:DLReasoning .

scp:case_DomainOntology_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:Supplier rdfs:subClassOf ex:Object .
ex:replenishes rdfs:subClassOf ex:Process .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A domain ontology for retail: reusable concepts of one field, anchored to an upper category." ;
    scp:ofConcept scp:DomainOntology .

scp:case_Embeddings_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """model = TransE(triples_factory=tf).fit()
score = model.predict_link(
    head=":Blazer", relation=":boughtWith", tail=":Trousers")""" ;
    scp:caseCodeLang "python" ;
    scp:caseExecResult "{\"cols\": [\"pair\", \"score\"], \"rows\": [[\"Blazer\\u2013Trousers\", \"0.91 (recommend)\"], [\"Blazer\\u2013Mug\", \"0.07\"]]}" ;
    scp:caseExecSteps "[\"Train embeddings on the catalogue graph\", \"Represent each product as a vector\", \"Score a candidate :boughtWith edge\", \"High score \\u2192 likely co-purchase\", \"Recommend trousers with the blazer\"]" ;
    scp:caseGraph "{\"nodes\": [[\"blazer\", \"s\"], [\"trousers\", \"s\"], [\"mug\", \"o\"]], \"edges\": [[0, 1, \"near \\u2192 bought-together\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Representing each product as a vector lets a recommender predict a 'bought together' edge between a blazer and trousers by vector proximity — inductive inference beside the deductive rules."@en ;
    scp:exampleVisual "vector" ;
    scp:ofConcept scp:Embeddings .

scp:case_Embeddings_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """model = TransE(triples_factory=tf).fit()
score = model.predict_link(
    head=":Acc_A", relation=":transfersTo", tail=":Acc_B")""" ;
    scp:caseCodeLang "python" ;
    scp:caseExecResult "{\"cols\": [\"transfer\", \"score\"], \"rows\": [[\"Acc_A\\u2192Acc_B\", \"0.04 (flag \\u26a0)\"]]}" ;
    scp:caseExecSteps "[\"Embed accounts + transactions\", \"Score the observed transfer\", \"Compare to learned patterns\", \"Low score \\u2192 anomalous\", \"Flag for review\"]" ;
    scp:caseGraph "{\"nodes\": [[\"account A\", \"s\"], [\"account B\", \"s\"], [\"anomaly\", \"bad\"]], \"edges\": [[0, 1, \"unusual transfer \\u2192 flag\"]]}" ;
    scp:exampleDomain "Finance" ;
    scp:exampleText "Embedding accounts and transactions lets a fraud system flag an anomalous, likely-fraudulent transfer pattern that no hand-written rule anticipated."@en ;
    scp:exampleVisual "vector" ;
    scp:ofConcept scp:Embeddings .

scp:case_FoundationalOntology_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
:Store rdfs:subClassOf bfo:BFO_0000040 .   # material entity
:Depot rdfs:subClassOf bfo:BFO_0000040 .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"?x\", \"aligned via\"], \"rows\": [[\"Store\", \"bfo:MaterialEntity\"], [\"Depot\", \"bfo:MaterialEntity\"]]}" ;
    scp:caseExecSteps "[\"Align Store to bfo:MaterialEntity\", \"Align Depot to bfo:MaterialEntity\", \"Two ontologies now share an upper class\", \"Query bfo:MaterialEntity\", \"Return both\"]" ;
    scp:caseGraph "{\"nodes\": [[\"bfo:MaterialEntity\", \"o\"], [\"Store\", \"s\"], [\"Depot\", \"s\"]], \"edges\": [[1, 0, \"subClassOf\"], [2, 0, \"subClassOf\"]]}" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Aligning a retailer's Store and a logistics provider's Depot both to bfo:MaterialEntity lets two independently-built ontologies interoperate via a shared upper backbone."@en ;
    scp:exampleVisual "pyramid" ;
    scp:ofConcept scp:FoundationalOntology .

scp:case_FoundationalOntology_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
:Gene  rdfs:subClassOf bfo:BFO_0000040 .
:Disease rdfs:subClassOf bfo:BFO_0000016 .  # disposition""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"ontology\", \"BFO class\"], \"rows\": [[\"Gene Ontology\", \"material entity\"], [\"Disease Ontology\", \"disposition\"]]}" ;
    scp:caseExecSteps "[\"Align Gene to material entity\", \"Align Disease to disposition\", \"OBO ontologies share BFO\", \"Cross-ontology query\", \"Return aligned classes\"]" ;
    scp:caseGraph "{\"nodes\": [[\"BFO\", \"o\"], [\"Gene Ont.\", \"s\"], [\"Disease Ont.\", \"s\"]], \"edges\": [[1, 0, \"aligns\"], [2, 0, \"aligns\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "The OBO Foundry aligns dozens of biomedical ontologies to BFO so that gene, disease, and drug ontologies built by different groups compose coherently."@en ;
    scp:exampleVisual "pyramid" ;
    scp:ofConcept scp:FoundationalOntology .

scp:case_FoundationalOntology_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
:MfgProcess rdfs:subClassOf bfo:BFO_0000015 .  # process
:Part rdfs:subClassOf bfo:BFO_0000040 .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"term\", \"BFO class\"], \"rows\": [[\"MfgProcess\", \"process\"], [\"Part\", \"material entity\"]]}" ;
    scp:caseExecSteps "[\"Align MfgProcess to bfo:Process\", \"Align Part to material entity\", \"Supply partners share BFO (ISO)\", \"Federated query\", \"Return aligned terms\"]" ;
    scp:caseGraph "{\"nodes\": [[\"BFO (ISO)\", \"o\"], [\"Mfg Ont.\", \"s\"], [\"Supply Ont.\", \"s\"]], \"edges\": [[1, 0, \"aligns\"], [2, 0, \"aligns\"]]}" ;
    scp:exampleDomain "Industry" ;
    scp:exampleText "The Industrial Ontologies Foundry aligns manufacturing ontologies to BFO (an ISO standard) so supply-chain partners share a common foundation."@en ;
    scp:exampleVisual "pyramid" ;
    scp:ofConcept scp:FoundationalOntology .

scp:case_GraphQuery_0 a scp:ExampleCase ;
    scp:caseCode "SELECT ?p WHERE { ?p ex:suppliedBy ex:ExBrand . }" ;
    scp:caseCodeLang "sparql" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Graph query traverses relationships directly — find products supplied by a given supplier." ;
    scp:ofConcept scp:GraphQuery .

scp:case_GraphRAG_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """sub = kg.query(\"\"\"
  SELECT ?brand WHERE { ?b :inCategory :Home_Living ; :brand ?brand }
\"\"\")
answer = llm.generate(q, context=sub)  # only brands in sub""" ;
    scp:caseCodeLang "python" ;
    scp:caseExecResult "{\"cols\": [\"step\", \"value\"], \"rows\": [[\"retrieved\", \"English Home, Schafer, Evidea\"], [\"answer\", \"grounded \\u2713\"]]}" ;
    scp:caseExecSteps "[\"Receive the question\", \"Retrieve the Home & Living subgraph\", \"Pass ONLY those triples as context\", \"Model generates from context\", \"Answer cannot invent a brand\"]" ;
    scp:caseGraph "{\"nodes\": [[\"\\\"which brands?\\\"\", \"s\"], [\"subgraph\", \"p\"], [\"answer\", \"ok\"]], \"edges\": [[0, 1, \"retrieve\"], [1, 2, \"ground\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Asked which brands a chain carries in a category, the system retrieves the relevant subgraph and answers only from it, so it cannot invent a brand the catalogue lacks."@en ;
    scp:exampleVisual "ragflow" ;
    scp:ofConcept scp:GraphRAG .

scp:case_GraphRAG_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """sub = kg.query(\"\"\"
  SELECT ?drug ?interaction WHERE {
    :Patient_5 :takes ?drug . ?drug :interactsWith ?interaction }
\"\"\")
answer = llm.generate(q, context=sub)""" ;
    scp:caseCodeLang "python" ;
    scp:caseExecResult "{\"cols\": [\"step\", \"value\"], \"rows\": [[\"retrieved\", \"patient meds + interactions\"], [\"answer\", \"safe, grounded \\u2713\"]]}" ;
    scp:caseExecSteps "[\"Receive clinical question\", \"Retrieve patient + interaction subgraph\", \"Constrain model to those facts\", \"Generate answer\", \"Refuse anything not in the graph\"]" ;
    scp:caseGraph "{\"nodes\": [[\"clinical Q\", \"s\"], [\"patient subgraph\", \"p\"], [\"safe answer\", \"ok\"]], \"edges\": [[0, 1, \"retrieve\"], [1, 2, \"ground\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "A clinical assistant grounds its answer in a retrieved subgraph of the patient's actual record and an approved drug-interaction graph, refusing to speculate beyond them."@en ;
    scp:exampleVisual "ragflow" ;
    scp:ofConcept scp:GraphRAG .

scp:case_GraphRAG_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """sub = kg.query(\"\"\"
  SELECT ?fact WHERE { :Client_9 :kycVerified ?fact }
\"\"\")
answer = llm.generate(q, context=sub)""" ;
    scp:caseCodeLang "python" ;
    scp:caseExecResult "{\"cols\": [\"step\", \"value\"], \"rows\": [[\"retrieved\", \"verified KYC facts\"], [\"answer\", \"auditable \\u2713\"]]}" ;
    scp:caseExecSteps "[\"Receive compliance question\", \"Retrieve verified KYC subgraph\", \"Pass only audited facts\", \"Generate answer\", \"Every claim is auditable\"]" ;
    scp:caseGraph "{\"nodes\": [[\"compliance Q\", \"s\"], [\"KYC subgraph\", \"p\"], [\"auditable answer\", \"ok\"]], \"edges\": [[0, 1, \"retrieve\"], [1, 2, \"ground\"]]}" ;
    scp:exampleDomain "Finance" ;
    scp:exampleText "A compliance assistant answers only from a retrieved subgraph of verified KYC and transaction facts, so its output is auditable rather than hallucinated."@en ;
    scp:exampleVisual "ragflow" ;
    scp:ofConcept scp:GraphRAG .

scp:case_IRI_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
ex:tshirt_A a ex:Product .
# the IRI http://ex.org/tshirt_A identifies this product everywhere""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "An IRI gives every resource one global name, so two systems mean the same thing when they use the same IRI." ;
    scp:ofConcept scp:IRI .

scp:case_ISO21838_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
ex:Supplier rdfs:subClassOf bfo:Object .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "ISO/IEC 21838 standardizes top-level ontologies (e.g. BFO) so domain ontologies share a common upper layer." ;
    scp:ofConcept scp:ISO21838 .

scp:case_KGOrigin_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT ?born ?work WHERE {
  wd:Q762 wdt:P569 ?born ; wdt:P800 ?work .
}  # Leonardo da Vinci""" ;
    scp:caseCodeLang "sparql" ;
    scp:caseExecResult "{\"cols\": [\"?born\", \"?work\"], \"rows\": [[\"1452-04-15\", \"Mona Lisa\"], [\"1452-04-15\", \"The Last Supper\"]]}" ;
    scp:caseExecSteps "[\"Resolve \\\"da Vinci\\\" to an entity (Q762)\", \"Query its structured facts\", \"Fetch birth + notable works\", \"Assemble the panel\", \"Return facts, not links\"]" ;
    scp:caseGraph "{\"nodes\": [[\"\\\"da Vinci\\\"\", \"s\"], [\"Knowledge Graph\", \"p\"], [\"structured panel\", \"ok\"]], \"edges\": [[0, 1, \"hits\"], [1, 2, \"returns\"]]}" ;
    scp:exampleDomain "Web" ;
    scp:exampleText "Searching a public figure returns a structured panel — born, works, related people — because the query hit Google's Knowledge Graph (the 2012 'things, not strings' launch) rather than ranked links."@en ;
    scp:exampleVisual "panel" ;
    scp:ofConcept scp:KGOrigin .

scp:case_KGOrigin_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT ?brand ?seller WHERE {
  ex:tshirt_A ex:brand ?brand ; ex:soldBy ?seller .
}""" ;
    scp:caseCodeLang "sparql" ;
    scp:caseExecResult "{\"cols\": [\"?brand\", \"?seller\"], \"rows\": [[\"ExBrand\", \"a retailer\"]]}" ;
    scp:caseExecSteps "[\"Resolve the product to a graph node\", \"Query its structured facts\", \"Fetch brand + seller\", \"Assemble the product panel\", \"Return facts\"]" ;
    scp:caseGraph "{\"nodes\": [[\"product query\", \"s\"], [\"catalogue KG\", \"p\"], [\"facts\", \"ok\"]], \"edges\": [[0, 1, \"hits\"], [1, 2, \"returns\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A marketplace's knowledge graph links products, brands, and sellers so a query for a thing returns structured facts, not just matching text."@en ;
    scp:exampleVisual "panel" ;
    scp:ofConcept scp:KGOrigin .

scp:case_KGSurvey_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
ex:survey1 ex:covers ex:KnowledgeGraphConstruction .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Surveys catalogue how knowledge graphs are built and used across industry and research." ;
    scp:ofConcept scp:KGSurvey .

scp:case_LLMKG_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
# extracted from "ExBrand supplies tshirt_A":
ex:ExBrand ex:supplies ex:tshirt_A .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "LLMs construct knowledge graphs from unstructured text, extracting entities and relations." ;
    scp:ofConcept scp:LLMKG .

scp:case_LinkedData_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
ex:ExBrand owl:sameAs <http://other.example/org/ExBrand> .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Linked Data publishes RDF with dereferenceable IRIs that link across datasets." ;
    scp:ofConcept scp:LinkedData .

scp:case_LogicTrust_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
ex:claim1 prov:wasDerivedFrom ex:catalog ; ex:states "tshirt_A inStock" .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "The upper layers (proof, trust) let a consumer check WHY a fact holds and whether to trust its source — shown here as a provenance-tagged claim." ;
    scp:ofConcept scp:LogicTrust .

scp:case_OWL_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ex:  <http://ex.org/> .

ex:soldInStore owl:inverseOf ex:stocks .
ex:tshirt_A ex:soldInStore ex:store_1 .
# reasoner infers: ex:store_1 ex:stocks ex:tshirt_A""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"fact\", \"origin\"], \"rows\": [[\"ex:tshirt_A soldInstore ex:store_1\", \"asserted\"], [\"ex:store_1 stocks ex:tshirt_A\", \"inferred\"]]}" ;
    scp:caseExecSteps "[\"Declare soldInStore inverseOf stocks\", \"Assert ex:tshirt_A soldInstore ex:store_1\", \"Apply the inverse axiom\", \"Infer the reverse edge\", \"Return inferred fact\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Item\", \"s\"], [\"Store\", \"o\"]], \"edges\": [[0, 1, \"soldInStore\"], [1, 0, \"stocks (inferred)\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Declaring soldInStore as the inverse of stocks means that asserting an item is sold in a store automatically yields that the store stocks that item — no second assertion, enforced across hundreds of thousands of SKUs. (Because the relationship is symmetric, the inference also runs the other way.)"@en ;
    scp:exampleVisual "inverse" ;
    scp:ofConcept scp:OWL .

scp:case_OWL_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix owl: <http://www.w3.org/2002/07/owl#> .

:PrescriptionDrug owl:disjointWith :OverTheCounterDrug .
:Drug_X a :PrescriptionDrug , :OverTheCounterDrug .
# reasoner: Drug_X violates disjointness -> inconsistent""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"node\", \"result\"], \"rows\": [[\"Drug_X\", \"\\u2717 inconsistent (two disjoint classes)\"]]}" ;
    scp:caseExecSteps "[\"Read the disjointness axiom\", \"See Drug_X typed as BOTH classes\", \"Reasoner checks class disjointness\", \"Detect the contradiction\", \"Flag Drug_X as inconsistent\"]" ;
    scp:caseGraph "{\"nodes\": [[\"PrescriptionDrug\", \"s\"], [\"OverTheCounterDrug\", \"bad\"]], \"edges\": [[0, 1, \"disjointWith \\u2717\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "OWL disjointness — a drug cannot be both prescription-only and over-the-counter — lets a reasoner flag a contradictory record. SNOMED CT, the clinical terminology, is built on description-logic foundations of exactly this kind."@en ;
    scp:exampleVisual "inverse" ;
    scp:ofConcept scp:OWL .

scp:case_OWL_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix owl: <http://www.w3.org/2002/07/owl#> .

:partOf a owl:TransitiveProperty .
:Bolt :partOf :Assembly .  :Assembly :partOf :Engine .
# reasoner infers: :Bolt :partOf :Engine""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"fact\", \"origin\"], \"rows\": [[\"Bolt partOf Assembly\", \"asserted\"], [\"Assembly partOf Engine\", \"asserted\"], [\"Bolt partOf Engine\", \"inferred\"]]}" ;
    scp:caseExecSteps "[\"Declare partOf transitive\", \"Assert Bolt partOf Assembly\", \"Assert Assembly partOf Engine\", \"Apply transitivity\", \"Infer Bolt partOf Engine\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Bolt\", \"s\"], [\"Assembly\", \"p\"], [\"Engine\", \"o\"]], \"edges\": [[0, 1, \"partOf\"], [1, 2, \"partOf\"], [0, 2, \"partOf (inferred)\"]]}" ;
    scp:exampleDomain "Manufacturing" ;
    scp:exampleText "Transitivity of partOf means a bolt that is part of an assembly that is part of an engine is inferred to be part of the engine — the reasoning behind a bill-of-materials explosion."@en ;
    scp:exampleVisual "inverse" ;
    scp:ofConcept scp:OWL .

scp:case_OntologyAlignment_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
ex:Supplier skos:exactMatch ex:Vendor .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Alignment links equivalent concepts across two independently-built ontologies." ;
    scp:ofConcept scp:OntologyAlignment .

scp:case_OntologyDefinition_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:Product a owl:Class .
:hasCategory a owl:ObjectProperty ;
  rdfs:domain :Product ; rdfs:range :Category .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"element\", \"specified\"], \"rows\": [[\"Product\", \"a class\"], [\"hasCategory\", \"Product\\u2192Category\"]]}" ;
    scp:caseExecSteps "[\"Name the shared concepts\", \"State the rules formally\", \"Fix domain and range\", \"The vocabulary is now explicit\", \"Machines can use it\"]" ;
    scp:caseGraph "{\"nodes\": [[\"shared terms\", \"s\"], [\"formal axioms\", \"p\"], [\"ontology\", \"o\"]], \"edges\": [[0, 1, \"made explicit\"], [1, 2, \"becomes\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Two teams agreeing — and writing down formally — that every product has exactly one primary category and that categories nest is specifying a conceptualization: making the shared retail vocabulary explicit and machine-readable."@en ;
    scp:ofConcept scp:OntologyDefinition .

scp:case_OntologyDefinition_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:Encounter a owl:Class .
:hasDiagnosis rdfs:domain :Encounter ; rdfs:range :Diagnosis .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"element\", \"specified\"], \"rows\": [[\"Encounter\", \"a class\"], [\"hasDiagnosis\", \"Encounter\\u2192Diagnosis\"]]}" ;
    scp:caseExecSteps "[\"Name clinical concepts\", \"Specify their relations\", \"Fix the model\", \"Meaning is shared\", \"Systems interoperate\"]" ;
    scp:caseGraph "{\"nodes\": [[\"clinical terms\", \"s\"], [\"formal model\", \"p\"], [\"shared meaning\", \"o\"]], \"edges\": [[0, 1, \"specified\"], [1, 2, \"enables\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "When a hospital declares formally what counts as a diagnosis, an encounter, and how they relate, it is specifying a conceptualization of clinical care — the basis of standards like HL7 FHIR."@en ;
    scp:ofConcept scp:OntologyDefinition .

scp:case_OntologyMethodology_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:Supplier rdfs:subClassOf ex:Organization .  # informal concept -> formal axiom""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Uschold & Gruninger’s method: identify purpose, capture concepts, formalize, evaluate — shown as a tiny captured-then-formalized fragment." ;
    scp:ofConcept scp:OntologyMethodology .

scp:case_PROVO_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix prov: <http://www.w3.org/ns/prov#> .
ex:price_A prov:wasGeneratedBy :PricingRun_S6 ;
  prov:wasAttributedTo :MerchTeam .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"entity\", \"generatedBy\", \"attributedTo\"], \"rows\": [[\"ex:price_A\", \"PricingRun_S6\", \"MerchTeam\"]]}" ;
    scp:caseExecSteps "[\"Record the price entity\", \"Link to the pricing run\", \"Attribute to the team\", \"Audit query: where did this price come from?\", \"Return the trail\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Price\", \"s\"], [\"PricingRun\", \"p\"], [\"Merch team\", \"o\"]], \"edges\": [[0, 1, \"wasGeneratedBy\"], [1, 2, \"wasAssociatedWith\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A price change records which pricing run generated it and which team was responsible, making every figure on a storefront auditable."@en ;
    scp:exampleVisual "prov" ;
    scp:ofConcept scp:PROVO .

scp:case_PROVO_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix prov: <http://www.w3.org/ns/prov#> .
:Scan_991 prov:wasGeneratedBy :HandheldDevice_4 ;
  prov:wasAttributedTo :Courier_Ali .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"event\", \"device\", \"courier\"], \"rows\": [[\"Scan_991\", \"HandheldDevice_4\", \"Courier_Ali\"]]}" ;
    scp:caseExecSteps "[\"Record the scan event\", \"Link to the device\", \"Attribute to the courier\", \"Dispute: who scanned, when?\", \"Return provenance\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Scan event\", \"s\"], [\"Handheld device\", \"p\"], [\"Courier\", \"o\"]], \"edges\": [[0, 1, \"wasGeneratedBy\"], [1, 2, \"wasAssociatedWith\"]]}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "Each scan event records the device, location, and time it was generated, so a disputed delivery can be reconstructed from provenance."@en ;
    scp:exampleVisual "prov" ;
    scp:ofConcept scp:PROVO .

scp:case_PROVO_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix prov: <http://www.w3.org/ns/prov#> .
:Dataset_v3 prov:wasGeneratedBy :WorkflowRun_12 ;
  prov:used :Instrument_A .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"dataset\", \"workflow\", \"instrument\"], \"rows\": [[\"Dataset_v3\", \"WorkflowRun_12\", \"Instrument_A\"]]}" ;
    scp:caseExecSteps "[\"Record the dataset\", \"Link to the workflow run\", \"Record the instrument used\", \"Reproducibility check\", \"Return full lineage\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Dataset\", \"s\"], [\"Workflow run\", \"p\"], [\"Instrument\", \"o\"]], \"edges\": [[0, 1, \"wasGeneratedBy\"], [1, 2, \"used\"]]}" ;
    scp:exampleDomain "Science" ;
    scp:exampleText "A published dataset records the instrument, software version, and workflow that produced it — the reproducibility use case PROV-O was standardized for."@en ;
    scp:exampleVisual "prov" ;
    scp:ofConcept scp:PROVO .

scp:case_PropertyGraph_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """MATCH (p:Product {id:tshirt_A})-[:HAS_BRAND]->(b:Brand)
RETURN p.name, b.name""" ;
    scp:caseCodeLang "cypher" ;
    scp:caseExecResult "{\"cols\": [\"p.name\", \"b.name\"], \"rows\": [[\"Cotton T-Shirt\", \"ExBrand\"]]}" ;
    scp:caseExecSteps "[\"Match the Product node by id\", \"Follow the :HAS_BRAND relationship\", \"Bind the Brand node\", \"Return the properties\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Product {tshirt_A}\", \"s\"], [\"Category\", \"o\"], [\"Brand\", \"o\"]], \"edges\": [[0, 1, \"IN_CATEGORY\"], [0, 2, \"HAS_BRAND\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A product is a node with inline properties; categories and brands are related nodes. Cypher traverses these relationships directly — great for 'customers also bought' paths."@en ;
    scp:ofConcept scp:PropertyGraph .

scp:case_PropertyGraph_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """MATCH (s:Shipment)-[:ROUTED_VIA*]->(store:Store)
RETURN s, store""" ;
    scp:caseCodeLang "cypher" ;
    scp:caseExecResult "{\"cols\": [\"shipment\", \"store\"], \"rows\": [[\"Shipment_77\", \"ex:store_1\"]]}" ;
    scp:caseExecSteps "[\"Match the Shipment node\", \"Traverse ROUTED_VIA (any depth)\", \"Reach the Store node\", \"Return the path\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Shipment\", \"s\"], [\"Hub\", \"p\"], [\"Store\", \"o\"]], \"edges\": [[0, 1, \"ROUTED_VIA\"], [1, 2, \"DELIVERS_TO\"]]}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "A shipment node connects to route nodes by relationships; Cypher finds the path. Fast operational traversal, but without RDF's global IRIs or formal reasoning."@en ;
    scp:ofConcept scp:PropertyGraph .

scp:case_RDFS_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:TShirt rdfs:subClassOf :Clothing .
:Clothing rdfs:subClassOf :Product .
ex:tshirt_A a :TShirt .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"?x\", \"via\"], \"rows\": [[\"ex:tshirt_A\", \"subclass \\u2192 Product\"], [\"ex:jacket_A\", \"direct\"]]}" ;
    scp:caseExecSteps "[\"Assert TShirt \\u2291 Clothing \\u2291 Product\", \"Assert ex:tshirt_A a TShirt\", \"Query: all :Product\", \"Reasoner climbs the hierarchy\", \"Return all members\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Product\", \"o\"], [\"Clothing\", \"p\"], [\"T-Shirt\", \"s\"]], \"edges\": [[2, 1, \"subClassOf\"], [1, 0, \"subClassOf\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "Declaring T-Shirt ⊑ Clothing means a query for clothing automatically returns t-shirts. One subclass statement does the work that would otherwise need a hand-maintained list."@en ;
    scp:exampleVisual "subclass" ;
    scp:ofConcept scp:RDFS .

scp:case_RDFS_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:RefrigeratedContainer rdfs:subClassOf :Container .
:Reefer_22 a :RefrigeratedContainer .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"?x\", \"via\"], \"rows\": [[\"Reefer_22\", \"subclass \\u2192 Container\"], [\"Box_7\", \"direct\"]]}" ;
    scp:caseExecSteps "[\"Assert RefrigeratedContainer \\u2291 Container\", \"Assert Reefer_22 a RefrigeratedContainer\", \"Query: all :Container\", \"Reasoner adds subclass members\", \"Return reefers + plain containers\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Container\", \"o\"], [\"RefrigeratedContainer\", \"s\"]], \"edges\": [[1, 0, \"subClassOf\"]]}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "RefrigeratedContainer ⊑ Container lets a query for containers include reefer units, while rules specific to cold-chain attach only to the subclass."@en ;
    scp:exampleVisual "subclass" ;
    scp:ofConcept scp:RDFS .

scp:case_RDFS_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
:SavingsAccount rdfs:subClassOf :Account .
:Acc_900 a :SavingsAccount .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"?x\", \"via\"], \"rows\": [[\"Acc_900\", \"subclass \\u2192 Account\"], [\"Acc_100\", \"direct\"]]}" ;
    scp:caseExecSteps "[\"Assert SavingsAccount \\u2291 Account\", \"Assert Acc_900 a SavingsAccount\", \"Query: all :Account\", \"Reasoner includes savings accounts\", \"Return portfolio\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Account\", \"o\"], [\"SavingsAccount\", \"s\"]], \"edges\": [[1, 0, \"subClassOf\"]]}" ;
    scp:exampleDomain "Finance" ;
    scp:exampleText "SavingsAccount ⊑ Account means portfolio-level queries see savings accounts without enumerating every account type — the kind of hierarchy FIBO (the Financial Industry Business Ontology) formalizes."@en ;
    scp:exampleVisual "subclass" ;
    scp:ofConcept scp:RDFS .

scp:case_RDF_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix schema: <http://schema.org/> .
ex:tshirt_A a schema:Product ;
    schema:category ex:tshirt_cat ;
    schema:brand "ExBrand" .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"subject\", \"predicate\", \"object\"], \"rows\": [[\"ex:tshirt_A\", \"category\", \"ex:tshirt_cat\"], [\"ex:tshirt_A\", \"brand\", \"ExBrand\"]]}" ;
    scp:caseExecSteps "[\"Parse Turtle\", \"Create node ex:tshirt_A\", \"Add edge schema:category\", \"Add edge schema:brand\", \"Graph ready\"]" ;
    scp:caseGraph "{\"nodes\": [[\"ex:tshirt_A\", \"s\"], [\"ex:tshirt_cat\", \"o\"], [\"ExBrand\", \"o\"], [\"199.99 TRY\", \"o\"]], \"edges\": [[0, 1, \"schema:category\"], [0, 2, \"schema:brand\"], [0, 3, \"schema:price\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A product is a node and every fact about it an edge: a catalogue item links to its category, brand, and price. Heterogeneous catalogue, inventory, and order data merge into one graph without schema negotiation — the basis of schema.org/Product markup used across retail sites."@en ;
    scp:exampleVisual "triple" ;
    scp:ofConcept scp:RDF .

scp:case_RDF_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/log#> .
:Shipment_77 :origin :Istanbul_DC ;
    :destination ex:store_1 ; :carrier :DHL .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"subject\", \"predicate\", \"object\"], \"rows\": [[\"Shipment_77\", \"origin\", \"Istanbul_DC\"], [\"Shipment_77\", \"destination\", \"ex:store_1\"], [\"Shipment_77\", \"carrier\", \"DHL\"]]}" ;
    scp:caseExecSteps "[\"Parse Turtle\", \"Create node Shipment_77\", \"Add edge :origin\", \"Add edge :destination\", \"Add edge :carrier\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Shipment_77\", \"s\"], [\"Istanbul DC\", \"o\"], [\"Store store_1\", \"o\"], [\"DHL\", \"o\"]], \"edges\": [[0, 1, \"origin\"], [0, 2, \"destination\"], [0, 3, \"carrier\"]]}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "A shipment is a node linked to its origin, destination, carrier, and status. Because every party describes events as triples, a parcel handed between DHL, a customs agent, and a local courier stays one connected trail rather than four disconnected records."@en ;
    scp:exampleVisual "triple" ;
    scp:ofConcept scp:RDF .

scp:case_RDF_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/clin#> .
:Encounter_5 :hasDiagnosis :I21 ;
    :clinician :Dr_Demir ; :medication :Aspirin .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"subject\", \"predicate\", \"object\"], \"rows\": [[\"Encounter_5\", \"hasDiagnosis\", \"I21\"], [\"Encounter_5\", \"clinician\", \"Dr_Demir\"], [\"Encounter_5\", \"medication\", \"Aspirin\"]]}" ;
    scp:caseExecSteps "[\"Parse Turtle\", \"Create node Encounter_5\", \"Add edge :hasDiagnosis\", \"Add edge :clinician\", \"Add edge :medication\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Encounter_5\", \"s\"], [\"Diagnosis I21\", \"o\"], [\"Dr. Demir\", \"o\"], [\"Aspirin\", \"o\"]], \"edges\": [[0, 1, \"hasDiagnosis\"], [0, 2, \"clinician\"], [0, 3, \"medication\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "A patient encounter links to a diagnosis, a clinician, and a medication as triples. The uniform model lets records from different hospital systems join on shared identifiers — the principle behind HL7 FHIR's RDF representation."@en ;
    scp:exampleVisual "triple" ;
    scp:ofConcept scp:RDF .

scp:case_RelationalModel_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT p.name, c.name, b.name
FROM products p
JOIN categories c ON p.category_id = c.id
JOIN brands b ON p.brand_id = b.id;""" ;
    scp:caseCodeLang "sql" ;
    scp:caseExecResult "{\"cols\": [\"product\", \"category\", \"brand\"], \"rows\": [[\"Cotton T-Shirt\", \"Women T-Shirt\", \"ExBrand\"]]}" ;
    scp:caseExecSteps "[\"Read the PRODUCTS table\", \"JOIN to CATEGORIES on category_id\", \"JOIN to BRANDS on brand_id\", \"Project the chosen columns\", \"Return rows\"]" ;
    scp:caseGraph "{\"nodes\": [[\"PRODUCTS row\", \"s\"], [\"CATEGORIES\", \"o\"], [\"BRANDS\", \"o\"]], \"edges\": [[0, 1, \"FK category_id\"], [0, 2, \"FK brand_id\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A product is a row in a PRODUCTS table; its category and brand are foreign keys to other tables, joined at query time. Fast and familiar, but adding a supplier system means reconciling two schemas."@en ;
    scp:ofConcept scp:RelationalModel .

scp:case_RelationalModel_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT a.id, SUM(t.amount)
FROM accounts a
JOIN transactions t ON t.account_id = a.id
GROUP BY a.id;""" ;
    scp:caseCodeLang "sql" ;
    scp:caseExecResult "{\"cols\": [\"account\", \"balance\"], \"rows\": [[\"Acc_900\", \"12,450.00\"]]}" ;
    scp:caseExecSteps "[\"Read ACCOUNTS\", \"JOIN TRANSACTIONS on account_id\", \"Group by account\", \"Sum amounts\", \"Return balances\"]" ;
    scp:caseGraph "{\"nodes\": [[\"ACCOUNTS row\", \"s\"], [\"TRANSACTIONS\", \"o\"]], \"edges\": [[1, 0, \"FK account_id\"]]}" ;
    scp:exampleDomain "Finance" ;
    scp:exampleText "An account is a row; transactions reference it by foreign key. ACID transactions guarantee integrity, but cross-bank integration needs schema agreement that semantic models avoid."@en ;
    scp:ofConcept scp:RelationalModel .

scp:case_SHACL_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
:ProductShape a sh:NodeShape ;
  sh:targetClass :Product ;
  sh:property [ sh:path :category ; sh:minCount 1 ] .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"node\", \"result\"], \"rows\": [[\"PUMA shirt\", \"\\u2713 conforms\"], [\"untagged item\", \"\\u2717 missing :category\"]]}" ;
    scp:caseExecSteps "[\"Target every :Product\", \"Check \\u22651 :category\", \"PUMA shirt: has one\", \"Untagged item: none\"]" ;
    scp:caseGraph "{\"nodes\": [[\"PUMA shirt\", \"ok\"], [\"untagged item\", \"bad\"]], \"edges\": []}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A shape requiring every product to carry a brand, one category, and a price holds back an untagged supplier-feed item before it reaches the live catalogue."@en ;
    scp:exampleVisual "shape" ;
    scp:ofConcept scp:SHACL .

scp:case_SHACL_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
:ShipShape a sh:NodeShape ;
  sh:targetClass :Shipment ;
  sh:property [ sh:path :destination ; sh:minCount 1 ] .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"node\", \"result\"], \"rows\": [[\"valid shipment\", \"\\u2713 conforms\"], [\"no-destination msg\", \"\\u2717 missing :destination\"]]}" ;
    scp:caseExecSteps "[\"Target every :Shipment\", \"Check \\u22651 :destination\", \"Valid msg: has one\", \"EDI msg: none\"]" ;
    scp:caseGraph "{\"nodes\": [[\"valid shipment\", \"ok\"], [\"no-destination msg\", \"bad\"]], \"edges\": []}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "A shape requiring every shipment to have an origin, a destination, and a non-empty status rejects a malformed EDI message at the boundary rather than downstream."@en ;
    scp:exampleVisual "shape" ;
    scp:ofConcept scp:SHACL .

scp:case_SHACL_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
:TxnShape a sh:NodeShape ;
  sh:targetClass :Transaction ;
  sh:property [ sh:path :currency ; sh:minCount 1 ] .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"node\", \"result\"], \"rows\": [[\"txn +currency\", \"\\u2713 conforms\"], [\"txn no currency\", \"\\u2717 missing :currency\"]]}" ;
    scp:caseExecSteps "[\"Target every :Transaction\", \"Check \\u22651 :currency\", \"Tagged txn: ok\", \"Broken feed: none\"]" ;
    scp:caseGraph "{\"nodes\": [[\"txn +currency\", \"ok\"], [\"txn no currency\", \"bad\"]], \"edges\": []}" ;
    scp:exampleDomain "Finance" ;
    scp:exampleText "A shape enforcing that every transaction has a counterparty and an ISO-4217 currency code catches a broken feed before it corrupts a ledger."@en ;
    scp:exampleVisual "shape" ;
    scp:ofConcept scp:SHACL .

scp:case_SKOS_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:   <http://ex.org/> .
ex:tshirt_cat a skos:Concept ;
  skos:prefLabel "T-Shirt"@en ;
  skos:altLabel  "tee shirt"@en ;   # spelling variant — same garment
  skos:altLabel  "tee"@en ;         # informal short form
  skos:altLabel  "Tişört"@tr .      # Turkish translation""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"query\", \"resolves to\"], \"rows\": [[\"\\\"Ti\\u015f\\u00f6rt\\\" (tr)\", \"ex:tshirt_cat\"], [\"\\\"T-Shirt\\\" (en)\", \"ex:tshirt_cat\"], [\"\\\"Top\\\" (en)\", \"ex:tshirt_cat\"]]}" ;
    scp:caseExecSteps "[\"Define one concept (ex:tshirt_cat)\", \"Attach the English preferred label\", \"Attach a Turkish synonym (altLabel)\", \"Attach an English synonym\", \"Search \\\"Ti\\u015f\\u00f6rt\\\" \\u2192 resolves to the same concept\"]" ;
    scp:caseGraph "{\"nodes\": [[\"Ti\\u015f\\u00f6rt (tr)\", \"o\"], [\"T-Shirt (en)\", \"o\"], [\"tee\", \"o\"], [\"ex:tshirt_cat\", \"s\"]], \"edges\": [[0, 3, \"altLabel\"], [1, 3, \"prefLabel\"], [2, 3, \"altLabel\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "A retailer selling across countries needs one concept that many words point to. Here an English preferred label sits beside a Turkish synonym and an English synonym — all resolving to the same concept, so a shopper searching in either language finds the product."@en ;
    scp:exampleVisual "synonyms" ;
    scp:ofConcept scp:SKOS .

scp:case_SKOS_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
:MI a skos:Concept ;
  skos:prefLabel "Myocardial infarction"@en ;
  skos:altLabel "heart attack"@en ; skos:altLabel "MI"@en .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"query\", \"resolves to\"], \"rows\": [[\"\\\"heart attack\\\"\", \"MI\"], [\"\\\"MI\\\"\", \"MI\"]]}" ;
    scp:caseExecSteps "[\"Define the clinical concept\", \"Attach prefLabel\", \"Attach lay + abbrev altLabels\", \"Nurse types \\\"heart attack\\\"\", \"Resolve to the SNOMED concept\"]" ;
    scp:caseGraph "{\"nodes\": [[\"heart attack\", \"o\"], [\"MI\", \"o\"], [\"myocardial infarction\", \"o\"], [\"SNOMED concept\", \"s\"]], \"edges\": [[0, 3, \"altLabel\"], [1, 3, \"altLabel\"], [2, 3, \"prefLabel\"]]}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "SNOMED CT maps 'heart attack', 'myocardial infarction', and 'MI' to one clinical concept, so a nurse's phrasing and a coder's term retrieve the same record."@en ;
    scp:exampleVisual "synonyms" ;
    scp:ofConcept scp:SKOS .

scp:case_SKOS_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
:Film a skos:Concept ;
  skos:prefLabel "Motion pictures"@en ;
  skos:altLabel "film"@en ; skos:altLabel "movie"@en ; skos:altLabel "cinema"@en .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"query\", \"resolves to\"], \"rows\": [[\"\\\"movie\\\"\", \"Motion pictures\"], [\"\\\"cinema\\\"\", \"Motion pictures\"]]}" ;
    scp:caseExecSteps "[\"Define the subject concept\", \"Attach prefLabel\", \"Attach altLabels\", \"Patron searches \\\"movie\\\"\", \"Resolve to one subject\"]" ;
    scp:caseGraph "{\"nodes\": [[\"film\", \"o\"], [\"movie\", \"o\"], [\"cinema\", \"o\"], [\"subject concept\", \"s\"]], \"edges\": [[0, 3, \"altLabel\"], [1, 3, \"altLabel\"], [2, 3, \"prefLabel\"]]}" ;
    scp:exampleDomain "Library" ;
    scp:exampleText "A thesaurus maps 'film', 'movie', and 'cinema' to one subject concept — the canonical SKOS use case for which the standard was designed."@en ;
    scp:exampleVisual "synonyms" ;
    scp:ofConcept scp:SKOS .

scp:case_SPARQL_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT ?p WHERE {
  ?p :brand :HouseLabel ; :category :MensShirt .
}""" ;
    scp:caseCodeLang "sparql" ;
    scp:caseExecResult "{\"cols\": [\"?p\"], \"rows\": [[\"ShirtA\"], [\"ShirtB\"]]}" ;
    scp:caseExecSteps "[\"Bind ?p to all nodes\", \"Keep brand :HouseLabel\", \"Keep category :MensShirt\", \"Collect matches\"]" ;
    scp:caseGraph "{\"nodes\": [[\"?product\", \"s\"], [\"HouseLabel\", \"o\"], [\"MensShirt\", \"o\"]], \"edges\": [[0, 1, \"brand\"], [0, 2, \"category\"]]}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "SELECT ?p WHERE { ?p :brand :HouseLabel } returns every own-brand product — the same pattern faceted navigation runs on a storefront."@en ;
    scp:exampleVisual "pattern" ;
    scp:ofConcept scp:SPARQL .

scp:case_SPARQL_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT ?origin WHERE {
  :Parcel_9 (:via)+ ?origin .
}""" ;
    scp:caseCodeLang "sparql" ;
    scp:caseExecResult "{\"cols\": [\"?origin\"], \"rows\": [[\"Hub_IST\"], [\"Origin_Depot\"]]}" ;
    scp:caseExecSteps "[\"Start at Parcel_9\", \"Follow :via one or more hops\", \"Reach the chain origin\", \"Return it\"]" ;
    scp:caseGraph "{\"nodes\": [[\"?parcel\", \"s\"], [\"?hub\", \"p\"], [\"origin\", \"o\"]], \"edges\": [[0, 1, \"via+\"], [1, 2, \"path\"]]}" ;
    scp:exampleDomain "Logistics" ;
    scp:exampleText "A property-path query traces a parcel's whole chain of custody back to its origin in one expression, however many hops it took."@en ;
    scp:exampleVisual "pattern" ;
    scp:ofConcept scp:SPARQL .

scp:case_SPARQL_2 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """SELECT ?p WHERE {
  ?p wdt:P166 wd:Q38104 ; wdt:P21 wd:Q6581072 .
}  # Nobel Physics, female""" ;
    scp:caseCodeLang "sparql" ;
    scp:caseExecResult "{\"cols\": [\"?p\"], \"rows\": [[\"Marie Curie\"], [\"Maria Mayer\"]]}" ;
    scp:caseExecSteps "[\"Bind ?p over Wikidata\", \"Keep award = Nobel Physics\", \"Keep sex = female\", \"Return laureates\"]" ;
    scp:caseGraph "{\"nodes\": [[\"?laureate\", \"s\"], [\"Nobel Physics\", \"o\"], [\"female\", \"o\"]], \"edges\": [[0, 1, \"awarded\"], [0, 2, \"sex\"]]}" ;
    scp:exampleDomain "Web" ;
    scp:exampleText "Wikidata's public SPARQL endpoint answers 'all female Nobel laureates in physics' as a single graph pattern over a community knowledge graph of billions of triples."@en ;
    scp:exampleVisual "pattern" ;
    scp:idGlossary "{\"source\": \"Wikidata (verified via Special:EntityData, https://www.wikidata.org/wiki/)\", \"note\": \"Wikidata uses opaque IDs so the same entity works across all languages. P\\u2026 = property, Q\\u2026 = entity/value.\", \"entries\": [[\"wdt:P166\", \"award received\", \"https://www.wikidata.org/wiki/Property:P166\", \"property: an award or recognition received\"], [\"wd:Q38104\", \"Nobel Prize in Physics\", \"https://www.wikidata.org/wiki/Q38104\", \"the physics award given yearly by the Royal Swedish Academy of Sciences\"], [\"wdt:P21\", \"sex or gender\", \"https://www.wikidata.org/wiki/Property:P21\", \"property: the sex or gender of the subject\"], [\"wd:Q6581072\", \"female\", \"https://www.wikidata.org/wiki/Q6581072\", \"the value used with P21 to indicate a female subject\"]], \"reads_as\": \"\\\"?p received the Nobel Prize in Physics (P166 = Q38104) and ?p\\u2019s sex or gender (P21) is female (Q6581072).\\\"\", \"live_result\": \"As of this writing the live query returns 5 laureates: Marie Sklodowska-Curie, Maria Goeppert Mayer, Donna Strickland, Andrea M. Ghez, Anne L\\u2019Huillier.\"}" ;
    scp:ofConcept scp:SPARQL .

scp:case_SemanticDrift_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
ex:c_jumper a skos:Concept ; skos:prefLabel "jumper"@en-GB ; skos:altLabel "sweater"@en-US .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "Without fixed IRIs, the meaning of a label drifts; pinning a concept to an IRI prevents it." ;
    scp:ofConcept scp:SemanticDrift .

scp:case_SemanticWebVision_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """# the Semantic Web vision, in four generic moves
# 1. data is published WITH MEANING (not just text)
:thing      :hasProperty   :value .
# 2. a SECOND source uses the SAME shared meaning
:otherThing :hasProperty   :value .
# 3. an agent LINKS facts across both sources via shared terms
# 4. the agent ACTS on the linked meaning (no human reading needed)""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"the move\", \"what it achieves\"], \"rows\": [[\"data + shared meaning\", \"machines can interpret it\"], [\"agent reads meaning\", \"no human reading required\"], [\"links across sources\", \"one connected web of data\"], [\"agent acts\", \"tasks completed autonomously\"]]}" ;
    scp:caseExecSteps "[\"Publish data with explicit meaning (mark it up with shared vocabulary)\", \"A software agent reads the meaning \\u2014 not just the text\", \"The agent links facts across different sources via shared terms\", \"The agent acts on the combined meaning automatically\"]" ;
    scp:caseGraph "{\"nodes\": [[\"web of documents\", \"s\"], [\"add meaning\", \"p\"], [\"web of data\", \"o\"]], \"edges\": [[0, 1, \"RDF/OWL\"], [1, 2, \"agents act\"]]}" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "The Semantic Web vision: instead of the Web being pages of text only people can read, data across many sources carries explicit, machine-readable meaning, so software agents can combine it and act. The process is always the same four moves — publish data with meaning, let agents read that meaning, link facts across sources, then act on the result."@en ;
    scp:ofConcept scp:SemanticWebVision .

scp:case_Serialization_0 a scp:ExampleCase ;
    scp:caseCode """@prefix ex: <http://ex.org/> .
ex:tshirt_A ex:brand ex:ExBrand .""" ;
    scp:caseCodeLang "turtle" ;
    scp:exampleDomain "Cross-domain" ;
    scp:exampleText "The same triple can be written in different syntaxes; here Turtle and the equivalent N-Triples." ;
    scp:ofConcept scp:Serialization .

scp:case_TBoxABoxRBox_0 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# TBox (schema)
:TShirt rdfs:subClassOf :Clothing .
# ABox (instances)
ex:tshirt_A a :TShirt ; :soldIn ex:store_1 .
# RBox (role axioms)
:soldIn rdfs:subPropertyOf :relatedToStore .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"tier\", \"contributes\"], \"rows\": [[\"TBox\", \"ex:tshirt_A is Clothing\"], [\"ABox\", \"ex:tshirt_A soldIn ex:store_1\"], [\"RBox\", \"\\u2026hence relatedTostore ex:store_1\"]]}" ;
    scp:caseExecSteps "[\"Load TBox: TShirt \\u2291 Clothing\", \"Load ABox: ex:tshirt_A a TShirt\", \"Load RBox: soldIn \\u2291 relatedToStore\", \"Reasoner combines all three\", \"ex:tshirt_A relatedTostore ex:store_1\"]" ;
    scp:caseGraph "{\"nodes\": [[\"T-Shirt \\u2291 Clothing\", \"p\"], [\"ex:tshirt_A : T-Shirt\", \"s\"], [\"soldIn \\u2291 relatedTo\", \"o\"]], \"edges\": []}" ;
    scp:exampleDomain "Retail" ;
    scp:exampleText "TBox: T-Shirt ⊑ Clothing. ABox: ex:tshirt_A a T-Shirt, soldIn Store_A. RBox: soldIn ⊑ relatedToStore. The catalogue is exactly this — schema, live products, and the role axioms relating them."@en ;
    scp:exampleVisual "tiers" ;
    scp:ofConcept scp:TBoxABoxRBox .

scp:case_TBoxABoxRBox_1 a scp:ExampleCase,
        owl:NamedIndividual ;
    scp:caseCode """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# TBox (terminology)
:MI rdfs:subClassOf :CardiacEvent .
# ABox (patient record)
:Patient_5 :hasEvent :Event_9 .  :Event_9 a :MI .
# RBox
:hasEvent rdfs:subPropertyOf :hasClinicalFact .""" ;
    scp:caseCodeLang "turtle" ;
    scp:caseExecResult "{\"cols\": [\"tier\", \"contributes\"], \"rows\": [[\"TBox\", \"Event_9 is a CardiacEvent\"], [\"ABox\", \"Patient_5 hasEvent Event_9\"], [\"RBox\", \"\\u2026hence hasClinicalFact\"]]}" ;
    scp:caseExecSteps "[\"Load TBox terminology\", \"Load ABox patient record\", \"Load RBox role axioms\", \"Reasoner classifies\", \"Event_9 is a CardiacEvent / clinical fact\"]" ;
    scp:caseGraph "{\"nodes\": [[\"terminology (TBox)\", \"p\"], [\"patient record (ABox)\", \"s\"], [\"role axioms (RBox)\", \"o\"]], \"edges\": []}" ;
    scp:exampleDomain "Healthcare" ;
    scp:exampleText "TBox: the clinical terminology. ABox: a specific patient's records. RBox: the relations between clinical roles. A medical knowledge base is the same three-part decomposition."@en ;
    scp:exampleVisual "tiers" ;
    scp:ofConcept scp:TBoxABoxRBox .

