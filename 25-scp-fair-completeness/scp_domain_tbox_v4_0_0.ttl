scp:LogicTrust a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Logic / Proof / Trust"@en ;
    dcterms:source scp:ref_01 ;
    scp:builtOn scp:OWL ;
    scp:extendedTreatment "Above the standardized layers sit the Logic, Proof, and Trust layers of Berners-Lee's original illustration. These concern rule languages, the ability to verify a chain of inference, and the social and cryptographic basis for trusting data. They remain partly aspirational, the least settled part of the stack."@en ;
    scp:hasVisual "layers" ;
    scp:icon "🔐" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "The still-evolving upper layers of the cake."@en .

scp:OntologyMethodology a owl:Class ;
    rdfs:label "Ontology methodology & types"@en ;
    dcterms:source scp:ref_03 ;
    scp:extendedTreatment "Uschold and Gruninger established that ontologies come in kinds — upper, domain, task, and application — and that engineering them is a methodical activity with identifiable principles and trade-offs. This typology is the basis of the layered architecture treated later. It moved ontology work from craft toward engineering discipline."@en ;
    scp:hasVisual "compass" ;
    scp:icon "🧭" ;
    rdfs:subClassOf scp:Foundations ;
    skos:definition "Principles, methods, and the upper/domain/task/application typology."@en ;
    skos:scopeNote "Grounded in Uschold & Gruninger (1996)"@en .

scp:SemanticDrift a owl:Class ;
    rdfs:label "Semantic drift"@en ;
    dcterms:source scp:ref_05 ;
    scp:extendedTreatment "Semantic drift is not that data is wrong but that the same term means subtly different things in different parts of an organization, invisible until cross-functional questions force the differences into contact. It is the core problem the semantic control plane addresses. Each silo passes its own validation yet joins produce silent nonsense."@en ;
    scp:hasVisual "drift" ;
    scp:icon "🌊" ;
    scp:relatedConcept scp:SemanticWebVision ;
    rdfs:subClassOf scp:Foundations ;
    skos:definition "Fragmentation of meaning across silos."@en .

