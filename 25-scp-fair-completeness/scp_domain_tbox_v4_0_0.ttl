scp:ref_14 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Arp, Smith & Spear (2015)"@en ;
    dcterms:source "Arp, Smith & Spear (2015) — MIT Press" ;
    scp:url "https://doi.org/10.7551/mitpress/9780262527811.001.0001" ;
    skos:definition "Building Ontologies with Basic Formal Ontology. MIT Press. BFO — foundational/upper ontology; now ISO/IEC 21838-2."@en .

scp:ref_17 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "ISO/IEC 21838 (2021)"@en ;
    dcterms:source "ISO/IEC 21838 (2021) — ISO standard" ;
    scp:url "https://www.iso.org/standard/71954.html" ;
    skos:definition "Information technology — Top-level ontologies (TLO). ISO standard. standardizes BFO as a top-level ontology."@en .

scp:ref_20 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Singhal / Google (2012)"@en ;
    dcterms:source "Singhal / Google (2012) — Google Blog" ;
    scp:url "https://blog.google/products/search/introducing-knowledge-graph-things-not/" ;
    skos:definition "Introducing the Knowledge Graph: things, not strings. Google Blog. origin of the modern term 'knowledge graph'."@en .

scp:ref_21 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Angles et al. (2017)"@en ;
    dcterms:source "Angles et al. (2017) — ACM Computing Surveys 50(5)" ;
    scp:url "https://doi.org/10.1145/3104031" ;
    skos:definition "Foundations of Modern Query Languages for Graph Databases. ACM Computing Surveys 50(5). graph query language foundations."@en .

scp:ref_22 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Edge et al. / Microsoft (2024)"@en ;
    dcterms:source "Edge et al. / Microsoft (2024) — arXiv" ;
    scp:url "https://arxiv.org/abs/2404.16130" ;
    skos:definition "From Local to Global: A Graph RAG Approach to Query-Focused Summarization. arXiv. the Microsoft GraphRAG paper."@en .

scp:ref_24 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Pan et al. (2024)"@en ;
    dcterms:source "Pan et al. (2024) — IEEE TKDE" ;
    scp:url "https://doi.org/10.1109/TKDE.2024.3352100" ;
    skos:definition "Unifying Large Language Models and Knowledge Graphs: A Roadmap. IEEE TKDE. LLM+KG integration roadmap."@en .

scp:GraphQuery a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Graph query foundations"@en ;
    dcterms:source scp:ref_21 ;
    scp:extendedTreatment "Angles and colleagues established the formal foundations of modern graph query languages, the theory underlying SPARQL and property-graph languages alike. It is the rigorous basis for reasoning about what graph queries can and cannot express. The work bridges database theory and the semantic web."@en ;
    scp:hasVisual "path" ;
    scp:icon "🛤️" ;
    scp:industryLabel "Neo4j / Cypher" ;
    scp:industryLink "https://neo4j.com/" ;
    scp:industryNote "The property-graph database whose query language complements SPARQL."@en ;
    scp:queries scp:KnowledgeGraphs ;
    scp:relatedConcept scp:SPARQL ;
    scp:resourceLabel "Graph query foundations (Angles et al.)" ;
    scp:resourceLink "https://doi.org/10.1145/3104031" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Foundations of modern graph query languages."@en ;
    skos:scopeNote "Grounded in Angles et al. (2017)"@en .

scp:LLMKG a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "LLM + KG roadmap"@en ;
    dcterms:source scp:ref_24 ;
    scp:extendedTreatment "Pan and colleagues mapped the reciprocal relationship between large language models and knowledge graphs: the graph grounds the model's factual claims, and the model helps construct and enrich the graph. Their roadmap frames the integration as bidirectional rather than one-way retrieval. It is the strategic synthesis of the two technologies."@en ;
    scp:hasVisual "bidir" ;
    scp:icon "🔮" ;
    scp:relatedConcept scp:GraphRAG ;
    scp:resourceLabel "Unifying LLMs & KGs (Pan et al.)" ;
    scp:resourceLink "https://doi.org/10.1109/TKDE.2024.3352100" ;
    scp:usesVocabularyFrom scp:RDF ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Unifying large language models and knowledge graphs."@en ;
    skos:scopeNote "Grounded in Pan et al. (2024)"@en .

scp:PropertyGraph a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Property graph (Neo4j / Cypher)"@en ;
    scp:extendedTreatment "The property-graph model represents data as nodes and relationships that each carry key-value properties, queried with languages such as Cypher and the new ISO GQL standard. It is the other major graph paradigm beside RDF: more developer-friendly and performant for pathfinding on operational graphs, but without RDF's global IRIs, formal semantics, and standardized reasoning. The two are complementary — property graphs excel at operational traversal, while RDF excels at integration, inference, and cross-organization interoperability — and modern systems increasingly bridge them."@en ;
    scp:icon "🔵" ;
    scp:resourceLabel "Cypher (Neo4j)" ;
    scp:resourceLink "https://neo4j.com/docs/cypher-manual/" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    owl:disjointWith scp:RDF ;
    skos:definition "Nodes and relationships carrying key-value properties, queried with Cypher/GQL."@en .

scp:RelationalModel a owl:Class ;
    rdfs:label "Relational model (SQL)"@en ;
    scp:extendedTreatment "The relational model organizes data into tables with a fixed schema, joined on keys and queried with SQL. It is the baseline almost every audience knows, and the natural point of comparison for semantic technologies. Its strength is maturity, transactional integrity, and performance on well-known, stable schemas; its limitation is that integrating data designed by different teams requires reconciling incompatible schemas up front, which is precisely the friction RDF and ontologies remove by replacing fixed tables with a flexible graph."@en ;
    scp:icon "🗄️" ;
    scp:resourceLabel "Relational model" ;
    scp:resourceLink "https://en.wikipedia.org/wiki/Relational_model" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    owl:disjointWith scp:KnowledgeGraphs ;
    skos:definition "Data as tables of rows and columns, queried with SQL — the dominant enterprise baseline."@en .

scp:SemanticWebVision a owl:Class ;
    rdfs:label "The Semantic Web vision"@en ;
    dcterms:source scp:ref_01 ;
    scp:extendedTreatment "In their 2001 Scientific American article, Berners-Lee, Hendler, and Lassila described an evolution of the Web in which information carries explicitly defined meaning, letting software agents act on data rather than merely display it. The vision rested on enriching web resources with semantic markup in languages like RDF and OWL, turning a web of documents into a web of data. It set the research agenda for two decades of standards work."@en ;
    scp:hasVisual "web" ;
    scp:icon "🌐" ;
    scp:relatedConcept scp:OntologyDefinition,
        scp:VisionRevisited ;
    scp:resourceLabel "The Semantic Web (2001)" ;
    scp:resourceLink "https://www.scientificamerican.com/article/the-semantic-web/" ;
    rdfs:subClassOf scp:Foundations ;
    skos:definition "A Web where information carries machine-defined meaning via metadata and ontologies."@en ;
    skos:scopeNote "Grounded in Berners-Lee, Hendler & Lassila (2001)"@en .

scp:Serialization a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Serialization (Turtle / JSON-LD)"@en ;
    dcterms:source scp:ref_13 ;
    scp:codeLang "json" ;
    scp:codeSnippet """{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Cotton T-Shirt",
  "brand": "ExBrand",
  "offers": { "@type": "Offer", "price": "199.99", "priceCurrency": "TRY" }
}""" ;
    scp:extendedTreatment "RDF is an abstract model that serializes into several interchangeable syntaxes: Turtle for human-readable triples, JSON-LD for web-native linked data that travels in ordinary JSON, and RDF/XML for legacy interchange. The choice of serialization is independent of the graph's meaning. JSON-LD in particular lowered the barrier for mainstream web developers."@en ;
    scp:hasVisual "serial" ;
    scp:icon "🔁" ;
    scp:industryLabel "Google structured data" ;
    scp:industryLink "https://developers.google.com/search/docs/appearance/structured-data" ;
    scp:industryNote "JSON-LD that Google reads to build rich search results."@en ;
    scp:relatedConcept scp:RDF ;
    scp:resourceLabel "W3C JSON-LD 1.1" ;
    scp:resourceLink "https://www.w3.org/TR/json-ld11/" ;
    scp:serializes scp:RDF ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Interchangeable concrete syntaxes for RDF."@en .

scp:VisionRevisited a owl:Class ;
    rdfs:label "The vision reassessed"@en ;
    dcterms:source scp:ref_05 ;
    scp:extendedTreatment "A decade after the founding article, Shadbolt, Berners-Lee, and Hall reassessed which parts of the vision had materialized. They found the data-and-standards substrate largely realized while the intelligent-agent layer remained aspirational. The reassessment recalibrated expectations toward linked data and away from full agent autonomy."@en ;
    scp:hasVisual "timeline" ;
    scp:icon "🔭" ;
    rdfs:subClassOf scp:Foundations ;
    skos:definition "A ten-year reassessment of the Semantic Web vision."@en ;
    skos:scopeNote "Grounded in Shadbolt, Berners-Lee & Hall (2006)"@en .

scp:ref_01 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Berners-Lee, Hendler & Lassila (2001)"@en ;
    dcterms:source "Berners-Lee, Hendler & Lassila (2001) — Scientific American 284(5):34-43" ;
    scp:url "https://www.scientificamerican.com/article/the-semantic-web/" ;
    skos:definition "The Semantic Web. Scientific American 284(5):34-43. the founding vision: machine-meaningful web via metadata + ontologies."@en .

scp:ref_03 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Uschold & Gruninger (1996)"@en ;
    dcterms:source "Uschold & Gruninger (1996) — Knowledge Engineering Review 11(2)" ;
    scp:url "https://doi.org/10.1017/S0269888900007797" ;
    skos:definition "Ontologies: principles, methods and applications. Knowledge Engineering Review 11(2). ontology types: upper/domain/task/application."@en .

scp:ref_04 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Guarino (1998)"@en ;
    dcterms:source "Guarino (1998) — IOS Press" ;
    scp:url "https://www.iospress.com/catalog/books/formal-ontology-in-information-systems" ;
    skos:definition "Formal Ontology in Information Systems. IOS Press. foundational ontology theory; layered ontology architecture."@en .

scp:ref_12 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "W3C (2013)"@en ;
    dcterms:source "W3C (2013) — W3C Recommendation" ;
    scp:url "https://www.w3.org/TR/prov-o/" ;
    skos:definition "PROV-O — The PROV Ontology. W3C Recommendation. provenance: Entity/Activity/Agent."@en .

scp:ref_18 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Hogan et al. (2021)"@en ;
    dcterms:source "Hogan et al. (2021) — ACM Computing Surveys 54(4), Article 71" ;
    scp:url "https://doi.org/10.1145/3447772" ;
    skos:definition "Knowledge Graphs. ACM Computing Surveys 54(4), Article 71. the definitive modern KG survey (18 authors)."@en .

scp:ref_19 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Baader, Horrocks, Lutz & Sattler (2017)"@en ;
    dcterms:source "Baader, Horrocks, Lutz & Sattler (2017) — Cambridge University Press" ;
    scp:url "https://doi.org/10.1017/9781139025355" ;
    skos:definition "An Introduction to Description Logic. Cambridge University Press. the DL textbook; TBox/ABox/RBox formal basis."@en .

scp:DLReasoning a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Description-logic reasoning"@en ;
    dcterms:source scp:ref_19 ;
    scp:extendedTreatment "Description logics are the formal family underlying OWL, balancing expressivity against decidable, terminating inference. A reasoner computes class subsumption, consistency, and instance classification automatically. The Baader handbook is the standard treatment of their syntax, semantics, and algorithms."@en ;
    scp:hasVisual "reasoner" ;
    scp:icon "🧮" ;
    scp:industryLabel "Protégé + reasoners" ;
    scp:industryLink "https://protege.stanford.edu/" ;
    scp:industryNote "The standard ontology editor with built-in description-logic reasoners."@en ;
    scp:relatedConcept scp:OWL,
        scp:TBoxABoxRBox ;
    scp:resourceLabel "DL Handbook (Baader et al.)" ;
    scp:resourceLink "https://doi.org/10.1017/9781139025355" ;
    rdfs:subClassOf scp:LayeredOntology ;
    skos:definition "Decidable inference over ontology axioms."@en .

scp:IRI a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "IRI / URI — identity"@en ;
    dcterms:source scp:ref_13 ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix schema: <http://schema.org/> .
# one globally unique name three systems can share
<https://example.org/catalog/womens-tshirt>
    a schema:ProductGroup ;
    schema:name "Women's T-Shirt" .""" ;
    scp:extendedTreatment "Internationalized Resource Identifiers generalize URIs to give every resource a globally unique name. Identity is the precondition for the whole stack: without a shared way to name a thing, no statement about it can be merged across systems. Every triple's subject, predicate, and object is an IRI or a literal."@en ;
    scp:hasVisual "iri" ;
    scp:icon "🆔" ;
    scp:relatedConcept scp:LinkedData,
        scp:RDF ;
    scp:resourceLabel "W3C IRIs" ;
    scp:resourceLink "https://www.w3.org/TR/rdf11-concepts/#section-IRIs" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Globally unique names for resources."@en .

scp:ISO21838 a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "ISO/IEC 21838 top-level ontologies"@en ;
    dcterms:source scp:ref_17 ;
    scp:extendedTreatment "ISO/IEC 21838 standardizes top-level ontologies, with BFO as Part 2. Standardization matters because a foundational ontology's value is proportional to how widely it is shared. It is the foundation for the OBO and Industrial Ontologies Foundries."@en ;
    scp:hasVisual "standard" ;
    scp:icon "📐" ;
    scp:industryLabel "Basic Formal Ontology" ;
    scp:industryLink "https://basic-formal-ontology.org/" ;
    scp:industryNote "The ISO/IEC 21838-2 standard upper ontology, freely available."@en ;
    scp:resourceLabel "ISO/IEC 21838-2 (BFO)" ;
    scp:resourceLink "https://www.iso.org/standard/74572.html" ;
    rdfs:subClassOf scp:LayeredOntology ;
    skos:definition "Standardizes BFO as a top-level ontology."@en ;
    skos:scopeNote "Grounded in ISO/IEC 21838 (2021)"@en .

scp:LinkedData a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Linked data"@en ;
    dcterms:source scp:ref_05 ;
    scp:builtOn scp:RDF ;
    scp:extendedTreatment "Linked data is the practical realization of the semantic-web substrate: publishing data as dereferenceable IRIs linked to other data, forming a global graph. It is the part of the 2001 vision that most fully materialized. The principles emphasize using standard formats and linking to related resources."@en ;
    scp:hasVisual "web" ;
    scp:icon "🌍" ;
    scp:industryLabel "DBpedia" ;
    scp:industryLink "https://www.dbpedia.org/" ;
    scp:industryNote "Wikipedia published as linked data, queryable by SPARQL."@en ;
    scp:relatedConcept scp:IRI,
        scp:KGOrigin ;
    scp:resourceLabel "Linked Data (Berners-Lee)" ;
    scp:resourceLink "https://www.w3.org/DesignIssues/LinkedData.html" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Publishing interrelated data on the web."@en .

scp:OntologyAlignment a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Ontology alignment"@en ;
    dcterms:source scp:ref_04 ;
    scp:extendedTreatment "When two ontologies model overlapping domains independently, alignment establishes correspondences between their classes and properties. Foundational ontologies ease alignment by giving both a shared upper backbone. Alignment is what makes a federation of domain ontologies behave as one."@en ;
    scp:hasVisual "align" ;
    scp:icon "🔀" ;
    scp:industryLabel "AGROVOC (FAO)" ;
    scp:industryLink "https://agrovoc.fao.org/" ;
    scp:industryNote "A multilingual agricultural thesaurus aligned across many vocabularies."@en ;
    scp:relatedConcept scp:FoundationalOntology,
        scp:SKOS ;
    rdfs:subClassOf scp:LayeredOntology ;
    skos:definition "Mapping concepts across independent ontologies."@en .

scp:OntologyDefinition a owl:Class ;
    rdfs:label "The ontology definition"@en ;
    dcterms:source scp:ref_02 ;
    scp:extendedTreatment "Gruber's 1993 formulation — an ontology is an explicit specification of a conceptualization — is the most-cited definition in the field, drawn from the journal's highest-cited article. It frames an ontology as a shared, formal vocabulary: definitions of classes, relations, and functions for a domain of discourse. Every later standard, from RDFS to OWL, operationalizes this idea."@en ;
    scp:hasVisual "spec" ;
    scp:icon "📖" ;
    scp:resourceLabel "Gruber (1993)" ;
    scp:resourceLink "https://doi.org/10.1006/knac.1993.1008" ;
    rdfs:subClassOf scp:Foundations ;
    skos:definition "An ontology is an explicit specification of a conceptualization."@en ;
    skos:scopeNote "Grounded in Gruber (1993)"@en .

scp:PROVO a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "PROV-O — provenance"@en ;
    dcterms:source scp:ref_12 ;
    scp:builtOn scp:RDF ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix : <http://ex.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

:Forecast_Q3 prov:wasGeneratedBy :ForecastRun_88 ;
             prov:wasAttributedTo :PlanningAgent ;
             prov:generatedAtTime "2026-06-01T09:00:00"^^xsd:dateTime .""" ;
    scp:extendedTreatment "PROV-O (2013) provides a vocabulary for provenance: Entity, Activity, and Agent, capturing how data was generated, modified, and used. It is essential for traceability and auditability in distributed semantic applications. Provenance is what lets a consumer judge whether to trust a piece of data."@en ;
    scp:icon "📜" ;
    scp:industryLabel "W3C PROV" ;
    scp:industryLink "https://www.w3.org/TR/prov-o/" ;
    scp:industryNote "The provenance standard used across scientific and government data."@en ;
    scp:relatedConcept scp:RDF ;
    scp:resourceLabel "W3C PROV-O" ;
    scp:resourceLink "https://www.w3.org/TR/prov-o/" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Entity / Activity / Agent traceability."@en ;
    skos:scopeNote "Grounded in W3C (2013)"@en .

scp:Simulation a owl:Class ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "An interactive or executable artifact that models a concept's behaviour for the reader."@en .

scp:TBoxABoxRBox a owl:Class ;
    rdfs:label "TBox / ABox / RBox decomposition"@en ;
    dcterms:source scp:ref_19 ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# TBox (schema)
:TShirt rdfs:subClassOf :Clothing .
# ABox (instances)
ex:tshirt_A a :TShirt ; :soldIn ex:store_1 .
# RBox (role axioms)
:soldIn rdfs:subPropertyOf :relatedToStore .""" ;
    scp:explainerData "{\"title\": \"TBox vs ABox vs RBox vs SHACL \\u2014 four roles, one knowledge base\", \"rows\": [{\"name\": \"TBox\", \"full\": \"Terminological Box\", \"governs\": \"the schema \\u2014 classes & their hierarchy\", \"example\": \"T-Shirt \\u2291 Clothing \\u2291 Product\", \"q\": \"What kinds of things can exist?\", \"color\": \"#5b8a72\"}, {\"name\": \"ABox\", \"full\": \"Assertional Box\", \"governs\": \"the instances \\u2014 actual data\", \"example\": \"ex:tshirt_A a T-Shirt ; soldIn ex:store_1\", \"q\": \"What things actually exist right now?\", \"color\": \"#9a5b6e\"}, {\"name\": \"RBox\", \"full\": \"Role Box\", \"governs\": \"the properties \\u2014 role hierarchy & composition\", \"example\": \"soldIn \\u2291 relatedToStore ; partOf is transitive\", \"q\": \"How do relations behave & compose?\", \"color\": \"#b5803a\"}, {\"name\": \"SHACL\", \"full\": \"Shapes Constraint Language\", \"governs\": \"validation \\u2014 what data MUST satisfy\", \"example\": \"every Product needs \\u22651 brand & exactly 1 category\", \"q\": \"Is the data valid for production?\", \"color\": \"#4a7c8c\"}], \"note\": \"TBox/ABox/RBox come from description logic and describe what IS or can be INFERRED (open-world). SHACL is a separate W3C standard describing what MUST HOLD for data to be accepted (closed-world validation). OWL says what follows; SHACL says what is required.\"}" ;
    scp:extendedTreatment "Description logic decomposes a knowledge base into the TBox (terminological axioms — the schema), the ABox (assertional axioms — the instance data), and the RBox (role axioms — property hierarchies and compositions). This is the precise sense in which instances are part of the architecture: the ABox is a first-class tier, not a separate file. A knowledge graph is an ABox populating a TBox."@en ;
    scp:hasVisual "tiers" ;
    scp:icon "📦" ;
    scp:relatedConcept scp:DLReasoning,
        scp:OWL ;
    rdfs:subClassOf scp:LayeredOntology ;
    skos:definition "Schema axioms / instance data / role axioms."@en ;
    skos:scopeNote "Grounded in Baader, Horrocks, Lutz & Sattler (2017)"@en .

scp:Taxonomy a owl:Class ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "A hierarchical classification of concepts by subsumption (is-a) relationships."@en .

scp:ref_05 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "Shadbolt, Berners-Lee & Hall (2006)"@en ;
    dcterms:source "Shadbolt, Berners-Lee & Hall (2006) — IEEE Intelligent Systems 21(3)" ;
    scp:url "https://doi.org/10.1109/MIS.2006.62" ;
    skos:definition "The Semantic Web Revisited. IEEE Intelligent Systems 21(3). ten-year reassessment of the vision."@en .

scp:ApplicationOntology a scp:OntologyTier,
        scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Application / task ontologies"@en ;
    dcterms:source scp:ref_04 ;
    scp:anchorsTo scp:DomainOntology ;
    scp:extendedTreatment "Application or task ontologies specialize domain concepts for a particular use — a perishable-SKU specialization, a replenishment-task model. They are the most concrete tier, closest to a running system. They import the domain ontology and add only what a specific application needs."@en ;
    scp:icon "⚙️" ;
    scp:relatedConcept scp:DomainOntology ;
    rdfs:subClassOf scp:LayeredOntology ;
    skos:definition "Use-specific specializations of domain concepts."@en ;
    skos:scopeNote "Grounded in Guarino (1998)"@en .

scp:Embeddings a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Knowledge-graph embeddings"@en ;
    dcterms:source scp:ref_18 ;
    scp:extendedTreatment "Knowledge-graph embeddings map entities and relations into continuous vector spaces, enabling inductive techniques such as link prediction alongside the deductive techniques of the symbolic stack. The Hogan survey treats both as complementary. Embeddings are how knowledge graphs connect to machine learning."@en ;
    scp:hasVisual "vector" ;
    scp:icon "📍" ;
    scp:industryLabel "PyKEEN" ;
    scp:industryLink "https://pykeen.readthedocs.io/" ;
    scp:industryNote "An open library of knowledge-graph embedding models."@en ;
    scp:relatedConcept scp:GraphRAG,
        scp:KGSurvey ;
    scp:resourceLabel "KG embeddings (in Hogan et al.)" ;
    scp:resourceLink "https://doi.org/10.1145/3447772" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Vector representations of graph entities."@en .

scp:KGOrigin a owl:Class ;
    rdfs:label "Origin of the modern term"@en ;
    dcterms:source scp:ref_20 ;
    scp:extendedTreatment "The modern term stems from Google's 2012 announcement of the Knowledge Graph — 'things, not strings' — followed by industrial knowledge graphs at Amazon, eBay, Facebook, IBM, LinkedIn, Microsoft, and others. The phrase existed in the literature since 1972, but 2012 marks its contemporary meaning. Industrial uptake drove the academic resurgence."@en ;
    scp:hasVisual "panel" ;
    scp:icon "🔵" ;
    scp:industryLabel "Wikidata" ;
    scp:industryLink "https://www.wikidata.org/" ;
    scp:industryNote "The open knowledge graph that powers structured facts across the web."@en ;
    scp:relatedConcept scp:KGSurvey,
        scp:LinkedData ;
    scp:resourceLabel "Google Knowledge Graph (2012)" ;
    scp:resourceLink "https://blog.google/products/search/introducing-knowledge-graph-things-not/" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Google 2012: things, not strings."@en ;
    skos:scopeNote "Grounded in Singhal / Google (2012)"@en .

scp:KGSurvey a owl:Class ;
    rdfs:label "The knowledge-graph survey"@en ;
    dcterms:source scp:ref_18 ;
    scp:extendedTreatment "The eighteen-author survey by Hogan and colleagues (ACM Computing Surveys, 2021) is the definitive modern treatment of knowledge graphs, contrasting graph data models, query and validation languages, and deductive and inductive techniques. It situates the W3C stack within the broader landscape of property graphs and graph databases. It is the standard reference for the field's current state. The survey's lasting contribution is to show that the symbolic semantic-web tradition and the statistical machine-learning tradition are complementary rather than competing: deductive reasoning over an ontology and inductive inference over embeddings answer different questions about the same graph, and a mature knowledge-graph system uses both. This reframing is what lets the field absorb large language models as a new inductive layer rather than treating them as a replacement."@en ;
    scp:hasVisual "survey" ;
    scp:icon "📊" ;
    scp:industryLabel "Linked Open Vocabularies" ;
    scp:industryLink "https://lov.linkeddata.es/" ;
    scp:industryNote "A live catalogue of real, reusable vocabularies and their relationships."@en ;
    scp:relatedConcept scp:Embeddings,
        scp:GraphRAG,
        scp:KGOrigin ;
    scp:resourceLabel "Knowledge Graphs survey (Hogan et al.)" ;
    scp:resourceLink "https://doi.org/10.1145/3447772" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "The definitive 18-author modern KG survey."@en ;
    skos:scopeNote "Grounded in Hogan et al. (2021)"@en .

scp:SHACL a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "SHACL — validation"@en ;
    dcterms:source scp:ref_10 ;
    scp:builtOn scp:RDF ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix : <http://ex.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

:ProductShape a sh:NodeShape ;
    sh:targetClass :Product ;
    sh:property [ sh:path :brand    ; sh:minCount 1 ] ;
    sh:property [ sh:path :category ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :price    ; sh:datatype xsd:decimal ] .""" ;
    scp:execResult "{\"cols\": [\"node\", \"result\"], \"rows\": [[\"PUMA shirt\", \"\\u2713 conforms\"], [\"untagged item\", \"\\u2717 missing :category\"], [\"no-price item\", \"\\u2717 :price not decimal\"]]}" ;
    scp:execSteps "[\"Take every node typed :Product\", \"Check it has \\u22651 :brand\", \"Check it has exactly 1 :category\", \"Check :price is a decimal\", \"Report conforms / violations\"]" ;
    scp:extendedTreatment "The Shapes Constraint Language fills the gap the rest of the stack leaves open: it specifies what must be true for data to be valid, as opposed to what may be inferred from it. A shape is a contract — these properties are required, this cardinality must hold, this value must be of this type — checked against incoming data at the boundary. This matters because inference and validation are different needs: OWL tells you what follows from your data, while SHACL stops malformed data from entering in the first place. It is therefore the quality-control layer of a production knowledge graph, the mechanism that holds a non-conforming supplier feed or a broken integration message back before it can corrupt downstream answers."@en ;
    scp:hasVisual "shape" ;
    scp:icon "✅" ;
    scp:industryLabel "SHACL Playground" ;
    scp:industryLink "https://shacl.org/playground/" ;
    scp:industryNote "Author and test SHACL shapes against sample data interactively."@en ;
    scp:relatedConcept scp:OWL,
        scp:SPARQL ;
    scp:resourceLabel "W3C SHACL" ;
    scp:resourceLink "https://www.w3.org/TR/shacl/" ;
    scp:validates scp:RDF ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Validation of RDF graphs against shape constraints."@en ;
    skos:scopeNote "Grounded in W3C (2017)"@en .

scp:SKOS a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "SKOS — vocabulary"@en ;
    dcterms:source scp:ref_11 ;
    scp:builtOn scp:RDF ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:   <http://ex.org/> .
ex:tshirt_cat a skos:Concept ;
  skos:prefLabel "T-Shirt"@en ;
  skos:altLabel  "tee shirt"@en ;   # spelling variant — same garment
  skos:altLabel  "tee"@en ;         # informal short form
  skos:altLabel  "Tişört"@tr .      # Turkish translation""" ;
    scp:extendedTreatment "The Simple Knowledge Organization System is the standard for the vocabulary layer: thesauri, taxonomies, and controlled term lists expressed in RDF. Its central move is to model a concept as a thing distinct from the words used to name it, linked by a preferred label and any number of alternative labels across languages. This matters wherever the same idea travels under many names — a retailer selling across twenty countries, a hospital where clinicians and coders use different phrasings, a library reconciling 'film', 'movie', and 'cinema' — because all those surface forms resolve to one concept rather than fragmenting into unrelated strings. SKOS is therefore the bridge between human language and the formal graph, and it underpins enormous real vocabularies such as the Library of Congress subject headings."@en ;
    scp:hasVisual "synonyms" ;
    scp:icon "🏷️" ;
    scp:industryLabel "Library of Congress (id.loc.gov)" ;
    scp:industryLink "https://id.loc.gov/" ;
    scp:industryNote "Massive real-world controlled vocabularies published as SKOS."@en ;
    scp:relatedConcept scp:OntologyAlignment,
        scp:RDFS ;
    scp:resourceLabel "W3C SKOS" ;
    scp:resourceLink "https://www.w3.org/TR/skos-reference/" ;
    scp:techCompare "[[\"Relational lookup table\", \"A synonyms table with term\\u2192concept_id rows \\u2014 works, but no standard semantics, languages, or graph links.\"], [\"Full-text search\", \"Matches strings, so \\\"ti\\u015f\\u00f6rt\\\" and \\\"T-shirt\\\" stay unrelated unless manually mapped \\u2014 exactly what SKOS concepts fix.\"], [\"OWL classes\", \"You *could* model synonyms as classes, but SKOS is the lightweight, purpose-built standard for vocabularies.\"]]" ;
    scp:techCompareRich "{\"scenario\": \"Goal: make \\u201cT-Shirt\\u201d, \\u201cTi\\u015f\\u00f6rt\\u201d (tr) and \\u201ctee\\u201d all resolve to one concept, so a search in any term finds the product.\", \"techs\": [{\"tech\": \"Relational lookup table\", \"kind\": \"table\", \"color\": \"#4a7c8c\", \"repr_kind\": \"table\", \"table\": {\"cols\": [\"term\", \"lang\", \"concept_id\"], \"rows\": [[\"T-Shirt\", \"en\", \"C_100\"], [\"Ti\\u015f\\u00f6rt\", \"tr\", \"C_100\"], [\"tee\", \"en\", \"C_100\"], [\"Chemise\", \"fr\", \"C_205\"]]}, \"code\": \"SELECT concept_id FROM synonyms\\nWHERE term = 'Ti\\u015f\\u00f6rt';   -- \\u2192 C_100\", \"lang\": \"sql\", \"note\": \"Works, but the meaning lives only in your application's convention. No standard for languages, broader/narrower links, or sharing the vocabulary across systems.\"}, {\"tech\": \"Full-text search\", \"kind\": \"index\", \"color\": \"#b5803a\", \"repr_kind\": \"code\", \"code\": \"index.search(\\\"ti\\u015f\\u00f6rt\\\")\\n# matches the STRING \\\"ti\\u015f\\u00f6rt\\\" only\\n# \\\"T-Shirt\\\" and \\\"tee\\\" are different strings \\u2192 NOT matched\", \"lang\": \"python\", \"note\": \"Matches characters, not meaning. \\u201cti\\u015f\\u00f6rt\\u201d and \\u201cT-shirt\\u201d stay unrelated unless you hand-build a synonym map \\u2014 which is exactly the concept SKOS standardizes.\"}, {\"tech\": \"OWL classes\", \"kind\": \"owl\", \"color\": \"#5b8a72\", \"repr_kind\": \"code\", \"code\": \":TShirt a owl:Class .\\n:Tisort owl:equivalentClass :TShirt .\\n# labels become CLASSES + equivalence axioms\", \"lang\": \"turtle\", \"note\": \"You *could* force synonyms into classes with equivalentClass, but that overloads the class system for what is really vocabulary. Heavier, and not what OWL classes are for.\"}, {\"tech\": \"SKOS (purpose-built)\", \"kind\": \"skos\", \"color\": \"#9a5b6e\", \"recommended\": true, \"repr_kind\": \"code\", \"code\": \"ex:tshirt_cat a skos:Concept ;\\n  skos:prefLabel \\\"T-Shirt\\\"@en ;\\n  skos:altLabel  \\\"tee shirt\\\"@en ;\\n  skos:altLabel  \\\"tee\\\"@en ;\\n  skos:altLabel  \\\"Ti\\u015f\\u00f6rt\\\"@tr .\", \"lang\": \"turtle\", \"note\": \"One concept, many labels with language tags \\u2014 the lightweight W3C standard built exactly for thesauri and vocabularies. Shareable, language-aware, and linkable to broader/narrower concepts.\"}], \"table_summary\": {\"cols\": [\"Capability\", \"Lookup table\", \"Full-text\", \"OWL classes\", \"SKOS\"], \"rows\": [[\"Resolves synonyms\", \"manual\", \"no\", \"yes\", \"yes\"], [\"Language-aware\", \"ad-hoc column\", \"no\", \"no\", \"yes (@lang tags)\"], [\"Standardized\", \"no\", \"no\", \"yes\", \"yes\"], [\"Broader/narrower links\", \"no\", \"no\", \"via subClassOf\", \"yes (skos:broader)\"], [\"Right tool for vocabularies\", \"partial\", \"no\", \"overkill\", \"yes\"]]}}" ;
    scp:usesVocabularyFrom scp:RDFS ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Taxonomies and controlled vocabularies (Concept, broader/narrower)."@en ;
    skos:scopeNote "Grounded in W3C (2009)"@en .

scp:SemanticTechnologyArea a owl:Class ;
    rdfs:label "Semantic Technology Area"@en ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "A top-level thematic grouping of semantic-technology concepts."@en .

scp:ref_13 a scp:Publication,
        owl:NamedIndividual ;
    rdfs:label "W3C (2014)"@en ;
    dcterms:source "W3C (2014) — W3C Recommendation" ;
    scp:url "https://www.w3.org/TR/json-ld11/" ;
    skos:definition "JSON-LD 1.0 / Turtle. W3C Recommendation. RDF serializations: JSON-LD for web data, Turtle for human-readable triples."@en .

scp:DomainOntology a scp:OntologyTier,
        scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Domain ontologies"@en ;
    dcterms:source scp:ref_03 ;
    scp:anchorsTo scp:FoundationalOntology ;
    scp:extendedTreatment "Domain ontologies capture the concepts of a specific field — for a supply chain, classes like supplier, distribution center, and replenishment. They sit beneath the foundational layer and above the application layer. Their reuse across projects is the practical payoff of the layered architecture."@en ;
    scp:icon "🏗️" ;
    scp:industryLabel "FIBO (finance)" ;
    scp:industryLink "https://spec.edmcouncil.org/fibo/" ;
    scp:industryNote "A 2,400+ class domain ontology of the financial industry, in OWL."@en ;
    scp:relatedConcept scp:ApplicationOntology,
        scp:FoundationalOntology ;
    rdfs:subClassOf scp:LayeredOntology ;
    owl:disjointWith scp:ApplicationOntology ;
    skos:definition "Field-specific concepts capturing a domain."@en ;
    skos:scopeNote "Grounded in Uschold & Gruninger (1996)"@en .

scp:Foundations a owl:Class ;
    rdfs:label "Foundations of Semantic Technology"@en ;
    scp:extendedTreatment "The field rests on two foundational texts — a vision and a definition — supplemented by a methodology and a decade-on reassessment. Together they establish what the semantic web is for and what an ontology is. Everything in the stack and the architecture operationalizes these foundations. The two texts are complementary: the vision says what the semantic web is for, the definition says what an ontology is, and together they let every later standard be read as an operationalization of one or the other. A faithful treatment of the field begins here, because the standards and the architecture only make sense as answers to the problems these foundations pose."@en ;
    scp:modelKind "concept_map" ;
    rdfs:subClassOf scp:SemanticTechnologyArea ;
    skos:definition "The founding vision and canonical definitions of the field."@en .

scp:ReportSection a owl:Class ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "A structural division of a generated RDODI report deliverable."@en .

scp:SPARQL a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "SPARQL 1.1 — query"@en ;
    dcterms:source scp:ref_12 ;
    scp:builtOn scp:RDF ;
    scp:codeLang "sparql" ;
    scp:codeSnippet """PREFIX : <http://ex.org/retail#>

SELECT ?product ?price WHERE {
  ?product :brand    :HouseLabel ;
           :category :MensShirt ;
           :price    ?price .
} ORDER BY ?price""" ;
    scp:crossTech "[{\"tech\": \"SPARQL (semantic)\", \"lang\": \"sparql\", \"code\": \"SELECT ?p WHERE {\\n  ?p :brand :HouseLabel ; :category :MensShirt . }\", \"impact\": \"Pattern matching over a graph; supports arbitrary-length paths and federation across endpoints. Standardized (W3C).\"}, {\"tech\": \"SQL\", \"lang\": \"sql\", \"code\": \"SELECT p.id, p.name\\nFROM products p\\nJOIN brands b ON p.brand_id=b.id\\nJOIN categories c ON p.category_id=c.id\\nWHERE b.name='HouseLabel' AND c.name='Men Shirt';\", \"impact\": \"Equivalent for fixed tables, decades of optimization \\u2014 but cannot express variable-length path traversal or cross-database federation natively.\"}, {\"tech\": \"Cypher (property graph)\", \"lang\": \"cypher\", \"code\": \"MATCH (p:Product)-[:HAS_BRAND]->(:Brand {name:'HouseLabel'}),\\n      (p)-[:IN_CATEGORY]->(:Category {name:'Men Shirt'})\\nRETURN p.id, p.name\", \"impact\": \"Very similar pattern feel; excellent for path queries. Operational, not a W3C standard, and not federatable like SPARQL.\"}, {\"tech\": \"Vector search\", \"lang\": \"python\", \"code\": \"hits = index.search(embed(\\\"men\\\\'s house-label shirt\\\"), k=10)\", \"impact\": \"Returns *similar* items by meaning, not *exact* matches. Great for discovery, wrong tool when you need precise, complete results.\"}]" ;
    scp:execResult "{\"cols\": [\"?product\", \"?price\"], \"rows\": [[\"ShirtA\", \"149.99\"], [\"ShirtB\", \"199.99\"], [\"ShirtC\", \"249.99\"]]}" ;
    scp:execSteps "[\"Bind ?product to every node in the graph\", \"Keep only those with :brand :HouseLabel\", \"Also require :category :MensShirt\", \"Read each match\\u2019s :price into ?price\", \"Sort the rows by ?price\"]" ;
    scp:extendedTreatment "SPARQL is to a knowledge graph what SQL is to a relational database: the standard way to ask questions of the data. Its core is graph-pattern matching — you describe the shape of the subgraph you want, with variables where you want answers, and the engine finds every binding that fits. This matters because it turns navigation into declaration: rather than hand-coding joins across tables, you state the pattern and let the engine traverse the graph, including arbitrary-length paths and federated queries that span multiple endpoints. It is the layer at which a graph stops being a store and becomes something you can interrogate, and its public deployments — most visibly the Wikidata Query Service — let anyone run real queries over graphs of billions of facts."@en ;
    scp:hasVisual "pattern" ;
    scp:icon "🔎" ;
    scp:industryLabel "Wikidata Query Service" ;
    scp:industryLink "https://query.wikidata.org/" ;
    scp:industryNote "Run live SPARQL over a community knowledge graph of billions of facts."@en ;
    scp:queries scp:RDF ;
    scp:relatedConcept scp:GraphQuery,
        scp:RDF ;
    scp:resourceLabel "W3C SPARQL 1.1" ;
    scp:resourceLink "https://www.w3.org/TR/sparql11-query/" ;
    scp:techCompare "[[\"SQL\", \"SELECT \\u2026 FROM product JOIN brand \\u2026 \\u2014 equivalent for fixed tables, but cannot traverse arbitrary-length paths or federate across endpoints.\"], [\"Cypher (property graph)\", \"MATCH (p:Product)-[:BRAND]->(b) RETURN p \\u2014 very similar pattern syntax; Cypher is operational, SPARQL is standardized & federatable.\"], [\"Vector search\", \"Returns *similar* items by embedding distance, not *exact* pattern matches \\u2014 complementary, not a replacement.\"]]" ;
    scp:techCompareRich "{\"scenario\": \"Goal: find every product whose brand is HouseLabel and whose category is Men\\u2019s Shirt.\", \"techs\": [{\"tech\": \"SQL (relational)\", \"color\": \"#4a7c8c\", \"repr_kind\": \"code\", \"lang\": \"sql\", \"code\": \"SELECT p.id, p.name\\nFROM products p\\nJOIN brands b ON p.brand_id=b.id\\nJOIN categories c ON p.category_id=c.id\\nWHERE b.name='HouseLabel' AND c.name='Men Shirt';\", \"note\": \"Equivalent on a fixed schema, decades of optimization. But the JOINs are bound to one table design; integrating another system means reconciling schemas first.\"}, {\"tech\": \"Cypher (property graph)\", \"color\": \"#5b8a72\", \"repr_kind\": \"code\", \"lang\": \"cypher\", \"code\": \"MATCH (p:Product)-[:HAS_BRAND]->(:Brand {name:'HouseLabel'}),\\n      (p)-[:IN_CATEGORY]->(:Category {name:'Men Shirt'})\\nRETURN p.id, p.name\", \"note\": \"Very similar graph-pattern feel and great for path queries. Operational, not a W3C standard, and properties are local with no global IRIs or federation.\"}, {\"tech\": \"Vector search\", \"color\": \"#b5803a\", \"repr_kind\": \"code\", \"lang\": \"python\", \"code\": \"hits = index.search(embed(\\\"men's house-label shirt\\\"), k=10)\\n# returns SIMILAR items by meaning, not exact matches\", \"note\": \"Great for fuzzy discovery, wrong for exact constraints \\u2014 it ranks by similarity, it doesn't guarantee brand=HouseLabel AND category=Men Shirt.\"}, {\"tech\": \"SPARQL (semantic)\", \"color\": \"#9a5b6e\", \"recommended\": true, \"repr_kind\": \"code\", \"lang\": \"sparql\", \"code\": \"SELECT ?p WHERE {\\n  ?p :brand :HouseLabel ; :category :MenShirt .\\n}\", \"note\": \"Pattern-match over a graph with global IRIs; supports arbitrary-length paths and federation across datasets \\u2014 the same query can span multiple sources.\"}], \"table_summary\": {\"cols\": [\"Capability\", \"SQL\", \"Cypher\", \"Vector\", \"SPARQL\"], \"rows\": [[\"Exact constraints\", \"yes\", \"yes\", \"no\", \"yes\"], [\"Variable-length paths\", \"hard (CTE)\", \"yes\", \"no\", \"yes\"], [\"Cross-dataset federation\", \"no\", \"no\", \"no\", \"yes\"], [\"Standardized (W3C)\", \"SQL std\", \"no\", \"no\", \"yes\"]]}}" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Graph-pattern matching, federation, property paths."@en ;
    skos:scopeNote "Grounded in W3C (2013)"@en .

scp:FoundationalOntology a scp:OntologyTier,
        scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Foundational / upper ontologies"@en ;
    dcterms:source scp:ref_14 ;
    scp:builtOn scp:ISO21838 ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix : <http://ex.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .

:SupplyChainNode rdfs:subClassOf bfo:BFO_0000040 .  # material entity
:Replenishment   rdfs:subClassOf bfo:BFO_0000015 .  # process
# two domain ontologies aligned via a shared upper backbone""" ;
    scp:extendedTreatment "A foundational, or upper, ontology defines the most abstract, domain-independent categories — object, process, quality, role — that every domain shares. Its purpose is interoperability: when two independently-built ontologies both anchor their concepts to the same upper categories, they can be aligned through that shared backbone rather than reconciled pairwise. This matters most as an enterprise grows by acquisition or expands across regions, because each new system aligns to the common foundation rather than integrating separately with every existing system, turning an N-squared integration problem into a linear one. The principal foundational ontologies are BFO, DOLCE, and SUMO; BFO's standardization as ISO/IEC 21838 and its use in the OBO and Industrial Ontologies Foundries show the model working at scale across biomedicine and manufacturing."@en ;
    scp:icon "🏛️" ;
    scp:industryLabel "OBO Foundry" ;
    scp:industryLink "https://obofoundry.org/" ;
    scp:industryNote "Hundreds of biomedical ontologies aligned to the Basic Formal Ontology."@en ;
    scp:layeredArchitecture "{\"title\": \"The three-tier ontology architecture\", \"intro\": \"Like a layered software architecture, ontologies are organized in tiers. Upper tiers are abstract and shared; lower tiers are concrete and specific. Each tier imports the one below it and specializes its concepts.\", \"layers\": [{\"name\": \"Application / Task layer\", \"role\": \"Most concrete \\u2014 specializes domain concepts for one running system or task.\", \"color\": \"#b5803a\", \"contents\": [\"ex:PerishableSKU\", \"ex:ReplenishmentTask\", \"ex:ColdChainShipment\"], \"example\": \"ex:PerishableSKU rdfs:subClassOf ex:Product ; (adds shelf-life constraints for one app)\"}, {\"name\": \"Domain layer\", \"role\": \"Concepts of one field (here: supply chain), reusable across applications in that field.\", \"color\": \"#5b8a72\", \"contents\": [\"ex:Supplier\", \"ex:DistributionCenter\", \"ex:Product\", \"ex:replenishes\"], \"example\": \"ex:Supplier rdfs:subClassOf bfo:Object ; ex:replenishes rdfs:subClassOf bfo:Process\"}, {\"name\": \"Foundational / Upper layer\", \"role\": \"Most abstract, domain-independent categories shared by ALL domains \\u2014 the interoperability backbone.\", \"color\": \"#2d4a52\", \"contents\": [\"bfo:Object\", \"bfo:Process\", \"bfo:Quality\", \"bfo:Role\"], \"example\": \"Two independently-built ontologies that both anchor to bfo:Object can be aligned automatically.\"}], \"dependency\": \"imports / anchors to\", \"mapping\": {\"cols\": [\"Domain concept\", \"anchors to (foundational)\", \"because it is a\\u2026\"], \"rows\": [[\"ex:Supplier\", \"bfo:Object\", \"standalone thing that persists\"], [\"ex:DistributionCenter\", \"bfo:Object\", \"physical site (a thing)\"], [\"ex:replenishes\", \"bfo:Process\", \"something that unfolds over time\"], [\"ex:shelfLife\", \"bfo:Quality\", \"a measurable property of a thing\"], [\"ex:SupplierRole\", \"bfo:Role\", \"a role a thing plays in a context\"]]}, \"takeaway\": \"Anchoring domain terms to a shared upper ontology (BFO here) is what lets separately-built ontologies interoperate \\u2014 the same reason layered software architectures share a common platform layer.\"}" ;
    scp:relatedConcept scp:DomainOntology,
        scp:ISO21838,
        scp:OntologyAlignment ;
    scp:resourceLabel "Basic Formal Ontology" ;
    scp:resourceLink "https://basic-formal-ontology.org/" ;
    rdfs:subClassOf scp:LayeredOntology ;
    owl:disjointWith scp:ApplicationOntology,
        scp:DomainOntology ;
    skos:definition "Domain-independent categories; BFO, DOLCE, SUMO."@en ;
    skos:scopeNote "Grounded in Arp, Smith & Spear (2015)"@en .

scp:LayeredOntology a owl:Class ;
    rdfs:label "The Layered Ontology Architecture"@en ;
    scp:extendedTreatment "An ontology is not a single file but a layered architecture with distinct tiers, each playing a different role. Vertically, foundational ontologies anchor domain ontologies, which anchor application ontologies. Orthogonally, description logic separates schema, instances, and role axioms."@en ;
    scp:modelKind "class_model" ;
    rdfs:subClassOf scp:SemanticTechnologyArea ;
    skos:definition "Foundational, domain, and application tiers plus TBox/ABox/RBox."@en .

scp:OntologyTier a owl:Class ;
    rdfs:label "Ontology tier" ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    rdfs:subClassOf scp:SemanticTechnology ;
    skos:definition "A layer in a layered-ontology architecture (e.g. foundational, core, domain) organizing concepts by abstraction."@en .

scp:GraphRAG a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "GraphRAG"@en ;
    dcterms:source scp:ref_22 ;
    scp:builtOn scp:KnowledgeGraphs ;
    scp:codeLang "python" ;
    scp:codeSnippet """# retrieve a grounded subgraph, then constrain generation to it
subgraph = kg.query(\"\"\"
  SELECT ?brand WHERE { ?b :inCategory :Home_Living ; :brand ?brand }
\"\"\")
answer = llm.generate(question, context=subgraph)  # cannot invent a brand""" ;
    scp:crossTech "[{\"tech\": \"GraphRAG (graph-grounded)\", \"lang\": \"python\", \"code\": \"sub = kg.query(\\\"SELECT ?b WHERE { ?x :inCat :Home ; :brand ?b }\\\")\\nans = llm.generate(q, context=sub)\", \"impact\": \"Answer is constrained to retrieved facts \\u2014 cannot invent a brand. Precise, auditable, traceable to triples.\"}, {\"tech\": \"Plain LLM (no retrieval)\", \"lang\": \"python\", \"code\": \"ans = llm.generate(q)   # parameters only\", \"impact\": \"Fluent but ungrounded \\u2014 may confidently state a brand the catalogue does not carry. No traceability.\"}, {\"tech\": \"Vector RAG (text chunks)\", \"lang\": \"python\", \"code\": \"chunks = vstore.search(embed(q), k=5)\\nans = llm.generate(q, context=chunks)\", \"impact\": \"Grounds in *passages* of text, not structured facts. Better than nothing, but answers can blur across documents and miss exact relationships.\"}, {\"tech\": \"SPARQL only\", \"lang\": \"sparql\", \"code\": \"SELECT ?brand WHERE { ?x :inCategory :Home ; :brand ?brand }\", \"impact\": \"Exact facts, fully traceable \\u2014 but returns a table, not a natural-language answer. GraphRAG marries the two.\"}]" ;
    scp:extendedTreatment "GraphRAG — retrieval-augmented generation over a graph — is the layer where the semantic web and generative AI meet. Instead of letting a language model answer from its parameters alone, the system first retrieves a relevant subgraph of verified facts and then constrains the model to generate only from those facts. This matters because it converts an unreliable model into a governable one: the answer is correct by construction, because the model cannot assert anything the retrieved graph does not contain. For any enterprise exposing a model over real data — a catalogue, a patient record, a compliance ledger — this grounding is less a feature than a precondition for trust, which is why it has become the dominant pattern for production question-answering over knowledge graphs."@en ;
    scp:hasVisual "ragflow" ;
    scp:icon "🤖" ;
    scp:industryLabel "Microsoft GraphRAG" ;
    scp:industryLink "https://github.com/microsoft/graphrag" ;
    scp:industryNote "The open-source reference implementation of graph-grounded generation."@en ;
    scp:relatedConcept scp:Embeddings,
        scp:KGSurvey,
        scp:LLMKG ;
    scp:resourceLabel "GraphRAG (Edge et al., 2024)" ;
    scp:resourceLink "https://arxiv.org/abs/2404.16130" ;
    scp:techCompare "[[\"Plain LLM (no retrieval)\", \"Answers from parameters alone \\u2014 fluent but may hallucinate a brand the catalogue lacks.\"], [\"Vector RAG (text chunks)\", \"Retrieves similar *text passages*; GraphRAG retrieves *structured facts*, so answers are precise and traceable to triples.\"], [\"SPARQL query\", \"Returns exact facts but no natural-language answer; GraphRAG combines the two.\"]]" ;
    scp:techCompareRich "{\"scenario\": \"Goal: answer a question using a company\\u2019s data, with traceable, grounded facts.\", \"techs\": [{\"tech\": \"Plain LLM\", \"color\": \"#a4502f\", \"repr_kind\": \"code\", \"lang\": \"python\", \"code\": \"answer = llm.generate(question)\\n# from model parameters only \\u2014 no company data\", \"note\": \"Fluent but ungrounded: may hallucinate, cannot cite, and knows nothing private or post-training.\"}, {\"tech\": \"Vector RAG\", \"color\": \"#b5803a\", \"repr_kind\": \"code\", \"lang\": \"python\", \"code\": \"chunks = vstore.search(embed(question), k=5)\\nanswer = llm.generate(question, context=chunks)\", \"note\": \"Grounds on retrieved text chunks \\u2014 better, but chunks are isolated; multi-hop questions across related entities are hard to assemble.\"}, {\"tech\": \"GraphRAG\", \"color\": \"#9a5b6e\", \"recommended\": true, \"repr_kind\": \"code\", \"lang\": \"python\", \"code\": \"sub = kg.query(\\\"... :inCategory :Home ; :brand ?b\\\")\\nanswer = llm.generate(question, context=sub)\\n# grounded on a connected SUBGRAPH\", \"note\": \"Retrieves a connected subgraph, so the model reasons over linked entities and relationships \\u2014 better multi-hop accuracy and traceable, citable grounding.\"}], \"table_summary\": {\"cols\": [\"Capability\", \"Plain LLM\", \"Vector RAG\", \"GraphRAG\"], \"rows\": [[\"Uses private data\", \"no\", \"yes\", \"yes\"], [\"Multi-hop reasoning\", \"no\", \"weak\", \"yes\"], [\"Traceable/citable\", \"no\", \"partial\", \"yes\"], [\"Relationship-aware\", \"no\", \"no\", \"yes\"]]}}" ;
    rdfs:subClassOf scp:KnowledgeGraphs ;
    skos:definition "Retrieval-augmented generation over graphs."@en ;
    skos:scopeNote "Grounded in Edge et al. / Microsoft (2024)"@en .

<http://rdodi.org/scp/domain> a owl:Ontology ;
    dcterms:creator "RDODI pipeline" ;
    dcterms:description "Domain ontology of semantic-technology concepts, areas, and the W3C stack."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "SCP semantic-technologies domain ontology"@en ;
    rdfs:comment "PUBLIC EDITION v4.0.0 (MAJOR over 3.17.0): the running retail case, previously grounded in a named real company with REAL-CITED source links, is converted to a fictional apparel retailer with all such items re-tagged ILLUSTRATIVE per this content's own provenance-legend rules -- no real company's operational data or URLs remain; one taxonomy individual renamed to tax_apparel and its real category codes removed. Also fixes the inherited BP-D7 misalignment (versionInfo 3.17.0 vs versionIRI 3.16.1 in the governed file)."@en ;
    owl:priorVersion <http://rdodi.org/scp/domain/3.17.0> ;
    owl:versionIRI <http://rdodi.org/scp/domain/public/4.0.0> ;
    owl:versionInfo "4.0.0" ;
    dcterms:modified "2026-08-03" .

scp:OWL a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "OWL 2 — ontology language"@en ;
    dcterms:source scp:ref_08 ;
    scp:addsExpressivity scp:RDFS ;
    scp:axiomReference "{\"title\": \"OWL relation & axiom types \\u2014 a quick reference\", \"note\": \"The vocabulary OWL gives you to state meaning. \\\"Derives\\\" = a reasoner adds new facts; \\\"Checks\\\" = a reasoner can flag a contradiction.\", \"groups\": [{\"group\": \"Property direction & structure\", \"items\": [[\"owl:inverseOf\", \"two properties are the reverse of each other\", \"derives\", \"parentOf \\u21d4 childOf\"], [\"owl:SymmetricProperty\", \"if A\\u2192B then B\\u2192A (same property)\", \"derives\", \"marriedTo, sibling\"], [\"owl:AsymmetricProperty\", \"if A\\u2192B then NOT B\\u2192A\", \"checks\", \"partOf, hasParent\"], [\"owl:TransitiveProperty\", \"if A\\u2192B and B\\u2192C then A\\u2192C\", \"derives\", \"partOf, ancestorOf\"], [\"owl:ReflexiveProperty\", \"everything relates to itself\", \"derives\", \"sameRegionAs\"], [\"owl:IrreflexiveProperty\", \"nothing relates to itself\", \"checks\", \"parentOf\"], [\"owl:FunctionalProperty\", \"at most one value per subject\", \"checks\", \"hasBirthDate\"], [\"owl:InverseFunctionalProperty\", \"the value uniquely identifies the subject\", \"checks\", \"hasEmail, hasISBN\"]]}, {\"group\": \"Class relationships\", \"items\": [[\"rdfs:subClassOf\", \"one class is a kind of another\", \"derives\", \"TShirt \\u2291 Clothing\"], [\"owl:equivalentClass\", \"two classes have exactly the same members\", \"derives\", \"Human \\u2261 Person\"], [\"owl:disjointWith\", \"no individual can belong to both classes\", \"checks\", \"InStock vs SoldOut\"], [\"owl:complementOf\", \"everything NOT in the other class\", \"derives/checks\", \"NonEmployee\"], [\"owl:unionOf\", \"members of any of the listed classes\", \"derives\", \"Vehicle = Car \\u222a Truck\"], [\"owl:intersectionOf\", \"members of all the listed classes\", \"derives\", \"WorkingMother\"]]}, {\"group\": \"Individuals\", \"items\": [[\"owl:sameAs\", \"two names refer to the same individual\", \"derives\", \"dbr:\\u0130stanbul = wd:Q406\"], [\"owl:differentFrom\", \"two names are definitely distinct individuals\", \"checks\", \"Store_A \\u2260 Store_B\"]]}, {\"group\": \"Property restrictions (on a class)\", \"items\": [[\"owl:someValuesFrom\", \"must have at least one value of a type\", \"checks/derives\", \"Pizza hasTopping some Cheese\"], [\"owl:allValuesFrom\", \"all values must be of a type\", \"checks\", \"VegPizza allTopping Veg\"], [\"owl:hasValue\", \"must have one specific value\", \"checks\", \"ActiveProduct brand\\u00b7status = active\"], [\"owl:cardinality / min / max\", \"exactly / at least / at most N values\", \"checks\", \"hasParent max 2\"]]}]}" ;
    scp:builtOn scp:RDFS ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix owl: <http://www.w3.org/2002/07/owl#> .

:soldInStore      owl:inverseOf    :stocks .
:PrescriptionDrug owl:disjointWith :OverTheCounterDrug .
# reasoner derives inverses and flags disjoint-class contradictions""" ;
    scp:crossTech "[{\"tech\": \"OWL (reasoning)\", \"lang\": \"turtle\", \"code\": \":soldInStore owl:inverseOf :stocks .\\n:PrescriptionDrug owl:disjointWith :OTC .\", \"impact\": \"A reasoner DERIVES new facts (inverses, transitivity) and DETECTS contradictions \\u2014 logic, not just storage.\"}, {\"tech\": \"Relational constraints\", \"lang\": \"sql\", \"code\": \"-- SQL can FORBID a bad value with a constraint...\\nALTER TABLE drugs ADD CONSTRAINT chk_type\\n  CHECK (type IN ('prescription','otc'));\\n-- ...but it cannot DERIVE the inverse edge or classify across a hierarchy\", \"impact\": \"Can forbid a bad value, but cannot infer the inverse edge or classify across a hierarchy. No open-world inference.\"}, {\"tech\": \"Property graph\", \"lang\": \"cypher\", \"code\": \"// you must WRITE the inverse edge yourself; it is not derived\\nMATCH (a)-[:SOLD_IN_STORE]->(b)\\nMERGE (b)-[:STOCKS]->(a)\\n// and there is no built-in disjointness check\", \"impact\": \"You must WRITE the inverse edge yourself; it will not be derived. No built-in disjointness or subsumption reasoning.\"}, {\"tech\": \"SHACL (validation)\", \"lang\": \"turtle\", \"code\": \":DrugShape sh:not [ sh:class :OTC ] .\", \"impact\": \"Checks data CONFORMS (closed-world) rather than inferring what follows (open-world) \\u2014 the complement of OWL.\"}]" ;
    scp:execResult "{\"cols\": [\"fact\", \"origin\"], \"rows\": [[\"Store stocks Item\", \"inferred\"], [\"contradiction on Drug_X\", \"flagged\"]]}" ;
    scp:execSteps "[\"Read asserted axioms\", \"soldInStore inverseOf stocks\", \"Assert: Item soldInStore Store\", \"Reasoner infers: Store stocks Item\", \"PrescriptionDrug disjointWith OTC \\u2192 flag any node typed both\"]" ;
    scp:extendedTreatment "The Web Ontology Language is where the stack gains the ability to reason rather than merely store. Building on RDF Schema, it adds description-logic constructs — inverse and transitive properties, cardinality and value restrictions, class disjointness — that let a reasoner derive facts no one asserted and detect contradictions no one noticed. This matters operationally because it converts business rules into enforced logic: a rule that a discontinued item cannot appear in an active promotion, declared once, is checked by the reasoner across every product automatically. Because full expressivity is computationally expensive, OWL 2 defines tractable profiles (EL, QL, RL) each tuned to a workload, so choosing a profile is a deliberate engineering decision about how much reasoning a live system can afford."@en ;
    scp:icon "🦉" ;
    scp:industryLabel "SNOMED CT" ;
    scp:industryLink "https://www.snomed.org/" ;
    scp:industryNote "The world’s most widely used clinical terminology, built on description-logic foundations."@en ;
    scp:inferenceContrast "{\"title\": \"Two axioms, two kinds of reasoning: derive a fact vs. catch a contradiction\", \"lead\": \"owl:inverseOf and owl:disjointWith look similar but do opposite jobs. One DERIVES a new true fact; the other DETECTS an impossible one. Run both to see the difference.\", \"cards\": [{\"op\": \"owl:inverseOf\", \"role\": \"Derivation \\u2014 produces a new fact\", \"color\": \"#3f7a4d\", \"lang\": \"turtle\", \"code\": \"@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n:soldInStore owl:inverseOf :stocks .\\nex:tshirt_A :soldInstore ex:store_1 .\\n# same link, other direction\", \"steps\": [\"Read owl:inverseOf axiom\", \"Assert ex:tshirt_A soldInstore ex:store_1\", \"Apply the inverse (reverse the direction)\", \"Add the reverse edge as a NEW fact\", \"Both directions now hold\"], \"result\": {\"cols\": [\"fact\", \"origin\"], \"rows\": [[\"ex:tshirt_A soldInstore ex:store_1\", \"asserted\"], [\"ex:store_1 stocks ex:tshirt_A\", \"inferred \\u2713 (new fact)\"]]}, \"reads\": \"\\\"soldInStore is the reverse direction of stocks.\\\" Assert one, the reasoner gives you the other. Nothing is forbidden \\u2014 both are true at once.\"}, {\"op\": \"owl:disjointWith\", \"role\": \"Contradiction \\u2014 flags an impossibility\", \"color\": \"#a4502f\", \"lang\": \"turtle\", \"code\": \"@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n:InStock owl:disjointWith :SoldOut .\\nex:tshirt_A a :InStock , :SoldOut .\\n# claims membership in two disjoint classes\", \"steps\": [\"Read owl:disjointWith axiom\", \"See ex:tshirt_A typed as BOTH InStock and SoldOut\", \"Check the disjointness constraint\", \"Membership in both is impossible\", \"Flag the ontology as INCONSISTENT\"], \"result\": {\"cols\": [\"check\", \"outcome\"], \"rows\": [[\"ex:tshirt_A \\u2208 InStock\", \"ok alone\"], [\"ex:tshirt_A \\u2208 SoldOut\", \"ok alone\"], [\"both at once\", \"\\u2717 contradiction (inconsistent)\"]]}, \"reads\": \"\\\"Nothing can be both InStock and SoldOut.\\\" Assert both and the reasoner raises an error. This catches bad data instead of producing new data.\"}], \"summary\": \"So the two axioms catch two different things: owl:inverseOf catches a MISSING fact (and fills it in); owl:disjointWith catches a WRONG fact (and rejects it). Derivation grows your knowledge; disjointness guards its integrity.\"}" ;
    scp:relatedConcept scp:DLReasoning,
        scp:RDFS,
        scp:SHACL ;
    scp:resourceLabel "W3C OWL 2" ;
    scp:resourceLink "https://www.w3.org/TR/owl2-overview/" ;
    scp:techCompare "[[\"Relational constraints\", \"A CHECK constraint can forbid a bad value, but cannot INFER new facts (inverses, transitivity) the way an OWL reasoner does.\"], [\"Property graph\", \"Stores the inverse edge if you write it; it will not derive it. No built-in disjointness or subsumption reasoning.\"], [\"SHACL\", \"Validates that data conforms (closed-world) \\u2014 the complement of OWL, which infers what follows (open-world).\"]]" ;
    scp:techCompareRich "{\"scenario\": \"Goal: (a) derive the reverse of a relationship automatically, and (b) catch a record that violates a rule.\", \"techs\": [{\"tech\": \"Relational constraints\", \"color\": \"#4a7c8c\", \"repr_kind\": \"code\", \"lang\": \"sql\", \"code\": \"-- can FORBID a bad value\\nALTER TABLE drugs ADD CONSTRAINT chk_type\\n  CHECK (type IN ('prescription','otc'));\\n-- but cannot DERIVE an inverse edge or classify up a hierarchy\", \"note\": \"Constraints can reject bad data, but a relational engine never infers new facts; it has no notion of inverse or transitive relationships.\"}, {\"tech\": \"Property graph\", \"color\": \"#5b8a72\", \"repr_kind\": \"code\", \"lang\": \"cypher\", \"code\": \"// you must WRITE the inverse edge yourself\\nMATCH (a)-[:SOLD_IN_STORE]->(b)\\nMERGE (b)-[:STOCKS]->(a)\\n// no built-in disjointness either\", \"note\": \"You can script the inverse, but it is manual and not guaranteed; there is no formal semantics that a reasoner enforces.\"}, {\"tech\": \"OWL (reasoning)\", \"color\": \"#9a5b6e\", \"recommended\": true, \"repr_kind\": \"code\", \"lang\": \"turtle\", \"code\": \":soldInStore owl:inverseOf :stocks .          # DERIVES the reverse\\n:PrescriptionDrug owl:disjointWith :OTC .     # DETECTS a contradiction\", \"note\": \"A reasoner derives new facts (inverses, transitivity, class membership) AND detects contradictions \\u2014 declarative semantics no relational/graph engine provides natively.\"}], \"table_summary\": {\"cols\": [\"Capability\", \"Relational\", \"Property graph\", \"OWL\"], \"rows\": [[\"Forbid bad value\", \"yes (CHECK)\", \"partial\", \"yes\"], [\"Derive inverse/transitive\", \"no\", \"manual\", \"yes (automatic)\"], [\"Detect logical contradiction\", \"no\", \"no\", \"yes\"], [\"Classify up a hierarchy\", \"no\", \"no\", \"yes\"]]}}" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Description-logic constructs; profiles EL/QL/RL; OWL DL vs OWL Full."@en ;
    skos:scopeNote "Grounded in W3C / McGuinness & van Harmelen (2004); OWL2 (2012)"@en .

scp:RDFS a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "RDFS — schema"@en ;
    dcterms:source scp:ref_13 ;
    scp:addsExpressivity scp:RDF ;
    scp:builtOn scp:RDF ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:TShirt   rdfs:subClassOf :Clothing .
:Clothing rdfs:subClassOf :Product .
# a query for :Product now also returns :TShirt instances""" ;
    scp:execResult "{\"cols\": [\"?x\", \"via\"], \"rows\": [[\"ex:jacket_A\", \"direct\"], [\"ex:tshirt_A\", \"subclass\"], [\"ex:tshirt_B\", \"subclass\"]]}" ;
    scp:execSteps "[\"Assert T-Shirt \\u2291 Clothing\", \"Assert Clothing \\u2291 Product\", \"Query: all :Product\", \"Reasoner adds subclass members\", \"Return Clothing + T-Shirt instances\"]" ;
    scp:extendedTreatment "RDF Schema is the first layer that adds meaning to raw triples. Where RDF says only that resources are related, RDFS says what kinds of things they are: it introduces classes, the subclass and subproperty hierarchies, and the domain and range of properties. This matters because a single subclass statement replaces an indefinite amount of manual bookkeeping — declaring that a t-shirt is a kind of clothing means every query, report, and rule written for clothing applies to t-shirts automatically, with no list to maintain. RDFS deliberately stays lightweight and decidable, trading the richer inference of OWL for simplicity and speed, which is why it remains the workhorse layer for everyday vocabularies."@en ;
    scp:hasVisual "subclass" ;
    scp:icon "🗂️" ;
    scp:industryLabel "FOAF vocabulary" ;
    scp:industryLink "http://xmlns.com/foaf/spec/" ;
    scp:industryNote "The classic RDFS vocabulary for describing people and their relationships."@en ;
    scp:relatedConcept scp:OWL,
        scp:RDF ;
    scp:resourceLabel "W3C RDF Schema" ;
    scp:resourceLink "https://www.w3.org/TR/rdf-schema/" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Classes, subclass/subproperty hierarchies, property domain and range."@en ;
    skos:scopeNote "Grounded in W3C (2014)"@en .

scp:W3CStack a owl:Class ;
    rdfs:label "The W3C Semantic-Web Stack"@en ;
    scp:extendedTreatment "The semantic web is realized not by one language but by a stack of W3C Recommendations, each layer building on those below — the layer cake Berners-Lee illustrated. A faithful account covers the whole stack, from identity through validation, not merely RDF and OWL. The layers are interoperable and individually standardized."@en ;
    scp:modelKind "stack_model" ;
    rdfs:subClassOf scp:SemanticTechnologyArea ;
    skos:definition "The layer cake of W3C standards, each layer building on those below."@en .

scp:KnowledgeGraphs a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "Knowledge Graphs & the Modern Synthesis"@en ;
    scp:extendedTreatment "Knowledge graphs are the modern incarnation of the semantic-web idea, now joined to large language models through GraphRAG. The definitive survey frames the landscape; the industrial origin and query-theory foundations ground it; and the LLM synthesis points to where the field is heading. The trajectory is unmistakable: from the symbolic, deductive substrate of the early semantic web, through the industrial knowledge graphs of the 2010s, to the current synthesis in which graphs and language models each compensate for the other's weakness — the graph supplying grounded fact, the model supplying fluent language and inductive reach."@en ;
    scp:groundsRetrievalFor scp:GraphRAG ;
    scp:modelKind "graph_model" ;
    scp:techCompare "[[\"Relational warehouse\", \"Stars/snowflakes of fact tables \\u2014 great for aggregates, weaker at linking heterogeneous entities the way a KG does.\"], [\"Property graph\", \"An operational KG without RDF\\u2019s IRIs/semantics \\u2014 excellent for traversal, weaker for cross-org integration.\"], [\"Document store\", \"Stores entities as JSON docs; relationships are implicit, not first-class queryable edges.\"]]" ;
    scp:techCompareRich "{\"scenario\": \"Goal: store entities (products, brands, stores) and the relationships between them, and traverse them.\", \"techs\": [{\"tech\": \"Relational tables\", \"color\": \"#4a7c8c\", \"repr_kind\": \"code\", \"lang\": \"sql\", \"code\": \"products(id, name, brand_id)\\nbrands(id, name)\\nstores(id, name)\\nstock(product_id, store_id)   -- join tables for each relationship\", \"note\": \"Relationships are foreign keys + join tables. Each new relationship type means schema changes, and deep traversals need many JOINs.\"}, {\"tech\": \"Document store\", \"color\": \"#b5803a\", \"repr_kind\": \"code\", \"lang\": \"json\", \"code\": \"{ \\\"product\\\":\\\"tshirt_A\\\",\\n  \\\"brand\\\":\\\"ExBrand\\\",\\n  \\\"soldIn\\\":[\\\"store_1\\\",\\\"store_2\\\"] }\", \"note\": \"Relationships are embedded strings/arrays inside a document \\u2014 fast to read one record, but cross-document links are not first-class queryable edges.\"}, {\"tech\": \"Knowledge graph (RDF)\", \"color\": \"#9a5b6e\", \"recommended\": true, \"repr_kind\": \"code\", \"lang\": \"turtle\", \"code\": \"ex:tshirt_A :brand ex:ExBrand ; :soldIn ex:store_1 .\\nex:store_1 :inCity ex:Istanbul .\\n# every edge is first-class & globally addressable\", \"note\": \"Entities and relationships are both first-class. Edges are queryable and traversable, new relationship types need no schema change, and IRIs link across datasets.\"}], \"table_summary\": {\"cols\": [\"Capability\", \"Relational\", \"Document\", \"Knowledge graph\"], \"rows\": [[\"Relationships first-class\", \"via joins\", \"embedded\", \"yes (edges)\"], [\"Add relationship type\", \"schema change\", \"reshape docs\", \"no change\"], [\"Deep traversal\", \"many JOINs\", \"manual\", \"native\"], [\"Link across datasets\", \"no\", \"no\", \"yes (IRIs)\"]]}}" ;
    rdfs:subClassOf scp:SemanticTechnologyArea ;
    skos:definition "Graphs joining structured knowledge to language models."@en .

scp:RDF a scp:SemanticTechnology,
        owl:Class ;
    rdfs:label "RDF — data model"@en ;
    dcterms:source scp:ref_13 ;
    scp:codeLang "turtle" ;
    scp:codeSnippet """@prefix schema: <http://schema.org/> .
@prefix : <http://ex.org/retail#> .

ex:tshirt_A a schema:Product ;
    schema:category  ex:tshirt_cat ;
    schema:brand     "ExBrand" ;
    schema:offers    [ a schema:Offer ; schema:price "199.99" ] .""" ;
    scp:crossTech "[{\"tech\": \"Semantic Web (RDF/Turtle)\", \"lang\": \"turtle\", \"code\": \"@prefix schema: <http://schema.org/> .\\nex:tshirt_A a schema:Product ;\\n  schema:name     \\\"Cotton T-Shirt\\\" ;\\n  schema:category ex:tshirt_cat ;\\n  schema:brand    \\\"ExBrand\\\" .\", \"impact\": \"Schema-free graph: a new system\\u2019s data merges by shared IRIs with no up-front schema agreement. Native home for reasoning and linked data.\"}, {\"tech\": \"Relational (SQL)\", \"lang\": \"sql\", \"code\": \"INSERT INTO products(id, name, category_id, brand)\\nVALUES ('tshirt_A', 'Cotton T-Shirt', 'tshirt_cat', 'ExBrand');\\n-- category lives in a categories table, joined by category_id\", \"impact\": \"Mature, transactional, fast on a fixed schema. But integrating a second system means reconciling two table designs first.\"}, {\"tech\": \"Property graph (Cypher)\", \"lang\": \"cypher\", \"code\": \"CREATE (p:Product {id:'tshirt_A', name:'Cotton T-Shirt', brand:'ExBrand'})\\nCREATE (c:Category {id:'tshirt_cat', name:'Women T-Shirt'})\\nCREATE (p)-[:IN_CATEGORY]->(c)\", \"impact\": \"Developer-friendly, fast traversal. Properties are local key-values \\u2014 no global IRIs or formal semantics, so cross-org integration is harder.\"}, {\"tech\": \"Document store (JSON)\", \"lang\": \"json\", \"code\": \"{\\n  \\\"id\\\": \\\"tshirt_A\\\",\\n  \\\"name\\\": \\\"Cotton T-Shirt\\\",\\n  \\\"category\\\": \\\"tshirt_cat\\\",\\n  \\\"brand\\\": \\\"ExBrand\\\"\\n}\", \"impact\": \"Simple and flexible per-record. Relationships are implicit strings, not first-class queryable edges \\u2014 joins and integration are manual.\"}]" ;
    scp:execResult "{\"cols\": [\"subject\", \"predicate\", \"object\"], \"rows\": [[\"ex:tshirt_A\", \"category\", \"ex:tshirt_cat\"], [\"ex:tshirt_A\", \"brand\", \"ExBrand\"], [\"ex:tshirt_A\", \"price\", \"199.99\"]]}" ;
    scp:execSteps "[\"Parse the Turtle\", \"Create node ex:tshirt_A\", \"Add edge schema:category \\u2192 ex:tshirt_cat\", \"Add edge schema:brand \\u2192 \\\"ExBrand\\\"\", \"Add edge schema:offers \\u2192 [price 199.99]\"]" ;
    scp:extendedTreatment "The Resource Description Framework is the foundation on which every other layer rests. Its single idea is that all information can be expressed as triples — a subject, a predicate, and an object — which compose into a directed, labelled graph. This matters because it dissolves the integration problem that defeats relational schemas: when every entity is simply a node and every fact an edge, data designed by different teams, at different times, for different purposes can be merged without first negotiating a common table structure. In practice this is why an enterprise integrating a catalogue, an inventory system, and a supplier feed reaches for RDF rather than a master relational schema — the graph absorbs heterogeneity that a fixed schema would reject."@en ;
    scp:hasVisual "triple" ;
    scp:icon "🔗" ;
    scp:industryLabel "schema.org" ;
    scp:industryLink "https://schema.org/Product" ;
    scp:industryNote "Used by millions of e-commerce sites for product markup that search engines read."@en ;
    scp:modelComparison "{\"title\": \"Categorization across modelling paradigms \\u2014 how a product, its category, and the taxonomy are represented\", \"intro\": \"One scenario: a cotton T-shirt belongs to a category (Women\\u2019s T-Shirt), which sits inside a taxonomy (Women\\u2019s T-Shirt \\u2192 Clothing \\u2192 root). Each modelling paradigm encodes the product, the category, and the hierarchy differently. The conventional models (ERD, UML class, UML object) treat the category hierarchy as ordinary data you must traverse yourself; the semantic model makes the taxonomy first-class and machine-traversable. In the semantic model the hierarchy is shown two ways: rdfs:subClassOf (class/type IS-A) and skos:broader (concept/thesaurus broader-than).\", \"lenses\": [{\"key\": \"erd\", \"title\": \"Relational model \\u2014 ERD\", \"color\": \"#4a7c8c\", \"note\": \"Two tables. PRODUCT.category_id is a foreign key into CATEGORY; the hierarchy is a self-referencing CATEGORY.parent_id. Walking the taxonomy needs a recursive query (CTE).\", \"code\": \"PRODUCT(id, name, category_id \\u2192 CATEGORY.id)\\nCATEGORY(id, name, parent_id \\u2192 CATEGORY.id)\", \"diagram\": \"erd\"}, {\"key\": \"class\", \"title\": \"Object-oriented \\u2014 UML class diagram\", \"color\": \"#5b8a72\", \"note\": \"Types and associations. Product holds a reference to Category; Category holds a reference to its parent Category. Inheritance models kinds-of-types, not the instance hierarchy of categories.\", \"code\": \"class Product   { String name; Category category; }\\nclass Category  { String name; Category parent; }\", \"diagram\": \"class\"}, {\"key\": \"object\", \"title\": \"Object-oriented \\u2014 category hierarchy (object/instance view)\", \"color\": \"#b5803a\", \"note\": \"At run time the category hierarchy is a tree of Category objects, with Product objects as leaves under their category \\u2014 the same shape as a directory tree. The structure exists only as object references the application follows in code.\", \"code\": \"Root : Category\\n \\u2514 Clothing : Category\\n    \\u251c Women\\u2019s T-Shirt : Category\\n    \\u2502   \\u251c tshirt_A : Product\\n    \\u2502   \\u2514 tshirt_B : Product\\n    \\u2514 Men\\u2019s Shirt : Category\\n        \\u2514 shirt_C : Product\", \"diagram\": \"object\"}, {\"key\": \"semantic\", \"title\": \"Semantic Web model \\u2014 RDF / RDFS / SKOS\", \"color\": \"#9a5b6e\", \"note\": \"The taxonomy is first-class graph data. Two individuals (tshirt_A, tshirt_B) are instances of the same class :TShirt via rdf:type; the class hierarchy uses rdfs:subClassOf and the category taxonomy uses skos:broader. All are explicit, navigable, and reusable across datasets via shared IRIs.\", \"code\": \"# class/type hierarchy \\u2014 rdfs:subClassOf\\n:TShirt   rdfs:subClassOf :Clothing .\\n:Clothing rdfs:subClassOf :Product .\\nex:tshirt_A a :TShirt .          # so also a Clothing, a Product\\n\\n# concept (thesaurus) hierarchy \\u2014 skos:broader\\nex:tshirt_cat a skos:Concept ; skos:broader ex:clothing_cat .\\nex:clothing_cat a skos:Concept ; skos:broader ex:root_cat .\", \"diagram\": \"semantic\"}], \"table\": {\"cols\": [\"Aspect\", \"Relational (ERD)\", \"OO (class/object)\", \"Semantic (RDF/SKOS)\"], \"rows\": [[\"Product\", \"a row in PRODUCT\", \"a Product object\", \"an IRI typed :TShirt\"], [\"Category\", \"a row in CATEGORY\", \"a Category object\", \"an IRI, a skos:Concept\"], [\"Hierarchy\", \"self-join parent_id\", \"parent object reference\", \"skos:broader / subClassOf (explicit)\"], [\"Traverse ancestors\", \"recursive CTE\", \"loop in code\", \"reasoner / property path\"], [\"Reuse across systems\", \"re-map schemas\", \"re-map classes\", \"shared IRIs \\u2014 no re-modelling\"]]}, \"takeaway\": \"Same categorization, four lenses. The conventional models can represent the hierarchy, but it is inert data the application must interpret and traverse. In the semantic model the taxonomy is part of the meaning, so the same category IRIs and broader-links are understood and reused by any system \\u2014 which is what makes cross-domain integration and reasoning possible.\", \"strictNotation\": true}" ;
    scp:relatedConcept scp:IRI,
        scp:RDFS,
        scp:Serialization ;
    scp:resourceLabel "W3C RDF 1.1" ;
    scp:resourceLink "https://www.w3.org/TR/rdf11-concepts/" ;
    scp:techCompare "[[\"Relational/SQL\", \"A row in a PRODUCTS table; relations become foreign-key JOINs. Rigid schema, fast, but merging a second system needs schema reconciliation.\"], [\"Property graph (Cypher)\", \"(:Product {id:tshirt_A})-[:IN_CATEGORY]->(:Category). Similar graph shape, but properties are local key-values with no global IRIs or formal semantics.\"], [\"Semantic database (triplestore)\", \"The same triples, stored and queried with SPARQL + inference \\u2014 RDF\\u2019s native home, adding reasoning a relational DB lacks.\"]]" ;
    rdfs:subClassOf scp:W3CStack ;
    skos:definition "Subject-predicate-object triples composing a directed labelled graph."@en ;
    skos:scopeNote "Grounded in W3C (2014)"@en .

scp:Publication a owl:Class ;
    rdfs:label "Publication"@en ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "A cited bibliographic resource (paper, specification, or report) referenced by the ontology as a source."@en .

scp:SemanticTechnology a owl:Class ;
    rdfs:label "Semantic technology" ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    rdfs:comment "Any concept that is a semantic technology, layer, model or technique in this domain." ;
    skos:definition "A technology for representing, exchanging, and reasoning over machine-interpretable meaning (e.g. RDF, OWL, knowledge graphs)."@en .

scp:ExampleCase a owl:Class ;
    dcterms:conformsTo <http://rdodi.org/scp/domain> ;
    skos:definition "A worked illustrative instance demonstrating a concept in use."@en .

