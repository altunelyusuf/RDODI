scp:quizBank a owl:AnnotationProperty ;
    scp:quizBank "[{\"sec\": \"Foundations\", \"type\": \"concept\", \"q\": \"What is the core unit of meaning in RDF — the smallest statement you can make?\", \"opts\": [\"A table row\", \"A triple: subject–predicate–object\", \"A JSON object\", \"A class definition\"], \"correct\": 1, \"explain\": \"RDF represents every fact as a triple linking a subject to an object via a predicate.\"}, {\"sec\": \"Foundations\", \"type\": \"deduce\", \"q\": \"Given the triple below, what plays the role of the predicate?\", \"code\": \"ex:tshirt_A  ex:inCategory  ex:womenTshirt_cat .\", \"opts\": [\"ex:tshirt_A\", \"ex:inCategory\", \"ex:womenTshirt_cat\", \"ex:\"], \"correct\": 1, \"explain\": \"The middle term (ex:inCategory) is the predicate — the relationship between subject and object.\"}, {\"sec\": \"Foundations\", \"type\": \"concept\", \"q\": \"In the TBox/ABox split, where does the statement “ex:tshirt_A is a T-Shirt” belong?\", \"opts\": [\"TBox (the schema)\", \"ABox (the instance data)\", \"Neither\", \"Both equally\"], \"correct\": 1, \"explain\": \"A statement about a specific individual is ABox; class/relationship definitions are TBox.\"}, {\"sec\": \"RDF & data models\", \"type\": \"deduce\", \"q\": \"In the relational model, how is a product–category hierarchy usually represented?\", \"opts\": [\"A self-referencing parent_id foreign key\", \"A SPARQL query\", \"An rdfs:subClassOf chain\", \"A vector embedding\"], \"correct\": 0, \"explain\": \"Relational hierarchies use a self-referencing foreign key (parent_id); reading ancestors needs a recursive CTE.\"}, {\"sec\": \"RDF & data models\", \"type\": \"concept\", \"q\": \"What makes the semantic (graph) model’s taxonomy different from the object/relational versions?\", \"opts\": [\"It cannot represent hierarchies\", \"The taxonomy is explicit, navigable graph data with global IRIs\", \"It only works for text\", \"It requires no schema at all\"], \"correct\": 1, \"explain\": \"In the semantic model the class hierarchy (rdfs:subClassOf) and category taxonomy (skos:broader) are first-class, navigable, and shareable via IRIs.\"}, {\"sec\": \"RDFS\", \"type\": \"deduce\", \"q\": \"Given the code, which types does a reasoner infer for ex:tshirt_A?\", \"code\": \":TShirt rdfs:subClassOf :Clothing .\\n:Clothing rdfs:subClassOf :Product .\\nex:tshirt_A a :TShirt .\", \"opts\": [\"Only :TShirt\", \"TShirt, Clothing, and Product\", \"Only :Product\", \"None — RDFS does not infer\"], \"correct\": 1, \"explain\": \"rdfs:subClassOf is transitive, so ex:tshirt_A is inferred to also be a :Clothing and a :Product.\"}, {\"sec\": \"OWL\", \"type\": \"deduce\", \"q\": \"With \\\":soldInStore owl:inverseOf :stocks\\\" and \\\"ex:tshirt_A :soldInStore ex:store_1\\\", what does the reasoner derive?\", \"code\": \"ex:soldInStore owl:inverseOf ex:stocks .\\nex:tshirt_A ex:soldInStore ex:store_1 .\", \"opts\": [\"ex:store_1 ex:stocks ex:tshirt_A\", \"ex:tshirt_A ex:stocks ex:store_1\", \"Nothing\", \"A validation error\"], \"correct\": 0, \"explain\": \"inverseOf derives the reverse edge: ex:store_1 ex:stocks ex:tshirt_A.\"}, {\"sec\": \"OWL\", \"type\": \"concept\", \"q\": \"What does owl:disjointWith let a reasoner do that relational CHECK constraints cannot?\", \"opts\": [\"Store more rows\", \"Detect a logical contradiction across the whole model\", \"Run faster joins\", \"Compress data\"], \"correct\": 1, \"explain\": \"disjointWith lets a reasoner detect that an individual typed as both disjoint classes is a contradiction — relational constraints only reject a single bad value.\"}, {\"sec\": \"SKOS\", \"type\": \"deduce\", \"q\": \"Given the SKOS concept, what does searching “tee” resolve to?\", \"code\": \"ex:tshirt_cat a skos:Concept ;\\n  skos:prefLabel \\\"T-Shirt\\\"@en ;\\n  skos:altLabel  \\\"tee\\\"@en .\", \"opts\": [\"Nothing\", \"ex:tshirt_cat\", \"A new concept\", \"An error\"], \"correct\": 1, \"explain\": \"“tee” is an altLabel of ex:tshirt_cat, so it resolves to that same concept.\"}, {\"sec\": \"SKOS\", \"type\": \"concept\", \"q\": \"Why is “Body” NOT a valid skos:altLabel for the T-Shirt concept (a point corrected on this page)?\", \"opts\": [\"It is a different language\", \"A “body”/bodysuit is a distinct garment, not a synonym — only co-categorized\", \"altLabel only allows one value\", \"It is misspelled\"], \"correct\": 1, \"explain\": \"altLabel must hold genuine synonyms of the SAME thing; Body is a sibling product type, so using it as a synonym was a factual error.\"}, {\"sec\": \"SPARQL\", \"type\": \"deduce\", \"q\": \"In the Wikidata query, \\\"wdt:P166 wd:Q38104\\\" filters for entities that…\", \"code\": \"?p wdt:P166 wd:Q38104 ; wdt:P21 wd:Q6581072 .\", \"opts\": [\"were born in physics\", \"received the Nobel Prize in Physics\", \"are male\", \"wrote about Q38104\"], \"correct\": 1, \"explain\": \"P166 = “award received”, Q38104 = “Nobel Prize in Physics”; combined with P21=Q6581072 (female) it finds female physics laureates.\"}, {\"sec\": \"SPARQL\", \"type\": \"concept\", \"q\": \"What can SPARQL do that a vector search fundamentally cannot, for this kind of query?\", \"opts\": [\"Rank by similarity\", \"Guarantee exact constraints (brand AND category)\", \"Run on GPUs\", \"Embed text\"], \"correct\": 1, \"explain\": \"Vector search ranks by similarity; SPARQL guarantees exact pattern constraints over the graph.\"}, {\"sec\": \"SHACL\", \"type\": \"concept\", \"q\": \"What is SHACL’s job in the semantic stack?\", \"opts\": [\"Generate embeddings\", \"Validate that data conforms to declared shapes/constraints\", \"Translate languages\", \"Compress graphs\"], \"correct\": 1, \"explain\": \"SHACL validates RDF data against shape constraints (e.g. “every product needs a brand”).\"}, {\"sec\": \"Layered architecture\", \"type\": \"deduce\", \"q\": \"In the three-tier architecture, which layer would ex:Supplier belong to?\", \"opts\": [\"Foundational/Upper\", \"Domain\", \"Application/Task\", \"None\"], \"correct\": 1, \"explain\": \"ex:Supplier is a concept of one field (supply chain) → the Domain layer, which anchors to bfo:Object in the foundational layer.\"}, {\"sec\": \"Layered architecture\", \"type\": \"concept\", \"q\": \"Why anchor domain terms (ex:Supplier) to a foundational ontology (bfo:Object)?\", \"opts\": [\"To save storage\", \"To let independently-built ontologies interoperate\", \"To make queries slower\", \"It is required by RDF\"], \"correct\": 1, \"explain\": \"A shared upper ontology is the interoperability backbone — separately-built ontologies that anchor to it can be aligned.\"}, {\"sec\": \"Knowledge graphs\", \"type\": \"concept\", \"q\": \"Compared with relational tables, how are relationships represented in a knowledge graph?\", \"opts\": [\"As join tables only\", \"As first-class, queryable, traversable edges\", \"As embedded JSON strings\", \"They cannot be represented\"], \"correct\": 1, \"explain\": \"In a knowledge graph, edges are first-class: queryable, traversable, and addable without schema changes.\"}, {\"sec\": \"GraphRAG\", \"type\": \"deduce\", \"q\": \"What does GraphRAG retrieve to ground an LLM answer, versus plain vector RAG?\", \"opts\": [\"Random text\", \"A connected subgraph of related entities\", \"A single document\", \"Nothing\"], \"correct\": 1, \"explain\": \"GraphRAG retrieves a connected subgraph, so the model reasons over linked entities — better multi-hop accuracy and traceability than isolated text chunks.\"}, {\"sec\": \"Provenance & rigor\", \"type\": \"concept\", \"q\": \"On this page, what does the provenance legend distinguish?\", \"opts\": [\"Fast vs slow data\", \"REAL·CITED vs PUBLIC-PATTERN vs ILLUSTRATIVE data\", \"Big vs small files\", \"Free vs paid sources\"], \"correct\": 1, \"explain\": \"Every datum is marked as real-and-cited, a public pattern, or clearly-illustrative — so readers know what is grounded.\"}, {\"sec\": \"Provenance & rigor\", \"type\": \"error\", \"q\": \"A demo shows a real company’s exact internal SKU and price with no source. Per the page’s discipline, this is…\", \"opts\": [\"Fine, it looks realistic\", \"A violation — unverified real-company specifics must be marked illustrative or cited\", \"Required\", \"Only a style issue\"], \"correct\": 1, \"explain\": \"Unverified real-company specifics are a fail-stop; use clearly-illustrative ex: data or cite a real source.\"}, {\"sec\": \"Taxonomies\", \"type\": \"concept\", \"q\": \"Which SKOS property builds the broader/narrower taxonomy hierarchy?\", \"opts\": [\"skos:prefLabel\", \"skos:broader / skos:narrower\", \"skos:altLabel\", \"rdf:type\"], \"correct\": 1, \"explain\": \"skos:broader and skos:narrower link concepts into the taxonomy hierarchy.\"}]" .

