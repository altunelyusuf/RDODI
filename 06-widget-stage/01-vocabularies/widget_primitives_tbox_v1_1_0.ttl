    rdfs:label "Widget Primitives Origination Release v1.0.0"@en ;
    prov:startedAtTime "2026-05-19T10:30:00"^^xsd:dateTime ;
    prov:endedAtTime "2026-05-19T11:00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith wp:Agent_YusufAltunel ;
    prov:used <http://example.org/widget-primitives/source-observation/com0463-ch7-v3-2-0> ;
    rdfs:comment "Origination release per BP-D13 (brand-new artefact type, no prior bundle). Derivation per BP-D14 from observation of COM0463 Ch.7 v3.2.0 widget patterns. Authored under BP-D2 (raw read of v3.2.0 HTML to extract real selectors), BP-D24 (license + provenance), BP-D27 (skeleton-shape discipline for partial SHACL), BP-D32 (each primitive carries demonstratesSubject + hasDomainConstraint + hasTestProcedure triple), BP-D33 (provenance-badge system codified as Primitive_ThreeTierProvenanceBadges)."@en .

