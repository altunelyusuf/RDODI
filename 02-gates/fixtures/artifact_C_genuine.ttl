@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://x#real_0> a <http://example.org/rdodi/interactive-page-ontology#Button>,
        owl:NamedIndividual ;
    rdfs:label "A real Button on the page"@en ;
    dcterms:source "Marchewka 2016 Ch.9 p.235" ;
    skos:definition "This Button lets the reader interact with the PQM content substantively, with at least one full sentence of grounded purpose."@en .

