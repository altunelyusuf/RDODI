@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doc: <http://example.org/rdodi/document-ontology#> .

# Negative fixture: the one structural individual makes an external claim
# with NO citation marker of either form -- the exact defect class this
# proposal's concrete instance found (Section: Industry Implementation).
<http://example.org/fixture/document#Claim1> a doc:ConceptSection, owl:NamedIndividual ;
    rdfs:label "Fixture claim, uncited"@en ;
    skos:definition "The effect held across all conditions tested."@en .
