rdodi-domain:AuthoredForDomainOntologyV1Instance a rdodi-domain:AuthoredForDomainOntologyV1,
        owl:NamedIndividual ;
    rdfs:label "Authored for Domain Ontology v1 (tier marker)"@en ;
    dcterms:source "Authored for Domain Ontology v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "Tier-marker individual for content net-new in this v1.0.0 release."@en .

