@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdodi-domain: <http://example.org/rdodi/domain-ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdodi-domain:Adaptability a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "adaptability"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The ontology accommodates extension to new requirements without breaking changes."@en .

rdodi-domain:Clarity a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "clarity"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "Each ontology element has a clear, unambiguous definition (skos:definition)."@en .

rdodi-domain:Completeness a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "completeness"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The ontology covers all CompetencyQuestionSet inputs."@en .

rdodi-domain:ComputationalEfficiency a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "computational efficiency"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "Reasoning queries terminate in acceptable time."@en .

rdodi-domain:Conformance a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "conformance"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The ontology conforms to SHACL shape constraints when validated with imports merged."@en .

rdodi-domain:Consistency a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "consistency"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The ontology is logically coherent under HermiT reasoning."@en .

rdodi-domain:DomainOntologyV1_AuthoringMethod a rdodi-domain:CompetencyQuestionDrivenMethod,
        owl:NamedIndividual ;
    rdfs:label "Domain Ontology v1 Authoring Method"@en ;
    rdodi-domain:hasSourceProvenance rdodi-domain:AuthoredForDomainOntologyV1Instance ;
    dcterms:source "Authored for Domain Ontology v1.0.0; documents the method applied to author this very subject."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The CompetencyQuestionDrivenMethod instance applied to author Domain Ontology v1.0.0 itself: competency questions about 'how to build a domain ontology from research material' drove concept selection."@en .

rdodi-domain:ReportSubjectInputInstance a rdodi-domain:ReportSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Report Subject Input (tier marker)"@en ;
    dcterms:source "Authored for Domain Ontology v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "Tier-marker individual for content that links to Report Ontology entities."@en .

rdodi-domain:ResearchSubjectInputInstance a rdodi-domain:ResearchSubjectInput,
        owl:NamedIndividual ;
    rdfs:label "Research Subject Input (tier marker)"@en ;
    dcterms:source "Authored for Domain Ontology v1.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "Tier-marker individual for content that consumes Research Ontology entities."@en .

rdodi-domain:Reusability a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "reusability"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> ;
    skos:definition "The ontology can be imported and aligned by downstream subjects without modification."@en .

rdodi-domain:Traceability a rdodi-domain:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "traceability"@en ;
    dcterms:source "ISO/IEC 25010:2023 Systems and software Quality Requirements (preserved from ontology_synthesis_v1_0_1.ttl basis)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/domain-ontology> .

