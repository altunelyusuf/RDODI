rdodi-document:ArtifactGenre a owl:Class ;
    rdfs:label "Artifact genre"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "Top-level genre classification of a report-generation artifact. Examples: research-report, literature-review, technical-report, chapter-commentary, handbook, FAQ, study-guide, course-document, conference-paper, journal-article, white-paper. Each genre carries voice, structure, and citation conventions that distinguish it from other genres."@en .

rdodi-document:CitationForm a owl:Class ;
    rdfs:label "Citation form"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "Specification of how cited sources appear in the artifact. Examples: Harvard in-text + alphabetical References list; numbered footnotes + bibliography; IEEE-style square-bracketed numbers. The citation form is one of the voice properties that distinguishes artifact kinds (academic research reports use Harvard or IEEE; technical reports often use numbered footnotes; handbooks and FAQs typically use parenthetical inline references)."@en .

rdodi-document:ConceptSection a owl:Class ;
    rdfs:label "Concept Section" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Section> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty rdodi-document:mappedToClass ],
        rdodi-document:ReportSection ;
    owl:disjointWith rdodi-document:AppendixSection,
        rdodi-document:RelationshipSection ;
    skos:definition "Section dedicated to detailed exploration of a single domain concept" ;
    skos:scopeNote "Maps to individual ontology class with comprehensive domain research" .

rdodi-document:ContentQualityCheck a owl:Class ;
    rdfs:label "Content Quality Check" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ContentGeneration ;
    skos:definition "Validation of generated content quality" ;
    skos:scopeNote "Ensures accuracy, coherence, and relevance" .

rdodi-document:ContentReduction a owl:Class ;
    rdfs:label "Content Reduction" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:FeedbackType ;
    skos:definition "Request to condense or remove content" ;
    skos:scopeNote "Summarize, remove redundancy, focus" .

rdodi-document:NarrativeContent a owl:Class ;
    rdfs:label "Narrative Content" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Paragraph> ;
    rdfs:subClassOf rdodi-document:ReportContent ;
    owl:disjointWith rdodi-document:StatisticalContent,
        rdodi-document:StructuredContent,
        rdodi-document:VisualContent ;
    skos:definition "Prose-based explanatory content in natural language" ;
    skos:scopeNote "Generated by LLM from researched domain knowledge" .

rdodi-document:QualityScorecardForm a owl:Class ;
    rdfs:label "Quality scorecard form"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "Specification of the visible-to-reader quality machinery inside the artifact. The quality scorecard form is the in-artifact quality disclosure consumed by the reader."@en .

rdodi-document:StructuralChange a owl:Class ;
    rdfs:label "Structural Change" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:FeedbackType ;
    skos:definition "Request to reorganize report structure" ;
    skos:scopeNote "Reorder sections, merge, split" .

rdodi-document:StructuredContent a owl:Class ;
    rdfs:label "Structured Content" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportContent ;
    owl:disjointWith rdodi-document:StatisticalContent,
        rdodi-document:VisualContent ;
    skos:definition "Formally organized content in tables, lists, or hierarchies" ;
    skos:scopeNote "Direct transformation from ontology structures" .

rdodi-document:hasSubsection a owl:ObjectProperty ;
    rdfs:label "has subsection" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:comment "Transitive property for hierarchical nesting" ;
    rdfs:domain rdodi-document:ReportSection ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:range rdodi-document:ReportSection ;
    skos:definition "Relates section to nested subsections" .

rdodi-document:mappedToClass a owl:ObjectProperty ;
    rdfs:label "mapped to class" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:comment "Section discusses domain concept represented by this class" ;
    rdfs:domain rdodi-document:ReportSection ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:range owl:Class ;
    skos:definition "Relates section to ontology class it represents" .

rdodi-document:ContentGeneration a owl:Class ;
    rdfs:label "Content Generation" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "Process of creating report content from research results" ;
    skos:scopeNote "Transforms research into readable, well-structured content" .

rdodi-document:VisualContent a owl:Class ;
    rdfs:label "Visual Content" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Figure> ;
    rdfs:subClassOf rdodi-document:ReportContent ;
    owl:disjointWith rdodi-document:StatisticalContent ;
    skos:definition "Graphical representations including charts, diagrams, and images" ;
    skos:scopeNote "Generated visualizations of ontology structures or domain data" .

rdodi-document:AppendixSection a owl:Class ;
    rdfs:label "Appendix Section" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Appendix> ;
    rdfs:subClassOf rdodi-document:ReportSection ;
    skos:definition "Supplementary section with references, glossary, or detailed data" ;
    skos:scopeNote "Supporting materials and metadata" .

rdodi-document:BloomLevel a owl:Class ;
    rdfs:label "Bloom level"@en ;
    dcterms:source "Report_Ontology_Requirements_v1_0_2 §3.1; Anderson & Krathwohl (2001) A Taxonomy for Learning, Teaching, and Assessing"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "A cognitive complexity level from Bloom's Revised Taxonomy. Hierarchically ordered from lowest (Remember) to highest (Create). Used to characterize what kind of cognitive demand a piece of report content places on the reader."@en .

rdodi-document:ContentTemplate a owl:Class ;
    rdfs:label "Content Template" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "Reusable pattern for generating specific content type" ;
    skos:scopeNote "Ensures consistency across similar sections" .

rdodi-document:FeedbackProcessor a owl:Class ;
    rdfs:label "Feedback Processor" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "System component that interprets and applies user feedback" ;
    skos:scopeNote "Uses NLP and LLM to understand intent" .

rdodi-document:LearningObjective a owl:Class ;
    rdfs:label "learning objective"@en ;
    dcterms:source "Report_Ontology_Requirements_v1_0_2 §3.2; Anderson & Krathwohl (2001) A Taxonomy for Learning, Teaching, and Assessing; LRMI (Learning Resource Metadata Initiative) specification"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "A statement of what a reader is expected to learn from a piece of report content. Anchored to a BloomLevel and an action verb consistent with that level."@en .

rdodi-document:RelationshipSection a owl:Class ;
    rdfs:label "Relationship Section" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Section> ;
    rdfs:subClassOf rdodi-document:ReportSection ;
    owl:disjointWith rdodi-document:AppendixSection ;
    skos:definition "Section analyzing connections and interactions between domain concepts" ;
    skos:scopeNote "Derived from ontology properties and relationships" .

rdodi-document:StatisticalContent a owl:Class ;
    rdfs:label "Statistical Content" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Table> ;
    rdfs:subClassOf rdodi-document:ReportContent ;
    skos:definition "Quantitative data and metrics about domain" ;
    skos:scopeNote "Derived from domain research and data analysis" .

rdodi-document:StructuralTemplate a owl:Class ;
    rdfs:label "Structural template"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Section> ;
    skos:definition "Ordered specification of required and optional sections of an artifact, by name or by role, with cardinality constraints."@en .

rdodi-document:ContentGenerationStrategy a owl:Class ;
    rdfs:label "Content Generation Strategy" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ContentGeneration ;
    skos:definition "Approach to generating specific type of content" ;
    skos:scopeNote "Different strategies for different content types" .

rdodi-document:ExtractedStructure a owl:Class ;
    rdfs:label "Extracted Structure" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "Structural information extracted from source ontology" ;
    skos:scopeNote "Intermediate representation for report generation" .

rdodi-document:UserFeedback a owl:Class ;
    rdfs:label "User Feedback" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "User input for refining generated report" ;
    skos:scopeNote "Natural language or structured feedback" .

rdodi-document:VoiceConstraint a owl:Class ;
    rdfs:label "Voice constraint"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "A specific phrasing or self-reference constraint on artifact prose, expressible as a positive pattern (required to appear with minimum frequency) or a negative pattern (prohibited from appearing). Examples: 'topic-first third-person declarative voice' (positive); 'no chapter-meta references in running prose' (negative); 'no ontology namespace identifiers leaking into prose-meant fields' (negative); 'Harvard author-year citation pattern appears at least 20 times' (positive with minimum occurrences)."@en .

rdodi-document:FeedbackType a owl:Class ;
    rdfs:label "Feedback Type" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:UserFeedback ;
    skos:definition "Category of user feedback" ;
    skos:scopeNote "Different feedback requires different processing" .

rdodi-document:PedagogicalSignal a owl:Class ;
    rdfs:label "pedagogical signal"@en ;
    dcterms:source "Report_Ontology_Requirements_v1_0_2 §3.3; Mayer (2009) Multimedia Learning"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "A signal embedded in report content that supports learning processes (worked example, self-check, summary, advance organizer, etc.)."@en .

rdodi-document:ArtifactKindSpec a owl:Class ;
    rdfs:label "Artifact kind specification"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "A first-class specification of the KIND of artifact that a production pipeline (or specific Activity) is expected to produce. Distinct from the form contract enforced by SHACL shapes on the produced artifact: an ArtifactKindSpec describes genre, voice, structural template, citation form, and quality-scorecard form - properties that are not detectable from triples alone and that require either (a) raw-inspection by a competent reviewer or (b) NLP-augmented validation with prose pattern detection."@en .

rdodi-document:ReportGenerationArtifact a owl:Class ;
    rdfs:label "Report Generation Artifact" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    skos:definition "Any artifact produced or consumed in ontology-driven report generation process" ;
    skos:example "Generated report, report template, content fragment, research result" ;
    skos:scopeNote "Root class for all report generation concepts including reports, templates, content, and generation processes" .

rdodi-document:ReportContent a owl:Class ;
    rdfs:label "Report Content" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "Substantive informational content within a report section" ;
    skos:example "Description of Cabernet Sauvignon characteristics, explanation of diabetes symptoms" ;
    skos:scopeNote "Generated through domain research, not extracted from ontology" .

rdodi-document:RefinementContribution a owl:Class ;
    rdfs:label "refinement contribution"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso prov:Entity ;
    skos:definition "A finding or recommendation produced during report generation that should feed back into ontology synthesis. Closes the loop: report-readers' confusion or unanswered questions identify ontology gaps; refinement contributions formalize those gaps as input to a new synthesis cycle. Each contribution is version-pinned to the ontology version it derives from."@en .

rdodi-document:ReportSection a owl:Class ;
    rdfs:label "Report Section" ;
    dcterms:source "Report Generation Ontology v1.0.1, derived from ontology-driven documentation framework practices and aligned with SPAR DoCO and FaBiO conventions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/document-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/doco/Section> ;
    rdfs:subClassOf rdodi-document:ReportGenerationArtifact ;
    skos:definition "Distinct structural division of a report, typically corresponding to an ontology concept or concept group" ;
    skos:example "Wine Types section (from WineType class), Disease Categories section (from Disease class)" ;
    skos:scopeNote "Hierarchical sections mirror ontology class hierarchy" .

<http://example.org/rdodi/document-ontology> dcterms:bibliographicCitation "Altunel, Y. (2026). PATCH bump v1.8.0 -> v1.8.1."@en ;
    dcterms:source "Report Generation Ontology v1.7.0 -> v1.8.x lineage; SPAR (DEO/DoCO/Pattern), FaBiO, FOAF integration for academic report structuring."@en ;
    prov:wasRevisionOf <http://example.org/rdodi/document-ontology/1.8.0> .

