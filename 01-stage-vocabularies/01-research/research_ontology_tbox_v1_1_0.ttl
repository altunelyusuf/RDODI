    rdfs:range foaf:Organization ;
    owl:inverseOf rdodi-research:receives ;
    skos:definition "Object property 'submittedTo'; relates research-ontology entities. See domain/range for typing constraints."@en .

rdodi-research:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.5; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range rdodi-research:Publication ;
    owl:inverseOf rdodi-research:supersededBy ;
    skos:definition "The subject resource supersedes the object — the object is treated as obsolete in favor of the subject. Critical for selection: Superseded resources may be rejected via :OutOfDate criterion."@en .

rdodi-research:usesMethod a owl:ObjectProperty ;
    rdfs:label "uses method"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:domain rdodi-research:DiscoveryAttempt ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range rdodi-research:DiscoveryMethod ;
    skos:definition "Links a DiscoveryAttempt to the DiscoveryMethod employed."@en .

