[] a owl:Restriction ;
    owl:maxQualifiedCardinality "5"^^xsd:nonNegativeInteger ;
    owl:onClass rdodi-research:Patent ;
    owl:onProperty rdodi-research:resultsInPatent .

[] a owl:Restriction ;
    owl:maxQualifiedCardinality "10"^^xsd:nonNegativeInteger ;
    owl:onClass rdodi-research:ResearchProject ;
    owl:onProperty rdodi-research:conducts .

_:n6ba35be4fce441e7a0b07f53a1709beab29 rdf:first rdodi-research:TechnologyReadinessLevel ;
    rdf:rest ( rdodi-research:ManufacturingReadinessLevel ) .

_:n6ba35be4fce441e7a0b07f53a1709beab31 owl:inverseOf rdodi-research:authored .

_:n6ba35be4fce441e7a0b07f53a1709beab21 a owl:Restriction ;
