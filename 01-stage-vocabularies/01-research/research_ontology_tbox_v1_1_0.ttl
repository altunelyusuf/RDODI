    owl:onProperty rdodi-research:levelNumber .

_:n6ba35be4fce441e7a0b07f53a1709beab23 a owl:Restriction ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:embargoDate .

_:n6ba35be4fce441e7a0b07f53a1709beab26 a owl:Restriction ;
    owl:onProperty rdodi-research:presentedAt ;
    owl:someValuesFrom rdodi-research:Conference .

_:n6ba35be4fce441e7a0b07f53a1709beab18 a owl:Restriction ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:stageNumber .

_:n6ba35be4fce441e7a0b07f53a1709beab22 a owl:Restriction ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:levelNumber .

_:n6ba35be4fce441e7a0b07f53a1709beab20 owl:unionOf _:n6ba35be4fce441e7a0b07f53a1709beab29 .

_:n6ba35be4fce441e7a0b07f53a1709beab8 a owl:Restriction ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:grantedTo .

_:n6ba35be4fce441e7a0b07f53a1709beab9 a owl:Restriction ;
    owl:onProperty rdodi-research:licensesIP ;
    owl:someValuesFrom rdodi-research:Patent .

_:n6ba35be4fce441e7a0b07f53a1709beab12 a owl:Restriction ;
    owl:onProperty rdodi-research:depositsIn ;
    owl:someValuesFrom rdodi-research:Repository .

_:n6ba35be4fce441e7a0b07f53a1709beab5 a owl:Restriction ;
    owl:allValuesFrom rdodi-research:Dataset ;
    owl:onProperty rdodi-research:contains .

_:n6ba35be4fce441e7a0b07f53a1709beab6 a owl:Restriction ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:hasAccessPolicy .

_:n6ba35be4fce441e7a0b07f53a1709beab7 a owl:Restriction ;
    owl:minCardinality 1 ;
    owl:onProperty rdodi-research:hasAccessPolicy .

_:n6ba35be4fce441e7a0b07f53a1709beab1 a owl:Restriction ;
    owl:minCardinality 1 ;
    owl:onProperty _:n6ba35be4fce441e7a0b07f53a1709beab31 .

_:n6ba35be4fce441e7a0b07f53a1709beab3 a owl:Restriction ;
    owl:cardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:publicationYear .

_:n6ba35be4fce441e7a0b07f53a1709beab4 a owl:Restriction ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onProperty rdodi-research:authoredBy .


#################################################################
#  v1.1.0 -- machine-readable Publication verification status
#  Added per Proposal_RDODI_Stage3F_Wiring_v1_0_0.md (b), filed by the
#  code-abundance-rdodi session (github.com/altunelyusuf/RDODI-Research):
#  "For (a)'s refs[].status to be more than a hardcoded 'verified', Stage 1's
#  rdodi-research:Publication individuals need an actual status property... rather than
#  a downstream reader having to parse prose to reconstruct it."
#  Enumerated-individual pattern, matching backlog-roadmap-framework's own
#  MissionOrigin/IntentOrigin convention (L-105 -- reusing an established
#  ecosystem pattern rather than inventing a bare string property with no
#  formal enumeration). Values match reference_rule_gate_v1_0_0.py's own
#  three literal strings exactly ('verified'/'unavailable_flagged'/
#  'unverified'), via skos:notation, so a bridge can emit the gate's
#  expected string without a lookup table drifting from the code.
#################################################################

rdodi-research:VerificationStatus a owl:Class ;
    rdfs:label "Verification Status"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    owl:oneOf ( rdodi-research:Status_Verified rdodi-research:Status_UnavailableFlagged rdodi-research:Status_Unverified ) ;
    skos:definition "Whether a Publication's claim has been independently confirmed, honestly disclosed as unconfirmed, or left unverified. Machine-readable so a downstream reader (e.g. a Stage3.F bridge) does not have to parse free-text prose to reconstruct what a Stage 1 quality scorecard already determined."@en .

rdodi-research:Status_Verified a owl:NamedIndividual , rdodi-research:VerificationStatus ;
    rdfs:label "Verified"@en ;
    skos:notation "verified" ;
    skos:definition "Independently confirmed against a source the research artifact could open and check."@en .

rdodi-research:Status_UnavailableFlagged a owl:NamedIndividual , rdodi-research:VerificationStatus ;
    rdfs:label "Unavailable, flagged"@en ;
    skos:notation "unavailable_flagged" ;
    skos:definition "The claim could not be independently confirmed, and this was disclosed honestly rather than silently assumed true. Acceptable per reference_rule_gate_v1_0_0.py -- honest disclosure is not a defect."@en .

rdodi-research:Status_Unverified a owl:NamedIndividual , rdodi-research:VerificationStatus ;
    rdfs:label "Unverified"@en ;
    skos:notation "unverified" ;
    skos:definition "Neither confirmed nor disclosed as unconfirmable. The one status reference_rule_gate_v1_0_0.py actually fails a citation for."@en .

rdodi-research:hasVerificationStatus a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:range rdodi-research:VerificationStatus ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:label "has verification status"@en ;
    skos:definition "Links a Publication to its VerificationStatus. No existing research ABox in rdodi-ecosystem sets this yet -- see CHANGELOG for the honest disclosure that this ships the vocabulary, not a retrofit of existing data (which is code-abundance-rdodi's own, not this package's to edit, per B1)."@en .
