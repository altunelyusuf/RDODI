    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf <http://purl.org/cerif/frapo/hasStartDate> ;
    owl:equivalentProperty <http://purl.org/cerif/frapo/hasStartDate> ;
    skos:definition "Start date"@en .

rdodi-research:submittedTo a owl:ObjectProperty ;
    rdfs:label "submittedTo"@en ;
    dcterms:source "Research Ontology v6.1.0 — synthesizes SPAR (FaBiO/FRAPO/CiTO/DataCite), VIVO, FOAF, PROV-O, DCAT and CRediT (ANSI/NISO Z39.104-2022) for academic research domain modeling."@en ;
