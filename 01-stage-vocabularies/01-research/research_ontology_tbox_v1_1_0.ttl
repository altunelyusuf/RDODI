    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.3; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "Declared or identifiable conflicts of interest relevant to the resource's claims."@en .

rdodi-research:hasContext a owl:DatatypeProperty ;
    rdfs:label "has context"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §3.1; Pawson et al. (2005) CIMO framework for management/organizational research"@en ;
    rdfs:domain rdodi-research:CIMOFrame ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
