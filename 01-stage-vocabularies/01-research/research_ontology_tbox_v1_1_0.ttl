rdodi-research:RecallMaximizing a owl:Class ;
    rdfs:label "recall-maximizing selection"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §5.1; Booth et al. (2016) on recall-precision tradeoffs"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:subClassOf rdodi-research:SelectionStrategy ;
    skos:definition "Selects broadly to maximize recall (true-positive rate); accepts more noise. Used when missing relevant work is more costly than processing irrelevant work."@en .

rdodi-research:RecencyWeighted a owl:Class ;
    rdfs:label "recency-weighted selection"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §5.1; Garfield (2006) on temporal weighting in citation analysis"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:subClassOf rdodi-research:SelectionStrategy ;
    skos:definition "Selects resources weighted by publication recency. Newer publications receive higher selection priority. Configurable decay parameters."@en .

