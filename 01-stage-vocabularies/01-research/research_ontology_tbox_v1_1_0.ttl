    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.3; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "Description of any commercial motivation behind the resource's production or distribution."@en .

rdodi-research:hasComparison a owl:DatatypeProperty ;
    rdfs:label "has comparison"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §3.1; Richardson et al. (1995) PICO framework for clinical questions; Booth et al. (2016)"@en ;
    rdfs:domain rdodi-research:PICOFrame ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "PICO Comparison component — what is the alternative or control."@en .

rdodi-research:hasComponentStrategy a owl:ObjectProperty ;
