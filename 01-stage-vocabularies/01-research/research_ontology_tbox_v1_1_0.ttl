rdodi-research:reproducesExistingClaim a owl:DatatypeProperty ;
    rdfs:label "reproduces existing claim"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.4; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "True if the resource is a replication or reproduction of an existing claim."@en .

rdodi-research:requiresStrictScope a owl:DatatypeProperty ;
    rdfs:label "requires strict scope"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §3.2"@en ;
    rdfs:domain rdodi-research:ResearchScope ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a ResearchScope: when true, scope must satisfy frame-specific completeness (e.g., PICO requires all four components). When false (default), missing components produce advisory warnings only. Used by SHACL sufficiency shapes."@en .

rdodi-research:retracts a owl:ObjectProperty ;
    rdfs:label "retracts"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.5; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range rdodi-research:Publication ;
    owl:inverseOf rdodi-research:retractedBy ;
    skos:definition "The subject is a retraction notice for the object resource. Resources retracted are rejected via :Retracted criterion."@en .

rdodi-research:startDate a owl:DatatypeProperty ;
    rdfs:label "start date"@en ;
    dcterms:source "Research Ontology v6.1.0 — synthesizes SPAR (FaBiO/FRAPO/CiTO/DataCite), VIVO, FOAF, PROV-O, DCAT and CRediT (ANSI/NISO Z39.104-2022) for academic research domain modeling."@en ;
