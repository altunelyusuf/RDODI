    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:range rdodi-research:SelectionStrategy ;
    skos:definition "Links a CompositeStrategy to one of its component sub-strategies. Multi-valued."@en .

rdodi-research:hasConflictOfInterest a owl:DatatypeProperty ;
