rdodi-research:Citation a owl:Class ;
    rdfs:label "Citation"@en ;
    dcterms:source "SPAR CiTO http://purl.org/spar/cito/ retrieved 2026-05-06"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:seeAlso <http://purl.org/spar/cito/Citation> ;
    skos:definition "A reference from one publication to another, indicating that the citing publication uses, supports, or extends content of the cited one. Aligned to CiTO Citation."@en .

rdodi-research:CitationChainSelection a owl:Class ;
    rdfs:label "citation chain selection"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §5.1; Hjørland (2013) on citation chain methodology"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:subClassOf rdodi-research:SelectionStrategy ;
    skos:definition "Selects resources based on their position in citation chains from seed resources. Selects for traversability rather than centrality."@en .

rdodi-research:CitationChainTraversal a owl:Class ;
    rdfs:label "citation chain traversal"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:subClassOf rdodi-research:DiscoveryMethod ;
    skos:definition "A discovery action following citation links from known seed resources outward (forward via :citedBy, backward via :cites) to find related work."@en .

rdodi-research:CitationCountWeighted a owl:Class ;
    rdfs:label "citation-count-weighted selection"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §5.1; Garfield (1955) Citation Indexes for Science"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    rdfs:subClassOf rdodi-research:SelectionStrategy ;
    skos:definition "Selects resources weighted by citation count. Highly-cited works receive higher selection priority. Subject to selection bias toward established works."@en .

