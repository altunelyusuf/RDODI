    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "Affiliation with advocacy organizations that may influence the resource's perspective."@en .

rdodi-research:hasAuthorContext a owl:DatatypeProperty ;
    rdfs:label "has author context"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.1; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "Free-text or structured description of the author's institutional or expertise context relevant to evaluating the resource's authority."@en .

rdodi-research:hasAuthoritySoundness a owl:DatatypeProperty ;
    rdfs:label "has authority soundness"@en ;
    dcterms:source "Research_Ontology_Requirements_v1_0_2 §4.1; ACRL Framework for Information Literacy in Higher Education (2016)"@en ;
    rdfs:domain rdodi-research:Publication ;
    rdfs:isDefinedBy <http://example.org/rdodi/research-ontology> ;
    skos:definition "An assessment of how robust the credentialing mechanism is. Free-text or rated scale."@en .

rdodi-research:hasCommercialMotivation a owl:DatatypeProperty ;
