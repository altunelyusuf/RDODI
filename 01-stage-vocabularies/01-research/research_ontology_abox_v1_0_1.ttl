rdodi-research:SPARImportsAlignment_v6_3_0 a owl:NamedIndividual ;
    rdfs:label "SPAR/VIVO/FRAPO/FOAF imports + CiTO/SCoRO/DataCite alignment v6.3.0"@en ;
    skos:definition "Adds 9 owl:imports declarations so reasoners can consume the existing 22 owl:equivalentClass triples to FaBiO/FRAPO/VIVO. Adds 5 new rdfs:seeAlso alignments to CiTO (citation), SCoRO (contributorship), and DataCite (identifiers)."@en .

rdodi-research:SPARImportsAlignment_v6_3_1 a owl:NamedIndividual ;
    rdfs:label "SPAR + CiTO + DataCite alignment block v6.3.1"@en ;
    dcterms:source "SPAR CiTO + DataCite retrieved 2026-05-06."@en ;
    skos:definition "v6.3.1 closes the deferred CiTO/DataCite alignments by introducing 4 new classes (Citation, Identifier, DOI, ORCID) with rdfs:seeAlso to canonical SPAR URIs. Total: 4 new classes added."@en .

