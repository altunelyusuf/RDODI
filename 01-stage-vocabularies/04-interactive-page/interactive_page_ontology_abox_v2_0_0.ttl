rdodi-page:ConceptDemo_QA_SecurityCompliance a rdodi-page:QualityAssessment,
        owl:NamedIndividual ;
    rdfs:label "QA: SecurityCompliance (Required by Cap_CodeExecution) for ConceptDemoArtifact"@en ;
    rdodi-page:alongDimension rdodi-page:SecurityCompliance ;
    rdodi-page:assesses rdodi-page:ConceptDemoArtifact ;
    rdodi-page:assessmentDate "2026-05-08T12:00:00"^^xsd:dateTime ;
    rdodi-page:assessmentSeverity "required" ;
    dcterms:source "WPC capability quality implication shape Cap_CodeExecution_SecurityCompliance_Required_Shape"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Quality assessment for SecurityCompliance — required by Cap_CodeExecution capability (sandbox isolation prevents malicious code). Not in Demo specialization's default profile (Security=Optional for Demo) but cap-Required overrides spec-Optional."@en .

