rdodi-page:UserControlAndFreedom a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "user control and freedom"@en ;
    dcterms:source "Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Users often choose system functions by mistake."@en .

rdodi-page:UserEngagement a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "user engagement"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "The features of the interactive system encourage the use of the system and confidence in interacting with it."@en .

rdodi-page:VisibilityOfSystemStatus a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "visibility of system status"@en ;
    dcterms:source "Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The system should always keep users informed about what is going on, through appropriate feedback within reasonable time."@en .

rdodi-page:complementaryView a rdodi-page:CrossReferenceType,
