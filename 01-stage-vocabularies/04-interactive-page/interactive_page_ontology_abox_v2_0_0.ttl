    rdodi-page:assessmentSeverity "recommended" ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4 reference examples; Sprint 8 integration"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Quality assessment along UsabilityOptimization for the artifact, severity Recommended."@en .

rdodi-page:AnalysisVsDesignBalance a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Analysis vs Design Balance"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Ratio of analysis-level content (NFR elicitation, quality-attribute scenarios, stakeholder concerns, tradeoff analysis, ADRs) to design-level content (chosen architectures, specific technologies). For technical chapters target ratio >= 1:5; below 1:10 is a Warning."@en .

rdodi-page:AnimationAndSimulationDepth a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Animation and Simulation Depth"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Depth of dynamic visual elements: CSS @keyframes animations, <canvas> renderings, requestAnimationFrame loops, setInterval simulations. Navigation widgets (tabs, toggles, filters, radio quizzes) are NOT simulations and do NOT count here."@en .

rdodi-page:Approved a rdodi-page:PageLifecycleState,
        owl:NamedIndividual ;
    rdfs:label "approved"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Review complete; ready for publication but not yet published."@en .

rdodi-page:Archived a rdodi-page:PageLifecycleState,
        owl:NamedIndividual ;
    rdfs:label "archived"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Page is no longer publicly accessible but retained for reference."@en .

rdodi-page:BestPractice_WPC1_IndustrialUXGate a owl:NamedIndividual ;
    rdfs:label "BP-WPC-1: Industrial-UX gate — Page must declare ≥ 5 heuristic claims + layout pattern + semantic regions + measurement bindings"@en ;
    dcterms:source "OE_Ecosystem_Corrections_v1_0_0.md (2026-05-13) findings F1-F7; ISO 9241-110:2020; Nielsen Norman heuristic catalogue."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Enforced operationally by wpc_core_shacl v4.0.0 PageIndustrialUXShape. Closes the 7 industrial-UX gaps documented in OE_Ecosystem_Corrections."@en .

rdodi-page:BestPractice_WPC2_LightThemeOnly a owl:NamedIndividual ;
    rdfs:label "BP-WPC-2: Light theme only for all HTML artifacts"@en ;
    dcterms:source "User preference (Yusuf Altunel), persistent across sessions. Recorded in memory_user_edits."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Light theme means white/light backgrounds (#ffffff to #f8fafc) with dark text (#0f172a to #475569). Achieves consistency across course materials and avoids the maintenance cost of dual themes."@en .

rdodi-page:BestPractice_WPC3_NoCdnDependencies a owl:NamedIndividual ;
    rdfs:label "BP-WPC-3: No external CDN dependencies in HTML artifacts"@en ;
    dcterms:source "Industrial-UX uplift v3.2.0 closure (2026-05-13). Reasoned from Core Web Vital performance impact: 3 CDN calls (Google Fonts + FontAwesome + Chart.js) typically add 200-800ms to LCP."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "HTML artifacts MUST be fully self-contained — no external script, stylesheet, font, or image references. Use system font stacks (-apple-system, BlinkMacSystemFont, Segoe UI, Roboto), inline SVG (not Chart.js), and CSS-only styling. Benefits: works offline, eliminates LCP regression from CDN latency, eliminates privacy concerns (no third-party tracking), passes air-gapped enterprise environments."@en .

rdodi-page:BestPractice_WPC4_PageAboxCompanionRequired a owl:NamedIndividual ;
    rdfs:label "BP-WPC4: Page ABox companion required"@en ;
    dcterms:source "Industrial-UX assessment 2026-05-13 finding: alternative HTML pipeline (com4061_chapter6_v1_0_17.html) shipped HTML-only without a WPC ABox; this prevented WPC contract validation entirely."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The ABox is the machine-readable contract; the HTML is the rendering. Filename pattern: {page-name}_page_abox_v{M}_{m}_{p}.ttl. Without the companion, BP-WPC-1 (Industrial-UX gate) cannot be enforced — assessments must run against the ABox, not against HTML attributes alone."@en .

rdodi-page:CES a rdodi-page:SatisfactionInstrument,
        owl:NamedIndividual ;
    rdfs:label "Customer Effort Score (CES)"@en ;
    rdodi-page:appliesTo rdodi-page:UsabilityOptimization ;
    dcterms:source "Dixon, M., Freeman, K., Toman, N. (2010) Stop Trying to Delight Your Customers. HBR."@en ;
    skos:definition "7-point Likert: 'The system made it easy for me to handle my task.' Lower effort = better."@en .

rdodi-page:CLS a rdodi-page:CoreWebVital,
        owl:NamedIndividual ;
    rdfs:label "Cumulative Layout Shift"@en ;
    rdodi-page:appliesTo rdodi-page:PerformanceOptimization ;
    dcterms:source "Google Core Web Vitals 2024"@en ;
    skos:definition "Sum of unexpected layout-shift scores during page lifetime. Good ≤ 0.1; Needs improvement 0.1-0.25; Poor > 0.25."@en .

rdodi-page:CQ1_PageHierarchy a owl:NamedIndividual ;
    rdfs:label "What is the breadcrumb path for a Page?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by walking :hasParent recursively from a Page until reaching a root."@en .

rdodi-page:CQ1_QualityCoverage a owl:NamedIndividual ;
    rdfs:label "Which quality dimensions does my specialization require?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §3.7 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying SHACL shapes targeting the specialization class — each shape's sh:targetClass + sh:property + sh:severity reveals the per-dimension requirement."@en .

rdodi-page:CQ1_QualityImplicationCoverage a owl:NamedIndividual ;
    rdfs:label "What quality assessments are implied by Page's capabilities?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

rdodi-page:CQ1_SSGChoice a owl:NamedIndividual ;
    rdfs:label "What static site generators are available?"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Given a stack preference, which SSGs (ReactBased, VueBased, GoBased, etc.) are candidates? Answered by browsing wt:StaticSiteGenerator subclass hierarchy."@en .

rdodi-page:CQ1_SpecializationCoverage a owl:NamedIndividual ;
    rdfs:label "What WPC specialization does each artifact represent?"@en ;
    dcterms:source "Sprint 8 representative ABox CQ"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying rdf:type on each ABox artifact — one of the 5 spec:WPC_* classes."@en .

rdodi-page:CQ1_SpecializationType a owl:NamedIndividual ;
    rdfs:label "What specialization does an artifact use?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §4 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying rdf:type on the WPCArtifact instance — one of the 5 SPEC.WPC_* subclasses."@en .

rdodi-page:CQ2_CMSChoice a owl:NamedIndividual ;
    rdfs:label "What CMS architectures exist?"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Given a content authoring requirement, which CMS architecture (Traditional, Headless, Decoupled, GitBased, APIFirst) fits? Answered by wt:ContentManagementSystem subtypes."@en .

rdodi-page:CQ2_NavigationContext a owl:NamedIndividual ;
    rdfs:label "What CrossReferences and related content does a Page have?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying :hasCrossReference and following to typed targets."@en .

rdodi-page:CQ2_PageCapabilities a owl:NamedIndividual ;
    rdfs:label "What capabilities does each representative Page declare?"@en ;
    dcterms:source "Sprint 8 representative ABox CQ"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

rdodi-page:CQ2_ProfileSeverity a owl:NamedIndividual ;
    rdfs:label "What's the severity of dimension D for specialization S?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §3.7 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by finding the shape whose targetClass = S and whose property path = :hasQualityAssessment + sh:qualifiedValueShape pointing to dimension D — read sh:severity."@en .

rdodi-page:CQ2_QualityProfile a owl:NamedIndividual ;
    rdfs:label "What quality profile applies for this specialization?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §4 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved via the wpc_quality_profiles companion ontology — each specialization maps to a specific profile of severity-per-dimension."@en .

rdodi-page:CQ2_VideoCaptionsRequired a owl:NamedIndividual ;
    rdfs:label "Does VideoEmbed-using page have caption assessment?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by SHACL shape Cap_VideoEmbed_AccessibilityCompliance_Required_Shape."@en .

rdodi-page:CQ3_LifecycleState a owl:NamedIndividual ;
    rdfs:label "What is the current lifecycle state of a Page?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying :hasLifecycleState (when :hasLifecycleAffordance true on the artifact)."@en .

rdodi-page:CQ3_QualityAssessmentCoverage a owl:NamedIndividual ;
    rdfs:label "What quality assessments accompany each artifact?"@en ;
    dcterms:source "Sprint 8 representative ABox CQ"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

rdodi-page:CQ3_RenderingStrategy a owl:NamedIndividual ;
    rdfs:label "What rendering strategies exist?"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Given performance and SEO constraints, which rendering strategy (StaticGeneration, ServerSideRendering, ClientSideRendering, ISR, Hydration variants) is appropriate? Answered by wt:RenderingStrategy subclass hierarchy."@en .

rdodi-page:CQ3_TypicalCapabilities a owl:NamedIndividual ;
    rdfs:label "Which capabilities are typical for this specialization?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §4 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved via documentation in skos:definition of each specialization (capability membership wired in Sprint 6's wpc_capabilities ontology)."@en .

rdodi-page:CQ4_LifecycleHistory a owl:NamedIndividual ;
    rdfs:label "What is the transition history of a Page?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by following :hasTransitionHistory chain (each transition prov:wasInformedBy the previous)."@en .

rdodi-page:CQ4_SpecializationFeatures a owl:NamedIndividual ;
    rdfs:label "What specialization-specific features does the artifact have?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §4 derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying the specialization-specific classes (e.g., :ConversionGoal for Corporate, :AuthorizationScope for Internal)."@en .

rdodi-page:CQ5_QualityAssessment a owl:NamedIndividual ;
    rdfs:label "What is the quality severity for a (specialization, dimension) pair?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by joining :assesses + :alongDimension + :assessmentSeverity for the artifact's specialization."@en .

rdodi-page:CQ6_Composition a owl:NamedIndividual ;
    rdfs:label "What capabilities does a page require/typically-pair?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying :requiresCapability + :typicallyPairedWith on the page's declared capabilities."@en .

rdodi-page:CQ7_HostsContent a owl:NamedIndividual ;
    rdfs:label "What does a Page host from a Report?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying the 6 :hosts* inverse-of-offers properties."@en .

rdodi-page:CQ8_NavigationPatterns a owl:NamedIndividual ;
    rdfs:label "Which MacroNavigationPatterns does a Page include?"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md derived competency question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Resolved by querying :includesNavigationPattern and :includesWayfindingAffordance."@en .

rdodi-page:CSAT a rdodi-page:SatisfactionInstrument,
        owl:NamedIndividual ;
    rdfs:label "Customer Satisfaction (CSAT)"@en ;
    rdodi-page:appliesTo rdodi-page:UsabilityOptimization ;
    dcterms:source "Industry-standard since 2000s; ISO 9241-11:2018 satisfaction framing"@en ;
    skos:definition "Single-question satisfaction rating, typically 1-5 or 1-7 scale. Reported as % satisfied."@en .

rdodi-page:CaseStudyCoverage a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Case Study Coverage"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Fraction of source CaseStudies the page references or works through. Major running cases (e.g., RMO across Satzinger 7e chapters) carry more weight than peripheral cases."@en .

rdodi-page:CodeSnippetPresence a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Code Snippet Presence"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Presence of substantive code examples in <pre><code> blocks. Inline <code> references (single tokens like <code>kubectl</code>) do NOT count."@en .

rdodi-page:ColorContrastCompliance a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "colour contrast compliance"@en ;
    rdodi-page:partOfDimension rdodi-page:AccessibilityCompliance ;
    dcterms:source "WCAG 2.2 Success Criterion 1.4.3 (AA: 4.5:1 normal, 3:1 large)"@en ;
    skos:definition "Visual presentation of text has a contrast ratio of at least 4.5:1 (normal text) or 3:1 (large text)."@en .

rdodi-page:ConformityWithUserExpectations a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "conformity with user expectations"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "Consistent with predictable behaviour from user characteristics and commonly accepted conventions."@en .

rdodi-page:ConsistencyAndStandards a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "consistency and standards"@en ;
    dcterms:source "Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Follow platform and industry conventions. Words and actions should mean the same thing across contexts."@en .

rdodi-page:ContentFidelity a rdodi-page:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "Content Fidelity"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Composite quality dimension: how faithfully the page represents its declared source document. Aggregates 7 sub-aspects."@en .

rdodi-page:Controllability a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "controllability"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "Allows the user to initiate and control the direction and pace of the interaction until the point at which the goal has been met."@en .

rdodi-page:Deprecated a rdodi-page:PageLifecycleState,
        owl:NamedIndividual ;
    rdfs:label "deprecated"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Page is still accessible but marked as superseded by newer content."@en .

rdodi-page:DeviceAgnostic a rdodi-page:ResponsiveIntent,
        owl:NamedIndividual ;
    rdfs:label "device agnostic"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Single layout that works across all devices without breakpoints."@en .

rdodi-page:DiagramFidelity a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Diagram Fidelity"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Fraction of source Figures the page renders (as SVG, animation, or interactive equivalent). Pedagogical equivalence, not pixel-equivalence."@en .

rdodi-page:Discoverability a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Discoverability — users can find functions without training"@en ;
    dcterms:source "Norman, D. (2013) The Design of Everyday Things, Revised Edition; WCAG 2.2 success criteria 2.4.* and 3.2.*"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A user, without prior training, can find the functions, controls, and content they need. Distinct from learnability (how quickly someone gets fluent after they have found the thing). Industry-recognised independent of Nielsen 10 and ISO 9241-110 7."@en .

