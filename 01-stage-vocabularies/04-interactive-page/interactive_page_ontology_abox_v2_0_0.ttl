        owl:NamedIndividual ;
    rdfs:label "published"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Live and visible to end users."@en .

rdodi-page:RecognitionRatherThanRecall a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "recognition rather than recall"@en ;
    dcterms:source "Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Make objects, actions, and options visible. Minimize the user's memory load."@en .

rdodi-page:ReducedMotionSupport a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "reduced motion support"@en ;
    rdodi-page:partOfDimension rdodi-page:AccessibilityCompliance ;
    dcterms:source "WCAG 2.2 SC 2.3.3; CSS Media Queries Level 5 prefers-reduced-motion"@en ;
    skos:definition "Animations triggered by interaction can be disabled; respects prefers-reduced-motion media query."@en .

rdodi-page:SUS a rdodi-page:SatisfactionInstrument,
        owl:NamedIndividual ;
    rdfs:label "System Usability Scale (SUS)"@en ;
    rdodi-page:appliesTo rdodi-page:UsabilityOptimization ;
    dcterms:source "Brooke, J. (1996) SUS: A quick and dirty usability scale. In Usability Evaluation in Industry."@en ;
    skos:definition "10-item 5-point Likert questionnaire returning a 0-100 normalised score. Industry benchmark: ≥ 68 above-average, ≥ 80 excellent."@en .

rdodi-page:ScreenReaderCompatibility a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "screen reader compatibility"@en ;
    rdodi-page:partOfDimension rdodi-page:AccessibilityCompliance ;
    dcterms:source "WCAG 2.2 Success Criteria 1.3.1, 4.1.2, 4.1.3"@en ;
    skos:definition "Information and structure conveyed through presentation can be programmatically determined and announced by assistive technology."@en .

rdodi-page:SelfDescriptiveness a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "self-descriptiveness"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "Each dialogue step is immediately comprehensible through feedback from the system or is explained on user request."@en .

rdodi-page:ShneidermanRule_DesignDialogsToYieldClosure a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #4: Design dialogs to yield closure"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Sequences of actions should be organised into groups with a beginning, middle, and end. Informative feedback at the completion of a group of actions gives operators the satisfaction of accomplishment and a sense of relief."@en .

rdodi-page:ShneidermanRule_KeepUsersInControl a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #7: Keep users in control (internal locus of control)"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Experienced operators strongly desire the sense that they are in charge of the system and that the system responds to their actions. Surprising system behaviour, tedious data entry, and inability to obtain or difficulty obtaining desired information all build anxiety and dissatisfaction."@en .

rdodi-page:ShneidermanRule_OfferInformativeFeedback a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #3: Offer informative feedback"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "For every user action there should be system feedback. For frequent and minor actions the response should be modest; for infrequent and major actions the response should be more substantial."@en .

rdodi-page:ShneidermanRule_PermitEasyReversalOfActions a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #6: Permit easy reversal of actions"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Actions should be reversible. This feature relieves anxiety, since the user knows that errors can be undone, and encourages exploration of unfamiliar options."@en .

rdodi-page:ShneidermanRule_PreventErrors a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #5: Prevent errors"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Design the system such that users cannot make serious errors; if a user makes an error the interface should detect the error and offer simple, constructive, and specific instructions for recovery. Companion to Nielsen #5 (ErrorPrevention)."@en ;
    skos:related rdodi-page:ErrorPrevention .

rdodi-page:ShneidermanRule_ReduceShortTermMemoryLoad a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #8: Reduce short-term memory load"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Humans' limited capacity for information processing in short-term memory (roughly seven plus-or-minus two chunks) requires that displays be kept simple, multiple-page displays be consolidated, window-motion frequency be reduced, and sufficient training time be allotted for codes and sequences of actions."@en .

rdodi-page:ShneidermanRule_SeekUniversalUsability a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #2: Seek universal usability"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Recognise diverse users' needs and facilitate transformation of content. Novices and experts, age range differences, disabilities, technology diversity all enrich design requirements."@en .

rdodi-page:ShneidermanRule_StriveForConsistency a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "Shneiderman #1: Strive for consistency"@en ;
    dcterms:source "Shneiderman et al. (2017) Designing the User Interface, 6e"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Consistent sequences of actions should be required in similar situations; identical terminology should be used in prompts, menus, and help screens; consistent color, layout, capitalization, fonts should be employed throughout."@en .

rdodi-page:SourceCoverage a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "Source Coverage"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Fraction of source ChapterSections + LearningObjectives + KeyTerms that the page covers."@en .

