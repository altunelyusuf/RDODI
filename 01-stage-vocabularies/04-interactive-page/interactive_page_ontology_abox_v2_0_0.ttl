rdodi-page:SuitabilityForTheTask a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "suitability for the task"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "The interactive system supports the user in completing the task; the displayed information is task-appropriate."@en .

rdodi-page:TTFB a rdodi-page:CoreWebVital,
        owl:NamedIndividual ;
    rdfs:label "Time to First Byte"@en ;
    rdodi-page:appliesTo rdodi-page:PerformanceOptimization ;
    dcterms:source "Google Web Vitals"@en ;
    skos:definition "Time from request to first byte received. Good ≤ 800ms; Needs improvement 800-1,800ms; Poor > 1,800ms."@en .

rdodi-page:TextAlternativeAvailability a rdodi-page:QualitySubAspect,
        owl:NamedIndividual ;
    rdfs:label "text alternative availability"@en ;
    rdodi-page:partOfDimension rdodi-page:AccessibilityCompliance ;
    dcterms:source "WCAG 2.2 Success Criterion 1.1.1"@en ;
    skos:definition "All non-text content has a text alternative that serves the equivalent purpose."@en .

