    skos:definition "Initial state; content is being authored; not visible to end users."@en .

rdodi-page:ErrorTolerance a rdodi-page:DialoguePrinciple,
        owl:NamedIndividual ;
    rdfs:label "error tolerance"@en ;
    dcterms:source "ISO 9241-110:2020"@en ;
    skos:definition "Allows the intended result to be achieved despite obvious errors in input either with no or minimal action by the user."@en .

