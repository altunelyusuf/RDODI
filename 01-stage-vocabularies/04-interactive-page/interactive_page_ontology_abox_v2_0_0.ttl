    skos:definition "Reference Educational artifact: instructional book with chapters, quizzes, code examples, embedded video lectures. Per WPC §4.4."@en .

rdodi-page:UsabilityOptimization a rdodi-page:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "usability optimization"@en ;
    dcterms:source "Nielsen Norman Group 10 Heuristics; Flesch readability"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Nielsen's 10 heuristics + readability + cognitive load + mobile responsiveness."@en .

rdodi-page:PerformanceOptimization a rdodi-page:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "performance optimization"@en ;
    dcterms:source "Google Core Web Vitals (2024); Web Almanac (HTTP Archive)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Core Web Vitals: LCP ≤2.5s, INP ≤200ms, CLS ≤0.1. Bundle size, caching, image optimization."@en .

rdodi-page:AccessibilityCompliance a rdodi-page:QualityDimension,
        owl:NamedIndividual ;
    rdfs:label "accessibility compliance"@en ;
    dcterms:source "WCAG 2.2 (W3C 2023); ARIA Authoring Practices Guide"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "WCAG 2.2 conformance (A, AA, AAA), semantic HTML, ARIA, keyboard navigation, screen reader compatibility."@en .

