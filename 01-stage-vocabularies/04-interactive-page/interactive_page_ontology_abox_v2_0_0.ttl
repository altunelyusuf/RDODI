    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The source page summarizes the target page (target is more detailed)."@en .

