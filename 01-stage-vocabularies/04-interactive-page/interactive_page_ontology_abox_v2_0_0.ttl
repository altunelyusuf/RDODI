@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdodi-page:AestheticAndMinimalistDesign a rdodi-page:UsabilityHeuristic,
        owl:NamedIndividual ;
    rdfs:label "aesthetic and minimalist design"@en ;
    dcterms:source "Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Interfaces should not contain information that is irrelevant or rarely needed."@en .

