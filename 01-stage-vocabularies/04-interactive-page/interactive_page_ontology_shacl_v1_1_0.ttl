rdodi-page:QualityAssessment_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for QualityAssessment"@en ;
    sh:property [ sh:message "Representative QualityAssessment instance SHOULD carry an rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:QualityAssessment .

rdodi-page:SecondarySourceProvenanceShape a sh:NodeShape ;
    rdfs:label "SecondarySourceProvenance skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:SecondarySourceProvenance .

rdodi-page:SourceProvenanceShape a sh:NodeShape ;
    rdfs:label "SourceProvenance skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:SourceProvenance .

rdodi-page:TechnicalPageCodeShape a sh:NodeShape ;
    sh:property [ sh:message "Inline <code> references do not count."@en ;
            sh:minCount 1 ;
            sh:path rdodi-page:containsCodeExample ;
            sh:severity sh:Warning ] ;
    sh:targetSubjectsOf rdodi-page:hasSourceDocument .

rdodi-page:UsabilityHeuristicLabelShape a sh:NodeShape ;
    rdfs:label "Usability Heuristic must have label and source"@en ;
    sh:property [ sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Violation ],
        [ sh:message "UsabilityHeuristic MUST cite its source (e.g., Nielsen Norman Group)." ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass rdodi-page:UsabilityHeuristic .

rdodi-page:demonstratesSubjectPropertyShape a sh:NodeShape ;
    rdfs:label "demonstratesSubject property shape"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path rdodi-page:demonstratesSubject ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf rdodi-page:demonstratesSubject .

rdodi-page:enforcesDomainConstraintPropertyShape a sh:NodeShape ;
    rdfs:label "enforcesDomainConstraint property shape"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:path rdodi-page:enforcesDomainConstraint ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf rdodi-page:enforcesDomainConstraint .

rdodi-page:hasSourceProvenancePropertyShape a sh:NodeShape ;
    rdfs:label "hasSourceProvenance property shape"@en ;
    sh:property [ sh:class rdodi-page:SourceProvenance ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdodi-page:hasSourceProvenance ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf rdodi-page:hasSourceProvenance .

rdodi-page:primarySourceConceptCoveragePropertyShape a sh:NodeShape ;
    rdfs:label "primarySourceConceptCoverage property shape"@en ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxInclusive 1.0 ;
            sh:minInclusive 0.0 ;
            sh:path rdodi-page:primarySourceConceptCoverage ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf rdodi-page:primarySourceConceptCoverage .

<http://example.org/rdodi/interactive-page-ontology/shacl> a owl:Ontology ;
    rdfs:label "RDODI Interactive Page Ontology shacl v1.1.0"@en ;
    dcterms:created "2026-05-20"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "RDODI Interactive Page Ontology shacl. Part of the four-subject RDODI ecosystem: Research, Domain, Document, Interactive Page."@en ;
    dcterms:identifier "interactive_page_ontology_shacl_v1_1_0" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-07"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    rdfs:comment "RDODI shacl for the Interactive Page Ontology. Derived from 04-web-page-construction/web_page_construction_shacl_v7_0_0.ttl (SHA-256 f64761d64245165fa646343a17699ee856bec69384fedef43ae47a7897311a75)."@en ;
    owl:versionIRI <http://example.org/rdodi/interactive-page-ontology/shacl/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <http://example.org/rdodi/interactive-page-ontology/shacl/1.0.1> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/rdodi/activity/RDODIOrigination_v1_0_1> .

# ---- v1.1.0 addition: Path A (full) — DownloadableResource wiring shapes ----
rdodi-page:DownloadableResource_LocationShape a sh:NodeShape ;
    rdfs:label "DownloadableResource must have a resourceLocation"@en ;
    sh:targetClass rdodi-page:DownloadableResource ;
    sh:property [ sh:message "DownloadableResource SHOULD have exactly one resourceLocation."@en ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:path rdodi-page:resourceLocation ;
            sh:severity sh:Warning ] .

rdodi-page:Page_DownloadableResourceShape a sh:NodeShape ;
    rdfs:label "hasDownloadableResource must point to a real DownloadableResource"@en ;
    sh:targetSubjectsOf rdodi-page:hasDownloadableResource ;
    sh:property [ sh:message "hasDownloadableResource SHOULD point to an individual typed DownloadableResource."@en ;
            sh:class rdodi-page:DownloadableResource ;
            sh:path rdodi-page:hasDownloadableResource ;
            sh:severity sh:Warning ] .

[] sh:maxCount 1 ;
    sh:message "Finding MUST have exactly one severity (Pass/Warning/Violation)." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation .

[] sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:datatype xsd:string ;
    sh:message "Finding MUST cite evidence supporting its verdict." ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:maxCount 1 ;
    sh:message "AssessmentReport MUST identify exactly one Page assessed." ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:message "AssessmentReport MUST have at least one Finding." ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:datatype xsd:nonNegativeInteger ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:datatype xsd:nonNegativeInteger ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:severity sh:Violation .

[] sh:datatype xsd:double ;
    sh:maxCount 1 ;
    sh:maxInclusive 100.0 ;
    sh:minCount 1 ;
    sh:minInclusive 0.0 ;
    sh:severity sh:Violation .

[] sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdodi-page:abbreviationToken .

[] sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdodi-page:abbreviationExpansion .

[] sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:path rdodi-page:firstUseSentence .

[] sh:message "Instance of AnchorLinks SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of ArticleLayout SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of Aside SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of Breadcrumbs SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of CardLayout SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of ContentRegion SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of ContextualPopup SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] sh:message "Instance of CrossReference SHOULD have at least one rdfs:label."@en ;
    sh:minCount 1 ;
    sh:path rdfs:label ;
    sh:severity sh:Warning .

[] rdf:first [ sh:minCount 1 ;
            sh:path rdodi-page:findingEvidence ] ;
    rdf:rest ( [ sh:minCount 1 ;
                sh:path rdodi-page:findingCitedBy ] ) .

[] sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:path rdodi-page:hypothesisFalsifiabilityCriterion ;
    sh:severity sh:Violation .

[] sh:in ( "supported" "partially-supported" "not-supported" "inconclusive" ) ;
    sh:minCount 1 ;
    sh:path rdodi-page:hypothesisTestVerdict ;
    sh:severity sh:Violation .

[] sh:class rdodi-page:Finding ;
    sh:minCount 1 ;
    sh:path rdodi-page:hypothesisEvidence ;
    sh:severity sh:Violation .

[] sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:path rdodi-page:reportSectionOrder ;
    sh:pattern "Abstract.*Introduction.*Methods.*Findings.*Discussion.*Limitations.*References" ;
    sh:severity sh:Violation .

[] sh:datatype xsd:positiveInteger ;
    sh:minCount 1 ;
    sh:path rdodi-page:abstractWordLimit ;
    sh:severity sh:Violation .

[] sh:datatype xsd:nonNegativeInteger ;
    sh:minCount 1 ;
    sh:path rdodi-page:abstractWordCount ;
    sh:severity sh:Violation .

[] sh:or ( [ sh:pattern "^\\([A-Z][A-Za-z0-9\\-\\s\\.&]+( et al\\.)?,\\s+\\d{4}[a-z]?\\)$" ] [ sh:pattern "^\\[\\d+\\]$" ] [ sh:pattern "^\\(\\d+\\)$" ] ) ;
    sh:path rdodi-page:inlineCitationKey ;
    sh:severity sh:Violation .

[] sh:class rdodi-page:CitationStyle ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdodi-page:usesCitationStyle ;
    sh:severity sh:Violation .

[] sh:class rdodi-page:ReferenceList ;
    sh:minCount 1 ;
    sh:path rdodi-page:hasReferenceList ;
    sh:severity sh:Violation .

[] sh:in ( "chronological" "alphabetical" "citation-order" ) ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path rdodi-page:referenceOrdering ;
    sh:severity sh:Violation .

[] sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path dcterms:license ;
    sh:severity sh:Violation .

[] rdf:first [ sh:minCount 1 ;
            sh:path prov:wasGeneratedBy ] ;
    rdf:rest ( [ sh:minCount 1 ;
                sh:path prov:wasDerivedFrom ] [ sh:minCount 1 ;
                sh:path prov:wasRevisionOf ] ) .

