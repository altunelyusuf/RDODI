rdodi-page:Cap_Animation_AccessibilityCompliance_Required_Shape a sh:NodeShape ;
    rdfs:label "Capability quality implication: Cap_Animation → AccessibilityCompliance (Required)"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2.md §5 (Cap_Animation quality implications)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Severity=Required → SHACL sh:Violation."@en ;
    sh:message "Page declares Cap_Animation but lacks QualityAssessment along AccessibilityCompliance (Required). prefers-reduced-motion media query honored"@en ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf rdodi-page:declaresCapability .

rdodi-page:Cap_Animation_PerformanceOptimization_Recommended_Shape a sh:NodeShape ;
    rdfs:label "Capability quality implication: Cap_Animation → PerformanceOptimization (Recommended)"@en ;
