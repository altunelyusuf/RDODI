rdodi-page:APIFirstCMS_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for APIFirstCMS"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of APIFirstCMS SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:APIFirstCMS .

