rdodi-page:CategorisationGameShape a sh:NodeShape ;
    rdfs:label "CategorisationGame skeleton + semantic"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:message "CategorisationGame SHOULD demonstrate at least 2 categories (otherwise there is nothing to sort between)."@en ;
            sh:minCount 2 ;
            sh:path rdodi-page:demonstratesSubject ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:CategorisationGame .

rdodi-page:ChapterOrganization_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for ChapterOrganization"@en ;
    sh:property [ sh:message "Instance of ChapterOrganization SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:ChapterOrganization .

rdodi-page:CitableArtifact_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for CitableArtifact"@en ;
    sh:property [ sh:message "Instance of CitableArtifact SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:CitableArtifact .

rdodi-page:ClientRendering_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for ClientRendering"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of ClientRendering SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:ClientRendering .

rdodi-page:ClientSideRendering_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for ClientSideRendering"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of ClientSideRendering SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:ClientSideRendering .

rdodi-page:CollapsibleHierarchyViewerShape a sh:NodeShape ;
    rdfs:label "CollapsibleHierarchyViewer skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:CollapsibleHierarchyViewer .

rdodi-page:ContentManagementSystem_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for ContentManagementSystem"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of ContentManagementSystem SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:ContentManagementSystem .

rdodi-page:CoreWebVitalAssessmentShape a sh:NodeShape ;
    rdfs:label "Core Web Vital Assessment Shape"@en ;
    rdfs:comment "Enforces measurement structure on QualityAssessment individuals that target PerformanceOptimization."@en ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path rdodi-page:hasMeasuredValue ;
            sh:severity sh:Violation ] ;
    sh:targetSubjectsOf rdodi-page:hasMeasuredValue .

rdodi-page:CoupledVariableDemonstratorShape a sh:NodeShape ;
    rdfs:label "CoupledVariableDemonstrator semantic"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:enforcesDomainConstraint ;
            sh:severity sh:Violation ] ;
    sh:targetClass rdodi-page:CoupledVariableDemonstrator .

rdodi-page:DecoupledCMS_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for DecoupledCMS"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of DecoupledCMS SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:DecoupledCMS .

rdodi-page:DeploymentModel_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for DeploymentModel"@en ;
    rdfs:comment "Authored as part of v2.0.0 trio-conformance placeholder pass."@en ;
    sh:property [ sh:message "Instance of DeploymentModel SHOULD have at least one rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:DeploymentModel .

rdodi-page:DiagramAnnotationShape a sh:NodeShape ;
    rdfs:label "DiagramAnnotation skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:DiagramAnnotation .

rdodi-page:DialoguePrincipleSourceShape a sh:NodeShape ;
    rdfs:label "Dialogue Principle must cite ISO 9241-110"@en ;
    sh:property [ sh:message "DialoguePrinciple MUST cite its source (e.g., ISO 9241-110)." ;
            sh:minCount 1 ;
            sh:path dcterms:source ;
            sh:severity sh:Violation ] ;
    sh:targetClass rdodi-page:DialoguePrinciple .

rdodi-page:InstructionalWidgetShape a sh:NodeShape ;
    rdfs:label "InstructionalWidget skeleton + semantic"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:demonstratesSubject ;
            sh:severity sh:Violation ],
        [ sh:minCount 0 ;
            sh:path rdodi-page:enforcesDomainConstraint ;
            sh:severity sh:Info ] ;
    sh:targetClass rdodi-page:InstructionalWidget .

rdodi-page:InteractiveLearningSurfaceShape a sh:NodeShape ;
    rdfs:label "InteractiveLearningSurface skeleton + semantic"@en ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:hasSourceDocument ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path rdodi-page:hasSemanticRegion ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:InteractiveLearningSurface .

rdodi-page:MeasuredValueStructureShape a sh:NodeShape ;
    rdfs:label "Measured Value Structure Shape"@en ;
    rdfs:comment "A MeasuredValue MUST carry a numeric value and a unit."@en ;
    sh:property [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:message "MeasuredValue MUST have exactly one xsd:double numericMeasuredValue." ;
            sh:minCount 1 ;
            sh:path rdodi-page:numericMeasuredValue ;
            sh:severity sh:Violation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "MeasuredValue MUST have exactly one unitOfMeasure (e.g., 'ms', 'score-0-100', 'ratio')." ;
            sh:minCount 1 ;
            sh:path rdodi-page:unitOfMeasure ;
            sh:severity sh:Violation ] ;
    sh:targetClass rdodi-page:MeasuredValue .

rdodi-page:PageIndustrialUXShape a sh:NodeShape ;
    rdfs:label "Page Industrial UX Shape"@en ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:includesNavigationPattern ;
            sh:severity sh:Warning ],
        [ sh:minCount 5 ;
            sh:path rdodi-page:satisfiesHeuristic ;
            sh:severity sh:Violation ],
        [ sh:minCount 1 ;
            sh:path rdodi-page:hasLifecycleState ;
            sh:severity sh:Warning ],
        [ sh:message "Industrial-UX baseline." ;
            sh:minCount 1 ;
            sh:path rdodi-page:hasLayoutPattern ;
            sh:severity sh:Violation ],
        [ sh:minCount 1 ;
            sh:path rdodi-page:hasSemanticRegion ;
            sh:severity sh:Violation ] .

rdodi-page:PageWithSourceShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:coversChapterSection ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path rdodi-page:coversLearningObjective ;
            sh:severity sh:Warning ],
        [ sh:minCount 1 ;
            sh:path rdodi-page:coversCaseStudy ;
            sh:severity sh:Warning ],
        [ sh:message "Page with a SourceDocument SHOULD render at least one equivalent of a source Figure (own SVG, animation, or interactive)."@en ;
            sh:minCount 1 ;
            sh:path rdodi-page:depictsSourceFigure ;
            sh:severity sh:Warning ] ;
    sh:targetSubjectsOf rdodi-page:hasSourceDocument .

rdodi-page:Page_Shape a sh:NodeShape ;
    rdfs:label "Minimal quality shape for Page"@en ;
    sh:property [ sh:message "Representative Page instance SHOULD carry an rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:Page .

rdodi-page:ParametricCalculatorShape a sh:NodeShape ;
    rdfs:label "ParametricCalculator skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:ParametricCalculator .

rdodi-page:PrimarySourceCoverageShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "Surfaces gap between intrinsic pipeline metrics (interactivity, JS LOC, SHACL conformance) and content-fidelity to the named primary source."@en ;
            sh:minInclusive 0.8 ;
            sh:path rdodi-page:primarySourceConceptCoverage ;
            sh:severity sh:Warning ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:path rdodi-page:primarySourceConceptInventorySize ;
            sh:severity sh:Info ] ;
    sh:targetClass rdodi-page:InteractiveLearningSurface .

rdodi-page:PrimarySourceProvenanceShape a sh:NodeShape ;
    rdfs:label "PrimarySourceProvenance skeleton"@en ;
    sh:nodeKind sh:IRI ;
    sh:targetClass rdodi-page:PrimarySourceProvenance .

