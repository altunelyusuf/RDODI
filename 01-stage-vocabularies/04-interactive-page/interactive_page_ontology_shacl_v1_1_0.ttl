    skos:definition "Severity=Recommended → SHACL sh:Warning."@en ;
    sh:message "Page declares Cap_Animation but lacks QualityAssessment along PerformanceOptimization (Recommended). CPU/GPU impact of complex animations"@en ;
    sh:severity sh:Warning ;
    sh:targetSubjectsOf rdodi-page:declaresCapability .

