rdodi-page:BookChapterShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:path rdodi-page:hasChapterSection ;
            sh:severity sh:Violation ],
        [ sh:message "BookChapter SHOULD declare its Learning Objectives (most educational textbooks do)."@en ;
            sh:minCount 1 ;
            sh:path rdodi-page:hasLearningObjective ;
            sh:severity sh:Warning ] ;
    sh:targetClass rdodi-page:BookChapter .

