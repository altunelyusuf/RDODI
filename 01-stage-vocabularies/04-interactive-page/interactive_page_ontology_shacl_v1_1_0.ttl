    sh:message "Page declares Cap_ThreeDScene but lacks QualityAssessment along PerformanceOptimization (Required). 3D rendering is GPU-intensive — significant impact"@en ;
    sh:severity sh:Violation ;
    sh:targetSubjectsOf rdodi-page:declaresCapability .

