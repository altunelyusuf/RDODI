@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ipo: <http://example.org/rdodi/interactive-page-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdodi-document: <http://example.org/rdodi/document-ontology#> .
@prefix rdodi-research: <http://example.org/rdodi/research-ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ipo:APA7e a ipo:CitationStyle,
        owl:NamedIndividual ;
    rdfs:label "APA Publication Manual 7e (author-date)"@en ;
    dcterms:source "American Psychological Association (2020). Publication Manual of the American Psychological Association (7th ed.). APA."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

ipo:Accordion a owl:Class ;
    rdfs:label "Accordion (collapsible content panel)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Collapsible vertical stack of sections; only one or many open at a time."@en .

ipo:AnchorLinks a owl:Class ;
    rdfs:label "anchor links"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Within-page navigation to specific section anchors."@en .

ipo:Animation a owl:Class ;
    rdfs:label "Animation"@en ;
    dcterms:source "user's literal feature specification ('interaction options with animations'); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S3."@en ;
    skos:definition "A time-based motion or micro-interaction effect (transition, easing, keyframe sequence) applied to a page element. Root class -- no existing motion-related parent found in the corpus."@en .

ipo:ApplicationState a owl:Class ;
    rdfs:label "application state"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Persistent UI state that survives navigation between ApplicationViews."@en .

ipo:ApplicationView a owl:Class ;
    rdfs:label "application view"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A self-contained view within an application (analogous to a 'route' in SPA frameworks)."@en .

ipo:ApprovalWorkflow a owl:Class ;
    rdfs:label "approval workflow"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Multi-stage approval chain for content/decisions."@en .

ipo:ArticleLayout a owl:Class ;
    rdfs:label "article layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Long-form text-centric reading layout with optional sidebar."@en .

ipo:Aside a owl:Class ;
    rdfs:label "aside"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "Tangentially related content (callouts, related-articles, advertisements)."@en .

ipo:AuditTrailEntry a owl:Class ;
    rdfs:label "audit trail entry"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Recorded action by an authenticated user. Aligns to prov:Activity for tamper-evidence."@en .

ipo:AuthorizationScope a owl:Class ;
    rdfs:label "authorization scope"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Explicit role-based content visibility specification for a Page or feature."@en .

ipo:BookChapter a owl:Class ;
    rdfs:label "Book Chapter"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SourceDocument ;
    skos:definition "A chapter of a published textbook or monograph."@en .

ipo:Breadcrumb a owl:Class ;
    rdfs:label "Breadcrumb"@en ;
    dcterms:source "InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S1."@en ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "A horizontal trail showing the current page's ancestor chain within the PageHierarchy, each segment a clickable link to that ancestor. Distinct from CurrentLocationIndicator (which marks position within a single view) -- a breadcrumb shows the full navigable path."@en .

ipo:Breadcrumbs a owl:Class ;
    rdfs:label "breadcrumbs"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Hierarchical position trail showing the current page's location within the PageHierarchy."@en .

ipo:Button a owl:Class ;
    rdfs:label "Button"@en ;
    dcterms:source "WAI-ARIA role=button; HTML5 <button>; Material Design Button; Apple HIG Button"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Action-triggering control. Activated by click, tap, Enter, or Space."@en .

ipo:CallToAction a owl:Class ;
    rdfs:label "call to action"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "UI element directing user toward conversion."@en .

ipo:Canvas2DVisualization a owl:Class ;
    rdfs:label "2D Canvas Visualization"@en ;
    dcterms:source "user's literal feature specification ('graphics and visual components in two ... dimensions'); Package S3."@en ;
    skos:definition "A graphics/visual component rendered in a 2-dimensional drawing surface (HTML5 canvas or SVG), as distinct from 3D. Root class, peer to ThreeDimensionalVisualization -- deliberately no shared artificial parent (would exceed the roadmap's 6-class commitment; matches the corpus's own established flat-hierarchy pattern)."@en .

ipo:Cap_UsabilityMetering_CoreWebVitalsMeter a owl:Class ;
    rdfs:label "Cap_UsabilityMetering_CoreWebVitalsMeter"@en ;
    dcterms:source "web-vitals library by Google Chrome team; PerformanceObserver API"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Cap_UsabilityMetering ;
    skos:definition "Collects LCP, INP, CLS, FCP, TTFB at runtime via PerformanceObserver. The page either embeds the metering script or declares it as a planned instrumentation point."@en .

ipo:Cap_UsabilityMetering_RealUserMonitor a owl:Class ;
    rdfs:label "Cap_UsabilityMetering_RealUserMonitor"@en ;
    dcterms:source "RUM (Real User Monitoring) industry practice; Datadog/New Relic/SpeedCurve telemetry"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Cap_UsabilityMetering ;
    skos:definition "Captures end-to-end real-user telemetry: device class, network conditions, geolocation (privacy-respecting), session duration, interaction depth. May be aggregated externally."@en .

ipo:Cap_UsabilityMetering_SUSCollector a owl:Class ;
    rdfs:label "Cap_UsabilityMetering_SUSCollector"@en ;
    dcterms:source "Brooke (1996) System Usability Scale"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Cap_UsabilityMetering ;
    skos:definition "Presents the 10-item SUS questionnaire to the user and records the resulting 0-100 score. May be presented after task completion or at session end."@en .

ipo:Cap_UsabilityMetering_TaskRecorder a owl:Class ;
    rdfs:label "Cap_UsabilityMetering_TaskRecorder"@en ;
    dcterms:source "ISO 9241-11:2018 task-efficacy framing"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Cap_UsabilityMetering ;
    skos:definition "Used to compute task-completion rate and time-on-task."@en .

ipo:CardLayout a owl:Class ;
    rdfs:label "card layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Content units displayed as discrete cards (image + title + summary)."@en .

ipo:Carousel a owl:Class ;
    rdfs:label "Carousel (rotating content slider)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Horizontally-paged content with manual or auto-advance."@en .

ipo:CategorisationGame a owl:Class ;
    rdfs:label "Categorisation Game"@en ;
    dcterms:source "WPC v6.1.0 — pattern generalised from COM0463 Ch.5 scope-concern sorter (grope/creep/leap) and deliverable-vs-milestone sorter."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "InstructionalWidget presenting a set of items and a set of categories; the learner sorts items into categories with immediate correct/incorrect feedback. A CategorisationGame's correctness function MUST derive from the domain ontology, not from author-chosen 'right answers' that drift from the ontology."@en .

ipo:ChapterOrganization a owl:Class ;
    rdfs:label "chapter organization"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Book/course chapter structure. Links to Report's :ReportStructure (cross-ontology)."@en .

ipo:ChartWidget a owl:Class ;
    rdfs:label "Chart Widget"@en ;
    dcterms:source "gap-analysis addition (not the user's literal spec, though closely adjacent to their 'graphics and visual components' request); Package S3."@en ;
    skos:definition "A data-driven chart or graph visualization (bar/line/scatter/network). Root class, consistent with ipo:DataTable's placement (S2) -- data-presentation widgets, not concept-enforcing InstructionalWidgets."@en .

ipo:CheckBox a owl:Class ;
    rdfs:label "CheckBox"@en ;
    dcterms:source "WAI-ARIA role=checkbox; HTML5 <input type='checkbox'>; Material Design Checkbox"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Independent on/off toggle; supports zero-or-more selection across a group."@en .

ipo:ChicagoAuthorDate a ipo:CitationStyle,
        owl:NamedIndividual ;
    rdfs:label "Chicago Manual of Style 17e (author-date)"@en ;
    dcterms:source "The Chicago Manual of Style 17e (2017), §15 Author-Date References."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

ipo:CitableArtifact a owl:Class ;
    rdfs:label "citable artifact"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Artifact has a citation block (DOI, BibTeX) for academic citation."@en .

ipo:ClientSideRouter a owl:Class ;
    rdfs:label "client-side router"@en ;
    dcterms:source "W3C HTML history/hashchange; WAI-ARIA aria-current. Reuses rdodi-page:AnchorLinks as the no-script fallback."@en ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "A client-side hash/history router that resolves the current location to exactly one ApplicationView, hides the others, and synchronizes the active-location indicators (menu aria-current, tree aria-selected, sub-tab aria-current). No server round-trip; degrades to anchor links when scripting is unavailable."@en .

ipo:CollapsibleHierarchyViewer a owl:Class ;
    rdfs:label "Collapsible Hierarchy Viewer"@en ;
    dcterms:source "WPC v6.1.0 — pattern generalised from COM0463 Ch.5 Deliverable Structure Chart (DSC) tree."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "InstructionalWidget displaying a hierarchical structure (taxonomy, WBS, deliverable hierarchy, classification scheme) with click-to-expand/collapse nodes. Keyboard accessibility required: Enter/Space toggles a node, arrow keys navigate siblings/parent/child."@en .

ipo:CommandPalette a owl:Class ;
    rdfs:label "command palette"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Keyboard-driven action launcher (e.g., Ctrl+K)."@en .

ipo:ComplianceTag a owl:Class ;
    rdfs:label "compliance tag"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "KVKK, GDPR, sectoral regulatory marking."@en .

ipo:ContentHub a owl:Class ;
    rdfs:label "content hub"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Taxonomy-organized content collection (blog index, resource library)."@en .

ipo:ContextMenu a owl:Class ;
    rdfs:label "context menu"@en ;
    dcterms:source "W3C-WAI ARIA role=menu; WAI-ARIA APG Menu keyboard model. Reconciles interactive_page_ontology_tbox_v1_0_2 (vendored) into canonical; Menu already subsumes context menus."@en ;
    rdfs:subClassOf ipo:Menu ;
    skos:definition "A menu of context actions for a focused section, opened by the contextmenu event or the Shift+F10 / ContextMenu key, dismissed by Escape with focus returned to the originating element."@en .

ipo:ContextualPopup a owl:Class ;
    rdfs:label "contextual popup"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Content-aware triggered popup."@en .

ipo:CopyCitationButton a owl:Class ;
    rdfs:label "Copy Citation Button"@en ;
    dcterms:source "gap-analysis addition (not the user's literal spec); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md, Package S4, roadmap G5."@en ;
    skos:definition "A button that copies a formatted citation of THIS artifact itself (in the reader's choice of citation form) to the clipboard -- distinct from ipo:CopyCodeButton (S2, copies code) and ipo:CitationLink (jumps to a reference, does not copy)."@en .

ipo:CopyCodeButton a owl:Class ;
    rdfs:label "Copy Code Button"@en ;
    dcterms:source "gap-analysis addition (not the user's literal spec); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md, Package S2; deviates from the roadmap's literal 'CodeBlock+CopyCodeButton' phrasing per BP-D7 change control, disclosed in CHANGELOG."@en ;
    skos:definition "A button adjacent to an ipo:CodeExample that copies its listing to the clipboard. Deliberately reuses the EXISTING ipo:CodeExample class rather than duplicating it as a new 'CodeBlock' (the roadmap's original wording) -- caught by the L-64 non-duplication check before authoring, not after."@en .

ipo:CoreWebVital a owl:Class ;
    rdfs:label "Core Web Vital"@en ;
    dcterms:source "Google Core Web Vitals (2024 thresholds); web.dev/vitals"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MeasurementInstrument ;
    skos:definition "A Google-defined performance metric: LCP, INP, CLS, FCP, or TTFB. Each has a standard target threshold value."@en .

ipo:CoupledVariableDemonstrator a owl:Class ;
    rdfs:label "Coupled Variable Demonstrator"@en ;
    dcterms:source "WPC v6.1.0 — pattern generalised from COM0463 Ch.5 equilateral-coupling triple-constraint widget."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "InstructionalWidget that demonstrates a coupled-variable construct (e.g., triple constraint, supply-demand, conservation laws, fixed-budget-with-quality-tradeoff). Input controls for the n coupled variables MUST enforce the coupling — independent variation MUST be mechanically impossible. Distinguished from a generic multi-slider widget by enforcement; a widget with three independent sliders that visualises scope/schedule/budget is NOT a CoupledVariableDemonstrator even if it displays a triangle, because it permits independent variation."@en .

ipo:CrossChapterReference a owl:Class ;
    rdfs:label "cross chapter reference"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Internal book navigation between chapters."@en .

ipo:CurrentLocationIndicator a owl:Class ;
    rdfs:label "current location indicator"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "'You are here' highlighting in navigation patterns."@en .

ipo:DashboardLayout a owl:Class ;
    rdfs:label "dashboard layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Multiple data widgets arranged for at-a-glance scanning."@en .

ipo:DataMutationOperation a owl:Class ;
    rdfs:label "data mutation operation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An operation that modifies persisted state."@en .

ipo:DataTable a owl:Class ;
    rdfs:label "Data Table"@en ;
    dcterms:source "gap-analysis addition (not the user's literal spec); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md, Package S2."@en ;
    skos:definition "A sortable/filterable tabular data display. Deliberately NOT placed under ipo:InstructionalWidget -- a generic data table does not inherently enforce domain semantics the way InstructionalWidget's own definition requires; placed as a root class, matching the existing precedent of ipo:KeyboardShortcut (also root, no forced parent)."@en .

ipo:DataValidationRule a owl:Class ;
    rdfs:label "data validation rule"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Rule constraining user input integrity."@en .

ipo:DemoTopic a owl:Class ;
    rdfs:label "demo topic"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The concept or result being demonstrated."@en .

ipo:DiagramAnnotation a owl:Class ;
    rdfs:label "Annotated Diagram"@en ;
    dcterms:source "WPC v6.1.0 — pattern generalised from COM0463 Ch.5 Use Case Diagram SVG (Marchewka Fig 5.5)."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "InstructionalWidget combining an SVG diagram with focusable annotated regions. Each region carries tabindex, ARIA role, and aria-label; focus or click reveals detail."@en .

ipo:DialoguePrinciple a owl:Class ;
    rdfs:label "Dialogue Principle"@en ;
    dcterms:source "ISO 9241-110:2020 — Ergonomics of human-system interaction — Part 110: Interaction principles"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Normative interaction principle from ISO 9241-110. A Page MAY claim to satisfy both families."@en .

ipo:DifferentiatedNodeIconography a owl:Class ;
    rdfs:label "differentiated node iconography"@en ;
    dcterms:source "W3C-WAI ARIA APG Tree View (group vs item semantics); desktop file-explorer disclosure convention."@en ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Explorer-tree iconography that visually differentiates node level: parent nodes carry a folder icon whose open/closed state is bound to expansion (aria-expanded); leaf nodes carry a document icon. Aids orientation by encoding hierarchy in the glyph. Icons are original vector art (no third-party assets)."@en .

ipo:DownloadableResource a owl:Class ;
    rdfs:label "downloadable resource"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Supplementary downloadable material (PDF, dataset, code)."@en .

ipo:Drawer a owl:Class ;
    rdfs:label "Drawer (slide-out navigation/content panel)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Side-sliding panel for secondary content; modal or non-modal."@en .

ipo:Dropdown rdfs:subClassOf ipo:Menu ;
    skos:definition "Collapsible menu revealing options on activation."@en .

ipo:EmptyState a owl:Class ;
    rdfs:label "Empty State"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "UI pattern: placeholder content displayed when a list, table, or content area has no data. Typically combines an icon, brief message, and a call-to-action."@en .

ipo:FacetedNavigation a owl:Class ;
    rdfs:label "faceted navigation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Filter-driven navigation along multiple independent attribute facets (e.g., category × date × tag)."@en .

ipo:FocusIndicator a owl:Class ;
    rdfs:label "focus indicator"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Visible keyboard focus indicator."@en .

ipo:Footer a owl:Class ;
    rdfs:label "footer"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "The bottom landmark of a Page (legal, contact, secondary navigation)."@en .

ipo:GalleryLayout a owl:Class ;
    rdfs:label "gallery layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Image-centric layout with thumbnail navigation."@en .

ipo:GlossaryEntry a owl:Class ;
    rdfs:label "glossary entry"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Domain-term definition. Consumes Report's offersConceptDefinitions when available."@en .

ipo:GridLayout a owl:Class ;
    rdfs:label "grid layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Items arranged in a grid (rows × columns)."@en .

ipo:Header a owl:Class ;
    rdfs:label "header"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "The introductory or navigational landmark at the top of a Page."@en .

ipo:HeadingMarker a owl:Class ;
    rdfs:label "heading marker"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A section marker as an information-architecture unit (NOT a document-element title). Semantic-only — does NOT prescribe HTML rendering."@en .

ipo:HeroLayout a owl:Class ;
    rdfs:label "hero layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Large prominent above-the-fold region with secondary content below."@en .

ipo:HoverPreview a owl:Class ;
    rdfs:label "hover preview"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Preview of linked content on hover."@en .

ipo:IEEE a ipo:CitationStyle,
        owl:NamedIndividual ;
    rdfs:label "IEEE Editorial Style Manual"@en ;
    dcterms:source "IEEE (2024). IEEE Editorial Style Manual for Authors."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

ipo:ISO690 a ipo:CitationStyle,
        owl:NamedIndividual ;
    rdfs:label "ISO 690:2021"@en ;
    dcterms:source "ISO 690:2021 Information and documentation — Guidelines for bibliographic references."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

ipo:Icon a owl:Class ;
    rdfs:label "Icon"@en ;
    dcterms:source "HTML5 <svg> and <img>; Material Icons; Apple SF Symbols; Microsoft Fluent Icons. Decorative icons use aria-hidden; semantic icons use aria-label."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Pictographic UI element. May convey meaning (semantic) or be purely decorative."@en .

ipo:InteractiveElement a owl:Class ;
    rdfs:label "interactive element"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The primary interactive concept of the demo (vs. static illustration)."@en .

ipo:InteractiveHTMLSurface a owl:Class ;
    rdfs:label "Interactive HTML Surface"@en ;
    dcterms:source "RDODI_Goal_and_Profile_Charter_v1_0_0.md's own disclosed generalization gap; InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S0."@en ;
    rdfs:subClassOf ipo:Page ;
    skos:definition "A Page rendering ANY genre's content (not bound to instructional units, unlike ipo:InteractiveLearningSurface) as a rich, interactive HTML artifact -- genre-neutral by design, per the RDODI Goal and Profile Charter's own open item that InteractiveLearningSurface is 'one surface, not the only one.' Its widget/pattern composition is declared via rva:MandatoryWidgetRule/OptionalWidgetRule, not hardcoded per genre."@en .

ipo:InternalDocumentation a owl:Class ;
    rdfs:label "internal documentation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Embedded help specific to internal employee context."@en .

ipo:JavaScriptEngine a owl:Class ;
    rdfs:label "JavaScript Engine"@en ;
    dcterms:source "Package S8, taxonomy of RunnableCodeTool."@en ;
    rdfs:subClassOf ipo:RunnableCodeTool ;
    skos:definition "A RunnableCodeTool alternative executing sandboxed JavaScript directly (native to the browser, no interpreter needed) -- the lowest-friction alternative, useful for algorithm/data-transform demos."@en .

ipo:KeyboardShortcut a owl:Class ;
    rdfs:label "keyboard shortcut"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "First-class keyboard interaction (e.g., Ctrl+S to save)."@en .

ipo:LandingPageVariant a owl:Class ;
    rdfs:label "landing page variant"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An A/B test variant of a landing Page."@en .

ipo:LeadCaptureForm a owl:Class ;
    rdfs:label "lead capture form"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Form ;
    skos:definition "Form designed for lead generation."@en .

ipo:LearningResourceMetadata a owl:Class ;
    rdfs:label "learning resource metadata"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "schema.org/LearningResource alignment for OER discoverability."@en .

ipo:LightMode a owl:Class ;
    rdfs:label "Light Mode"@en ;
    dcterms:source "user's literal feature specification; Package S3."@en ;
    skos:definition "The default visual theme -- light background, dark text. The always-present baseline theme; ipo:ThemeSwitcher (offering alternatives, including a dark theme) is Optional on top of this Mandatory default, exactly matching the user's literal wording ('light is a default, ... optionally multiple-themes')."@en .

ipo:ListBox a owl:Class ;
    rdfs:label "ListBox"@en ;
    dcterms:source "WAI-ARIA role=listbox; HTML5 <select size='2+'>; Material Design Menu in listbox mode"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Always-visible enumerated selection. Distinct from Dropdown (which collapses options)."@en .

ipo:LoadingSpinner a owl:Class ;
    rdfs:label "Loading Spinner"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "UI pattern: indeterminate progress indicator shown during asynchronous operations to signal that the system is working."@en .

ipo:MainContent a owl:Class ;
    rdfs:label "main content"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "The principal content of a Page, distinct from header/footer/sidebar."@en .

ipo:MarketingAttribution a owl:Class ;
    rdfs:label "marketing attribution"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "UTM parameters, source tracking — links a Page visit to its acquisition channel."@en .

ipo:MathRendering a owl:Class ;
    rdfs:label "Math Rendering"@en ;
    dcterms:source "gap-analysis addition (not the user's literal spec); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md, Package S2."@en ;
    skos:definition "Typeset mathematical notation (LaTeX/MathML) rendered inline or in display blocks. Placed as a root class, same reasoning as DataTable -- notation rendering is not itself concept-enforcing pedagogy."@en .

ipo:Modal rdfs:subClassOf ipo:Dialog ;
    skos:definition "Overlay dialog requiring user interaction before returning to the page underneath."@en .

ipo:NavigationContext a owl:Class ;
    rdfs:label "navigation context"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A derived view that combines PageHierarchy and CrossReferences to produce, for a given Page: breadcrumb path, related-content list, sibling list, parent context. Derived (materialized at query time), not asserted."@en .

ipo:NavigationLandmark a owl:Class ;
    rdfs:label "navigation landmark"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "An explicit navigation region (HTML5 nav element). Distinct from PrimaryNavigation pattern."@en .

ipo:OfflineCapability a owl:Class ;
    rdfs:label "offline capability"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Functionality that can continue without network connection."@en .

ipo:OutboundLinkInventory a owl:Class ;
    rdfs:label "outbound link inventory"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.6"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A derived inventory of outbound URL links from a Page or WPCArtifact, used for SEO and dead-link checking. Per §3.6 lock-in, Core does NOT model typed cross-artifact relationships — outbound links are plain URL strings."@en .

ipo:OverflowTabBar a owl:Class ;
    rdfs:label "overflow tab bar"@en ;
    dcterms:source "W3C-WAI ARIA role=menubar with aria-current; horizontal-overflow scroll-container convention. Refines rdodi-page:PrimaryNavigation presentation."@en ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "A single-row primary-navigation bar that scrolls horizontally on overflow instead of wrapping to additional rows, with an edge-fade overflow cue and an underline active-route indicator. Keeps the primary menu legible and stable across widths without reflowing the header."@en .

ipo:PageHierarchy a owl:Class ;
    rdfs:label "page hierarchy"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The tree structure relating Pages. Drives breadcrumbs, sitemaps, and primary navigation. Each Page has at most one parent (root pages have no parent)."@en .

ipo:Pagination a owl:Class ;
    rdfs:label "pagination"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Navigation between sequential pages (page 1, 2, 3 …) or between adjacent siblings."@en .

ipo:ParameterControl a owl:Class ;
    rdfs:label "parameter control"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "User-adjustable parameter that affects the demo's behavior."@en .

ipo:ParametricCalculator a owl:Class ;
    rdfs:label "Parametric Calculator"@en ;
    dcterms:source "WPC v6.1.0 — pattern generalised from COM0463 Ch.5 PERT, COCOMO II, Function Points, 17-day WBS bottom-up, and Death March detector widgets."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "InstructionalWidget where the learner manipulates input parameters and observes a computed output via a domain formula. Used for estimation methods, formula visualisation, sensitivity analysis, threshold detectors. Distinguished from a generic spreadsheet by domain-specific labelling, constrained input ranges (per the domain), and named-formula transparency (the formula appears alongside the result, e.g., 'E = (O + 4M + P) / 6')."@en .

ipo:PracticeExercise a owl:Class ;
    rdfs:label "practice exercise"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Non-graded practice exercise. Links to Report's :Exercise (cross-ontology)."@en .

ipo:PrimaryNavigation a owl:Class ;
    rdfs:label "primary navigation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Main top-level navigation between major sections of the artifact."@en .

ipo:ProgressIndicator a owl:Class ;
    rdfs:label "progress indicator"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Load, multi-step, or scroll progress visualization."@en .

ipo:ProgressTracking a owl:Class ;
    rdfs:label "progress tracking"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Learner progress through content (without LMS-grade tracking)."@en .

ipo:ProvenanceBadge a owl:Class ;
    rdfs:label "Provenance Badge"@en ;
    dcterms:source "RDODI-native suggestion (not the user's literal spec); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S5, roadmap G5."@en ;
    skos:definition "A small UI element surfacing a generated artifact's REAL provenance -- dcterms:source and/or prov:wasGeneratedBy -- inline, as a trust signal (e.g. 'generated from X, version Y'). Renders facts that already exist in RDODI's provenance layer (established v1.34.0 PROV-O deepening); does not invent new provenance predicates."@en .

ipo:PythonEngine a owl:Class ;
    rdfs:label "Python Engine"@en ;
    dcterms:source "Package S8, taxonomy of RunnableCodeTool -- user's explicit requirement."@en ;
    rdfs:subClassOf ipo:RunnableCodeTool ;
    skos:definition "A RunnableCodeTool alternative executing Python code (e.g. via a WASM-compiled interpreter such as Pyodide, or a server-side sandboxed call), user-specified explicitly."@en .

ipo:RadioButton a owl:Class ;
    rdfs:label "Radio Button"@en ;
    dcterms:source "WAI-ARIA role=radio and role=radiogroup; HTML5 <input type='radio'>; Material Design Radio Button"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Single-selection choice from a mutually-exclusive set (typically 2-7 options)."@en .

ipo:RefinementContributionWidget a owl:Class ;
    rdfs:label "Refinement Contribution Widget"@en ;
    dcterms:source "RDODI-native suggestion (not the user's literal spec); wires to the EXISTING doc:RefinementContribution (document_ontology_tbox_v1_0_1) and ipo:hostsRefinementContributions (interactive_page_ontology_tbox) -- confirmed real before authoring, not assumed (L-64)."@en ;
    skos:definition "The concrete UI widget realizing the ALREADY-EXISTING ipo:hostsRefinementContributions property (inverse of rdodi-document:offersRefinementContributions) -- lets a reader submit a finding/recommendation that feeds back into ontology synthesis, per doc:RefinementContribution's own definition. That property existed with no widget to realize it in the interactive-page vocabulary until now; this class fills that gap rather than reinventing the feedback concept."@en .

ipo:RegionalVariant a owl:Class ;
    rdfs:label "regional variant"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Geographic-targeted Page version."@en .

ipo:RelatedContent a owl:Class ;
    rdfs:label "related content"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "List of content related to the current page via CrossReferences or content similarity."@en .

ipo:ResponsiveLayout a owl:Class ;
    rdfs:label "Responsive Layout"@en ;
    dcterms:source "InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S1 DoD (commits to exactly 3 new classes)."@en ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "A layout that adapts its structure across viewport breakpoints, including navigation-pattern substitution at narrow widths (e.g. PrimaryNavigation collapsing to a compact toggled menu on mobile) -- this class deliberately SUBSUMES what the roadmap's own planning text called 'ResponsiveLayout/MobileNavigation' as a single committed class, per BP-D7 change control, rather than silently narrowing scope to layout-only."@en .

ipo:ResultPresentation a owl:Class ;
    rdfs:label "result presentation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Outcome visualization area where the demo's results are shown."@en .

ipo:RetentionPolicy a owl:Class ;
    rdfs:label "retention policy"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "How long data must be kept (regulatory or operational)."@en .

ipo:RoleBasedAffordance a owl:Class ;
    rdfs:label "role-based affordance"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "UI element shown only to certain user roles."@en .

ipo:RoutedViewNavigation a owl:Class ;
    rdfs:label "routed view navigation"@en ;
    dcterms:source "W3C-WAI ARIA Authoring Practices Guide (landmark/navigation regions); SPA route semantics, reusing rdodi-page:ApplicationView ('analogous to a route in SPA frameworks')."@en ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Macro navigation in which each top-level section is presented as its own self-contained view (sub-page); exactly one view is shown at a time, selected by a primary menu, an explorer tree, sub-tabs, or the URL fragment. Switches existing ApplicationView instances rather than scrolling a single long page."@en .

ipo:SHACLValidationEngine a owl:Class ;
    rdfs:label "SHACL Validation Engine"@en ;
    dcterms:source "Package S8, taxonomy of RunnableCodeTool -- user's explicit requirement ('next to SHACL')."@en ;
    rdfs:subClassOf ipo:RunnableCodeTool ;
    skos:definition "A RunnableCodeTool alternative that validates a user-edited RDF/data snippet against SHACL shapes in-browser, showing conformance/violation results live -- directly relevant given RDODI's own SHACL-gated discipline."@en .

ipo:SPARQLEngine a owl:Class ;
    rdfs:label "SPARQL Engine"@en ;
    dcterms:source "Package S8, taxonomy of RunnableCodeTool."@en ;
    rdfs:subClassOf ipo:RunnableCodeTool ;
    skos:definition "A RunnableCodeTool alternative executing SPARQL 1.1 queries against an RDF graph, in-browser. Evidenced: enterprise_agentic_kb_v3_39_1's 'sparql_mini' real interpreter."@en .

ipo:SatisfactionInstrument a owl:Class ;
    rdfs:label "Satisfaction Instrument"@en ;
    dcterms:source "Brooke (1996) SUS; Reichheld (2003) NPS; CSAT and CES industry-standard since 2000s"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MeasurementInstrument ;
    skos:definition "A standardised user-satisfaction questionnaire: SUS (System Usability Scale), NPS (Net Promoter Score), CSAT (Customer Satisfaction), or CES (Customer Effort Score). Returns a normalised score."@en .

ipo:ScrollPositionMemory a owl:Class ;
    rdfs:label "scroll position memory"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Remembered scroll position across navigation."@en .

ipo:Search a owl:Class ;
    rdfs:label "search"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "A search interface region."@en .

ipo:SegregatedDuty a owl:Class ;
    rdfs:label "segregated duty"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Action requiring different agents (initiator vs approver) — anti-fraud control."@en .

ipo:ShareableConfiguration a owl:Class ;
    rdfs:label "shareable configuration"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "URL-encoded state for sharing specific demo configurations."@en .

ipo:Sidebar a owl:Class ;
    rdfs:label "sidebar"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "Auxiliary navigation or content alongside MainContent."@en .

ipo:Simulation a owl:Class ;
    rdfs:label "Simulation"@en ;
    dcterms:source "InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S2; user's literal feature specification."@en ;
    rdfs:subClassOf ipo:InstructionalWidget ;
    skos:definition "A composite interactive UI element teaching a domain concept by ENFORCING that concept's dynamics in its input->output behaviour over time (a running model the reader manipulates), matching InstructionalWidget's own bar rather than a passive animation. User-specified default (their explicit spec: 'simulations... as defaults')."@en .

ipo:Skeleton a owl:Class ;
    rdfs:label "Skeleton (placeholder loading UI)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "UI pattern: low-fidelity placeholder rendered in the shape of forthcoming content while it loads, reducing perceived latency."@en .

ipo:SkipToContent a owl:Class ;
    rdfs:label "Skip to Content"@en ;
    dcterms:source "WCAG 2.4.1 Bypass Blocks (cited by reference, not imported -- L-64); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md, Package S1."@en ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "A visually-hidden-until-focused link, first in the tab order, that jumps a keyboard user past repeated navigation blocks directly to the main content region. WCAG 2.4.1 (Bypass Blocks) baseline accessibility affordance."@en .

ipo:Slider a owl:Class ;
    rdfs:label "Slider"@en ;
    dcterms:source "WAI-ARIA role=slider; HTML5 <input type='range'>; Material Design Slider; Apple HIG Slider"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Bounded-numeric input. Used for volume, brightness, quantity, position selection."@en .

ipo:SocialProofElement a owl:Class ;
    rdfs:label "social proof element"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Testimonials, case studies, client logos — content elements signaling trust."@en .

ipo:Specification a owl:Class ;
    rdfs:label "Specification"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SourceDocument ;
    skos:definition "A formal technical specification (e.g., RFC, ISO standard, W3C recommendation)."@en .

ipo:SplitLayout a owl:Class ;
    rdfs:label "split layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Page split into two roughly-equal regions (text|media or sidebar|main)."@en .

ipo:Spotlight a owl:Class ;
    rdfs:label "spotlight"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Single-feature focus-and-explain affordance."@en .

ipo:StackedLayout a owl:Class ;
    rdfs:label "stacked layout"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:LayoutPattern ;
    skos:definition "Items stacked vertically in reading order."@en .

ipo:StandaloneDeployable a owl:Class ;
    rdfs:label "standalone deployable"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Flag indicating no server-side dependencies — fully client-side."@en .

ipo:StandardDocument a owl:Class ;
    rdfs:label "Standard Document"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SourceDocument ;
    skos:definition "A published standard (e.g., ISO 9241-110, ISO/IEC 25010)."@en .

ipo:StubPage a owl:Class ;
    rdfs:label "Stub Page"@en ;
    rdfs:comment "SHACL Page shape MUST exclude this subclass via sh:not to avoid false-positive defects."@en ;
    rdfs:subClassOf ipo:Page ;
    skos:definition "Intentional stub: a Page individual declared solely to satisfy IRI-completeness requirements (e.g., AssessmentReportShape's sh:minCount on assessesPage) when the real page content is out-of-scope or pending. Use sparingly and always declare with an explanatory rdfs:comment describing why the real page is unavailable."@en .

ipo:SubPageTabs a owl:Class ;
    rdfs:label "sub-page tabs"@en ;
    dcterms:source "W3C-WAI ARIA APG Tabs pattern (visual idiom); realized as navigation per WAI-ARIA links, since targets are distinct routes."@en ;
    rdfs:subClassOf ipo:Tabs ;
    skos:definition "Tab-styled navigation links under a parent section that route between its sibling sub-pages (one tab per child entry, plus an overview tab). Realized as navigation links — not in-place panel swaps — so each tab is a routable sub-page with its own location."@en .

ipo:TableOfContents a owl:Class ;
    rdfs:label "table of contents"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Linked outline of an artifact's pages or a page's sections, often hierarchical."@en .

ipo:TagNavigation a owl:Class ;
    rdfs:label "tag navigation"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "Navigation via shared tags or keywords."@en .

ipo:TextBox a owl:Class ;
    rdfs:label "Text Box"@en ;
    dcterms:source "WAI-ARIA role=textbox; HTML5 <input type='text'> and <textarea>; Material Design Text Field; Apple HIG Text Field"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Free-form short or multi-line text input."@en .

ipo:ThemeSwitcher a owl:Class ;
    rdfs:label "Theme Switcher"@en ;
    dcterms:source "user's literal feature specification ('optionally multiple-themes as light is a default'); Package S3."@en ;
    skos:definition "A control offering the reader a choice between visual themes (at minimum light and a dark alternative). Deliberately the SOLE carrier of the 'dark mode' concept -- the roadmap's own prose named 'DarkMode' separately, but its DoD commits to exactly 6 new classes for S3 (matching the S1 ResponsiveLayout/MobileNavigation precedent); dark-theme capability is expressed here rather than as its own class, disclosed in CHANGELOG."@en .

ipo:ThreeDimensionalVisualization a owl:Class ;
    rdfs:label "3D Visualization"@en ;
    dcterms:source "user's literal feature specification ('graphics and visual components in ... three dimensions'); Package S3."@en ;
    skos:definition "A graphics/visual component rendered in a 3-dimensional scene (WebGL-scoped). Root class, peer to Canvas2DVisualization."@en .

ipo:Toolbar a owl:Class ;
    rdfs:label "Toolbar"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "UI pattern: horizontal or vertical strip of action buttons grouped by function, providing quick access to commands for the current view."@en .

ipo:Tooltip a owl:Class ;
    rdfs:label "tooltip"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Hover/focus help text affordance."@en .

ipo:Tour a owl:Class ;
    rdfs:label "tour"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Onboarding overlay sequence."@en .

ipo:TreeNavigation a owl:Class ;
    rdfs:label "tree navigation"@en ;
    dcterms:source "W3C-WAI ARIA APG Tree View pattern. Reconciles interactive_page_ontology_tbox_v1_0_2 (vendored) into canonical."@en ;
    rdfs:subClassOf ipo:MacroNavigationPattern ;
    skos:definition "A hierarchical, expandable/collapsible explorer of the artifact's sections, navigable by keyboard (arrow keys, Home/End, expand/collapse), with the current location indicated by aria-selected. Often co-serves as the table of contents."@en .

ipo:UndoAffordance a owl:Class ;
    rdfs:label "undo affordance"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WayfindingAffordance ;
    skos:definition "Visible undo for destructive actions."@en .

ipo:UndoableAction a owl:Class ;
    rdfs:label "undoable action"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An action that can be reversed via undo."@en .

ipo:Vancouver a ipo:CitationStyle,
        owl:NamedIndividual ;
    rdfs:label "Vancouver (ICMJE)"@en ;
    dcterms:source "ICMJE (2019). Uniform Requirements for Manuscripts Submitted to Biomedical Journals."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> .

ipo:WPC_Application a owl:Class ;
    rdfs:label "WPC Application"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SpecializedWPCArtifact ;
    skos:definition "Specialization for authenticated single-page or multi-page applications with workflows. Reference: Ontology Workbench. Quality profile: Performance=Required, Security=Required, Accessibility AA=Required, Privacy=Required."@en .

ipo:WPC_Corporate a owl:Class ;
    rdfs:label "WPC Corporate"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SpecializedWPCArtifact ;
    skos:definition "Specialization for publicly-accessible business websites — landing pages, marketing, content hubs. Reference: a public small-business website. Quality profile: SEO=Required, Performance=Required, Privacy=Required, Accessibility AA=Required."@en .

ipo:WPC_Demo a owl:Class ;
    rdfs:label "WPC Demo"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SpecializedWPCArtifact ;
    skos:definition "Specialization for standalone artifacts sharing knowledge or research — interactive demos, study presentations, concept explainers. Reference: public concept-teaching demo pages. Quality profile: Performance=Required, Size=Required, Discoverability=Required, Accessibility=Recommended."@en .

ipo:WPC_Educational a owl:Class ;
    rdfs:label "WPC Educational"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SpecializedWPCArtifact ;
    skos:definition "Specialization for instructional content for learners — book chapters, course pages, tutorials. Reference: textbook chapters; university course pages. Quality profile: Accessibility AA=Required (educational equity), Usability=Required, Discoverability=Required (OER), Privacy=Required."@en .

ipo:WPC_Internal a owl:Class ;
    rdfs:label "WPC Internal"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SpecializedWPCArtifact ;
    skos:definition "Specialization for authenticated employee-facing modules with strict role-based access and audit trails. Reference: Studio Management System, HR modules. Quality profile: Security=Required, Privacy=Required, Accessibility AA=Required, Usability=Required, SEO=Inapplicable."@en .

ipo:Wizard a owl:Class ;
    rdfs:label "Wizard (multi-step guided form)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Multi-step form/process with explicit Previous/Next navigation and progress indication."@en .

ipo:abbreviationExpansion a owl:DatatypeProperty ;
    rdfs:label "abbreviation expansion"@en ;
    rdfs:domain ipo:Abbreviation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "The full-form expansion of the abbreviation (e.g., 'User Experience', 'HyperText Markup Language', 'Web Accessibility Initiative — Accessible Rich Internet Applications')."@en .

ipo:abbreviationToken a owl:DatatypeProperty ;
    rdfs:label "abbreviation token"@en ;
    rdfs:domain ipo:Abbreviation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "The short abbreviation form itself (e.g., 'UX', 'HTML', 'WAI-ARIA')."@en .

ipo:abbreviationsListRegion a owl:ObjectProperty ;
    rdfs:label "abbreviations list region"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:AbbreviationsList ;
    skos:definition "The dedicated AbbreviationsList content region of the artefact."@en .

ipo:abstractWordCount a owl:DatatypeProperty ;
    rdfs:label "abstract word count"@en ;
    rdfs:domain ipo:ResearchReportPage ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Actual word count of the abstract, used by AbstractWordLimitShape."@en .

ipo:abstractWordLimit a owl:DatatypeProperty ;
    rdfs:label "abstract word limit"@en ;
    rdfs:domain ipo:ResearchReportPage ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Maximum word count for the Abstract. Default 250 (APA 7e §2.9). SHACL AbstractWordLimitShape verifies actual abstract length is at or below this limit (relies on author-supplied word count or post-hoc text analysis)."@en .

ipo:alongDimension a owl:ObjectProperty ;
    rdfs:label "along dimension"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:QualityDimension ;
    skos:definition "Links a QualityAssessment to a QualityDimension."@en .

ipo:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    rdfs:domain ipo:MeasurementInstrument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:QualityDimension ;
    skos:definition "Links an instrument to the QualityDimension it measures."@en .

ipo:assesses a owl:ObjectProperty ;
    rdfs:label "assesses"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:WPCArtifact ;
    skos:definition "Links a QualityAssessment to the WPCArtifact it assesses."@en .

ipo:assessmentDate a owl:DatatypeProperty ;
    rdfs:label "assessment date"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:dateTime ;
    skos:definition "When the assessment was performed. xsd:dateTime per OWL 2 DL."@en .

ipo:assessmentSeverity a owl:DatatypeProperty ;
    rdfs:label "assessment severity"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "'required', 'recommended', 'optional', 'inapplicable' (matches per-specialization Quality Profile)."@en .

ipo:authorAffiliation a owl:DatatypeProperty ;
    rdfs:label "author affiliation"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:affiliatedWith ;
    skos:definition "Institutional affiliation of the author. Format: 'Department, Institution, City, Country'."@en .

ipo:authorORCID a owl:DatatypeProperty ;
    rdfs:label "author ORCID"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:anyURI ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:ORCID ;
    skos:definition "ORCID identifier of the author as a resolvable URI (e.g., https://orcid.org/0000-0000-0000-0000)."@en .

ipo:citationAuthors a owl:DatatypeProperty ;
    rdfs:label "citation authors"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Citation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:Authorship,
        rdodi-research:authored,
        foaf:Person ;
    skos:definition "Authors of the cited work as a semicolon-separated string in 'Surname, F. M.' format per APA 7e."@en .

ipo:citationDOI a owl:DatatypeProperty ;
    rdfs:label "citation DOI"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Citation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:anyURI ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:DOI ;
    skos:definition "Digital Object Identifier as a resolvable URI (e.g., https://doi.org/10.1234/example). Preferred over citationURL for archival stability."@en .

ipo:citationVenue a owl:DatatypeProperty ;
    rdfs:label "citation venue"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Citation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:publishedIn ;
    skos:definition "Publication venue: journal name, conference name, publisher, or standards body."@en .

ipo:cites a owl:ObjectProperty ;
    rdfs:label "cites"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Citation .

ipo:codeAvailabilityStatement a owl:DatatypeProperty ;
    rdfs:label "code availability statement"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:hasAccessPolicy ;
    skos:definition "Statement describing where analysis code/scripts are available."@en .

ipo:cohesionMarker a owl:DatatypeProperty ;
    rdfs:label "cohesion marker"@en ;
    rdfs:domain ipo:Paragraph ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Transitional phrase linking this paragraph to its neighbour: 'Furthermore', 'However', 'In contrast', 'Building on the above'. Recommended per Williams & Bizup 2017."@en .

ipo:containsCodeExample a owl:ObjectProperty ;
    rdfs:label "contains code example"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CodeExample .

ipo:containsPage a owl:ObjectProperty ;
    rdfs:label "contains page"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    skos:definition "Links a WPCArtifact to a Page it contains."@en .

ipo:coversCaseStudy a owl:ObjectProperty ;
    rdfs:label "covers case study"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CaseStudy .

ipo:coversChapterSection a owl:ObjectProperty ;
    rdfs:label "covers chapter section"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ChapterSection .

ipo:coversLearningObjective a owl:ObjectProperty ;
    rdfs:label "covers learning objective"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:LearningObjective .

ipo:crossReferenceSource a owl:ObjectProperty ;
    rdfs:label "cross reference source"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:CrossReference ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    skos:definition "The source Page of a CrossReference."@en .

ipo:crossReferenceTarget a owl:ObjectProperty ;
    rdfs:label "cross reference target"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:CrossReference ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    skos:definition "The target Page of a CrossReference."@en .

ipo:dataAvailabilityStatement a owl:DatatypeProperty ;
    rdfs:label "data availability statement"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:hasAccessPolicy ;
    skos:definition "Statement describing where research data are available."@en .

ipo:definesKeyTerm a owl:ObjectProperty ;
    rdfs:label "defines key term"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:KeyTerm .

ipo:demonstratesSubject a owl:ObjectProperty ;
    rdfs:label "demonstrates subject"@en ;
    dcterms:source "WPC v6.1.0 — promotes a property already used by Stage 4 page ABoxes (Ch.5, Ch.6) without a TBox declaration."@en ;
    rdfs:domain ipo:InstructionalWidget ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Links an InstructionalWidget to the domain individual(s) or class(es) it teaches. Multiple values allowed — a widget can demonstrate multiple related subjects (e.g., a sorter game demonstrates each category class)."@en .

ipo:depictsSourceFigure a owl:ObjectProperty ;
    rdfs:label "depicts source figure"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:SourceFigure ;
    skos:definition "Asserts the page renders an equivalent or evolved rendition of the source Figure (own SVG, animation, or interactive). Does NOT require pixel-equivalence — pedagogical equivalence."@en .

ipo:enforcesDomainConstraint a owl:ObjectProperty ;
    rdfs:label "enforces domain constraint"@en ;
    dcterms:source "WPC v6.1.0 — operationalises the principle that an InstructionalWidget's behaviour must encode the semantics it claims to demonstrate."@en ;
    rdfs:domain ipo:InstructionalWidget ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Links an InstructionalWidget to the named domain constraint (typically a class, ObjectProperty, or AllDisjointClasses node in the foundations ontology) that the widget's input-output behaviour mechanically enforces. Distinct from demonstratesSubject: demonstratesSubject names WHAT is shown; enforcesDomainConstraint names WHAT IS PREVENTED from being shown incorrectly. Example: a CoupledVariableDemonstrator's enforcesDomainConstraint might point to a property axiom that asserts coupling among the variables."@en .

ipo:findingCitedBy a owl:ObjectProperty ;
    rdfs:label "finding cited by"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Citation ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:cites ;
    skos:definition "Citations supporting this finding. SHACL FindingEvidenceShape requires at least one of (findingCitedBy, findingEvidence) per finding."@en .

ipo:findingConfidence a owl:DatatypeProperty ;
    rdfs:label "finding confidence"@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Author-rated confidence level. Allowed values: 'high', 'medium', 'low', or numeric 0.0-1.0."@en .

ipo:findingEvidence a owl:DatatypeProperty ;
    rdfs:label "finding evidence"@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Evidence supporting the finding: verbatim source quote, measurement value, observation. Per Booth/Colomb/Williams (2016) Craft of Research 4e: every claim needs evidence + warrant."@en .

ipo:findingNoveltyLevel a owl:DatatypeProperty ;
    rdfs:label "finding novelty level"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:fillsKnowledgeGap,
        rdodi-research:reproducesExistingClaim ;
    skos:definition "Allowed values: 'replication' (confirms prior result), 'extension' (extends prior result), 'original' (no prior comparable result)."@en .

ipo:findingStatistic a owl:DatatypeProperty ;
    rdfs:label "finding statistic"@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Statistical detail when finding is quantitative. Free-form string e.g., 'ratio=0.078, 95% CI [0.065, 0.091], n=124033 chars'. Required when findingType='quantitative'."@en .

ipo:findingType a owl:DatatypeProperty ;
    rdfs:label "finding type"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:Finding ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:discourseRole ;
    skos:definition "Finding genre. Allowed values: 'quantitative', 'qualitative', 'mixed', 'theoretical'."@en .

ipo:firstUseSentence a owl:DatatypeProperty ;
    rdfs:label "first use sentence"@en ;
    rdfs:domain ipo:Abbreviation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "The verbatim sentence (or sentence fragment) in the artefact that introduces the abbreviation on its first occurrence. MUST follow the canonical 'Full Name (Token)' format — full expansion followed by the abbreviation in parentheses — per ISO 80000-1:2009 §6 and Chicago Manual of Style 17e §10.3."@en .

ipo:fundingSource a owl:DatatypeProperty ;
    rdfs:label "funding source"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:fundedBy,
        <http://purl.org/cerif/frapo/Grant> ;
    skos:definition "Funding sources, grant numbers, sponsors. Use 'none' if self-funded."@en .

ipo:hasAbbreviation a owl:ObjectProperty ;
    rdfs:label "has abbreviation"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Abbreviation ;
    skos:definition "Relates a WPCArtifact (or any subclass such as ResearchReport) to an Abbreviation used within it."@en .

ipo:hasCaseStudy a owl:ObjectProperty ;
    rdfs:label "has case study"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CaseStudy .

ipo:hasChapterSection a owl:ObjectProperty ;
    rdfs:label "has chapter section"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ChapterSection .

ipo:hasChild a owl:ObjectProperty ;
    rdfs:label "has child"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    owl:inverseOf ipo:hasParent ;
    skos:definition "Inverse of :hasParent."@en .

ipo:hasContent a owl:ObjectProperty ;
    rdfs:label "has content"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.2"@en ;
    rdfs:domain ipo:ContentRegion ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Links a ContentRegion to its content. Range is intentionally open (Core doesn't mandate content typology); concrete content classes come from Capabilities or Report integration."@en .

ipo:hasContentRegion a owl:ObjectProperty ;
    rdfs:label "has content region"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.2"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ContentRegion ;
    skos:definition "Links a Page to a ContentRegion within it."@en .

ipo:hasConversionGoal a owl:ObjectProperty ;
    rdfs:label "has conversion goal"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ConversionGoal ;
    skos:definition "Links a Page to its primary ConversionGoal."@en .

ipo:hasCrossReference a owl:ObjectProperty ;
    rdfs:label "has cross reference"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CrossReference ;
    skos:definition "Links a Page to one of its outgoing CrossReferences."@en .

ipo:hasCrossReferenceType a owl:ObjectProperty ;
    rdfs:label "has cross reference type"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:CrossReference ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CrossReferenceType ;
    skos:definition "Links a CrossReference to its semantic type."@en .

ipo:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Finding .

ipo:hasHypothesis a owl:ObjectProperty ;
    rdfs:label "has hypothesis"@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Hypothesis .

ipo:hasInstrument a owl:ObjectProperty ;
    rdfs:label "has instrument"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:MeasurementInstrument ;
    skos:definition "Binds a QualityAssessment to one or more measurement instruments used."@en .

ipo:hasInteractionConstraint a owl:ObjectProperty ;
    rdfs:label "has interaction constraint"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:InteractionConstraint ;
    skos:definition "Links a page (or ArtifactKindSpec) to the InteractionConstraint instances it satisfies/requires."@en .

ipo:hasKeyTerm a owl:ObjectProperty ;
    rdfs:label "has key term"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:KeyTerm .

ipo:hasLayoutPattern a owl:ObjectProperty ;
    rdfs:label "has layout pattern"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:LayoutPattern ;
    skos:definition "Links a Page to a LayoutPattern it uses."@en .

ipo:hasLearningObjective a owl:ObjectProperty ;
    rdfs:label "has learning objective"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:LearningObjective .

ipo:hasLifecycleAffordance a owl:DatatypeProperty ;
    rdfs:label "has lifecycle affordance"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a WPCArtifact: when true, lifecycle data is required; when false, lifecycle is not enforced. Default per specialization: Corporate=true, Application=true, Internal=true, Educational=true, Demo=false."@en .

ipo:hasLifecycleState a owl:ObjectProperty ;
    rdfs:label "has lifecycle state"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:PageLifecycleState ;
    skos:definition "Links a Page to its current PageLifecycleState. Optional — only used when the artifact's :hasLifecycleAffordance is true."@en .

ipo:hasMeasuredValue a owl:ObjectProperty ;
    rdfs:label "has measured value"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:MeasuredValue ;
    skos:definition "Binds a QualityAssessment to recorded measurements."@en .

ipo:hasOutboundLink a owl:DatatypeProperty ;
    rdfs:label "has outbound link"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.6"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL string of an outbound link from a Page. Multi-valued. Range is xsd:anyURI."@en .

ipo:hasOutboundLinkInventory a owl:ObjectProperty ;
    rdfs:label "has outbound link inventory"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.6"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Links a WPCArtifact or Page to its derived OutboundLinkInventory."@en .

ipo:hasReferenceList a owl:ObjectProperty ;
    rdfs:label "has reference list"@en ;
    rdfs:domain ipo:ResearchReportPage ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ReferenceList .

ipo:hasResponsiveIntent a owl:ObjectProperty ;
    rdfs:label "has responsive intent"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ResponsiveIntent ;
    skos:definition "Links a WPCArtifact (or Page, for override) to a ResponsiveIntent."@en .

ipo:hasReviewQuestion a owl:ObjectProperty ;
    rdfs:label "has review question"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ReviewQuestion .

ipo:hasRootPage a owl:ObjectProperty ;
    rdfs:label "has root page"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    skos:definition "Links a WPCArtifact to its root Page (Page with no parent in PageHierarchy)."@en .

ipo:hasSemanticRegion a owl:ObjectProperty ;
    rdfs:label "has semantic region"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:SemanticRegion ;
    skos:definition "Links a Page to its SemanticRegions."@en .

ipo:hasSourceDocument a owl:ObjectProperty ;
    rdfs:label "has source document"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:SourceDocument ;
    skos:definition "Declares the canonical source document this page represents. A page MAY have one; pages WITHOUT a source document are not subject to ContentFidelity measurement."@en .

ipo:hasSourceFigure a owl:ObjectProperty ;
    rdfs:label "has source figure"@en ;
    rdfs:domain ipo:SourceDocument ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:SourceFigure .

ipo:hasSourceProvenance a owl:ObjectProperty ;
    rdfs:label "has source provenance"@en ;
    dcterms:source "WPC v6.1.0"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:SourceProvenance ;
    skos:definition "When a page's content mixes primary and secondary sources, each demonstrator MUST declare its source tier so learners can distinguish examinable content from supplementary extension."@en .

ipo:hasTarget a owl:ObjectProperty ;
    rdfs:label "has target"@en ;
    rdfs:domain ipo:QualityAssessment ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Target ;
    skos:definition "Binds a QualityAssessment to one or more declared targets."@en .

ipo:hasTopicSentence a owl:DatatypeProperty ;
    rdfs:label "has topic sentence"@en ;
    rdfs:domain ipo:Paragraph ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "The opening sentence of the paragraph that states its claim. SHACL CohesiveParagraphShape requires this triple per Paragraph individual. Honest disclosure: SHACL verifies the triple exists; semantic anchoring is author-discipline."@en .

ipo:hasTransitionHistory a owl:ObjectProperty ;
    rdfs:label "has transition history"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:LifecycleTransition ;
    skos:definition "Links a Page to its history of LifecycleTransitions (forms a chain, each prov:wasInformedBy the previous)."@en .

ipo:hasTransitionNextState a owl:ObjectProperty ;
    rdfs:label "has transition next state"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:LifecycleTransition ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:PageLifecycleState ;
    skos:definition "The PageLifecycleState after a LifecycleTransition."@en .

ipo:hasTransitionPriorState a owl:ObjectProperty ;
    rdfs:label "has transition prior state"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:LifecycleTransition ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:PageLifecycleState ;
    skos:definition "The PageLifecycleState before a LifecycleTransition."@en .

ipo:hostsBloomTaggedContent a owl:ObjectProperty ;
    rdfs:label "hosts Bloom-tagged content"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersBloomTaggedContent ;
    owl:inverseOf rdodi-document:offersBloomTaggedContent ;
    skos:definition "Inverse of report:offersBloomTaggedContent. A Page hosts content that Report has tagged with BloomLevels; the Page can render appropriate level badges, level filters, etc."@en .

ipo:hostsCitations a owl:ObjectProperty ;
    rdfs:label "hosts citations"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §7.2; Sprint 7 cross-contract wiring"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersCitations ;
    owl:inverseOf rdodi-document:offersCitations ;
    skos:definition "Inverse of report:offersCitations. A Page hosts Report's citations / bibliography for reader access."@en .

ipo:hostsConceptDefinitions a owl:ObjectProperty ;
    rdfs:label "hosts concept definitions"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §7.2; Sprint 7 cross-contract wiring"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersConceptDefinitions ;
    owl:inverseOf rdodi-document:offersConceptDefinitions ;
    skos:definition "Inverse of report:offersConceptDefinitions. A Page hosts Report's domain-term definitions (glossary). Used by Educational specialization's :GlossaryEntry."@en .

ipo:hostsLearningObjectives a owl:ObjectProperty ;
    rdfs:label "hosts learning objectives"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersLearningObjectives ;
    owl:inverseOf rdodi-document:offersLearningObjectives ;
    skos:definition "Inverse of report:offersLearningObjectives. A Page exposes Report's LearningObjectives — useful for course-page generation, lesson plans."@en .

ipo:hostsPedagogicalSignals a owl:ObjectProperty ;
    rdfs:label "hosts pedagogical signals"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersPedagogicalSignals ;
    owl:inverseOf rdodi-document:offersPedagogicalSignals ;
    skos:definition "Inverse of report:offersPedagogicalSignals. A Page renders Report's PedagogicalSignal annotations with appropriate UI affordances."@en .

ipo:hostsRefinementContributions a owl:ObjectProperty ;
    rdfs:label "hosts refinement contributions"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersRefinementContributions ;
    owl:inverseOf rdodi-document:offersRefinementContributions ;
    skos:definition "Inverse of report:offersRefinementContributions. A Page exposes Report's RefinementContributions for reader-facing feedback channels."@en .

ipo:hostsStructuredContent a owl:ObjectProperty ;
    rdfs:label "hosts structured content"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersStructuredContent ;
    owl:inverseOf rdodi-document:offersStructuredContent ;
    skos:definition "Inverse of report:offersStructuredContent. A WPCArtifact (or Page) hosts structured content provided by a Report instance."@en .

ipo:hostsTaxonomyNavigation a owl:ObjectProperty ;
    rdfs:label "hosts taxonomy navigation"@en ;
    dcterms:source "WPC Requirements v1.0.2 §7.2 (interface contract); Report Sprint 3 v1.5.0 inverse"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso rdodi-document:offersTaxonomyNavigation ;
    owl:inverseOf rdodi-document:offersTaxonomyNavigation ;
    skos:definition "Inverse of report:offersTaxonomyNavigation. A Page renders Report's taxonomy-as-skeleton structure as a TOC, breadcrumb, or section index."@en .

ipo:hypothesisEvidence a owl:ObjectProperty ;
    rdfs:label "hypothesis evidence"@en ;
    rdfs:domain ipo:Hypothesis ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Finding ;
    skos:definition "Findings that test this hypothesis. SHACL HypothesisFalsifiabilityShape requires ≥1 hypothesisEvidence per Hypothesis."@en .

ipo:hypothesisFalsifiabilityCriterion a owl:DatatypeProperty ;
    rdfs:label "hypothesis falsifiability criterion"@en ;
    rdfs:domain ipo:Hypothesis ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Explicit statement of what evidence would FALSIFY the hypothesis. Per Popper (1959): a hypothesis is scientific only if it can be refuted by observation."@en .

ipo:hypothesisNull a owl:DatatypeProperty ;
    rdfs:label "null hypothesis"@en ;
    rdfs:domain ipo:Hypothesis ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string .

ipo:hypothesisOntologyDrivenPreRegistration a owl:DatatypeProperty ;
    rdfs:label "hypothesis ontology-driven pre-registration"@en ;
    rdfs:domain ipo:Hypothesis ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "SHA256 or git commit hash of the hypothesis ABox snapshot taken BEFORE corresponding findings were authored. The pre-finding state of the ABox IS the pre-registration in ontology-driven research."@en .

ipo:hypothesisTestVerdict a owl:DatatypeProperty ;
    rdfs:label "hypothesis test verdict"@en ;
    rdfs:domain ipo:Hypothesis ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Outcome of testing. Allowed values: 'supported', 'partially-supported', 'not-supported', 'inconclusive'."@en .

ipo:includesNavigationPattern a owl:ObjectProperty ;
    rdfs:label "includes navigation pattern"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:MacroNavigationPattern ;
    skos:definition "Links a Page to a MacroNavigationPattern it includes."@en .

ipo:includesWayfindingAffordance a owl:ObjectProperty ;
    rdfs:label "includes wayfinding affordance"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:WayfindingAffordance ;
    skos:definition "Links a Page to a WayfindingAffordance it includes."@en .

ipo:inlineCitationKey a owl:DatatypeProperty ;
    rdfs:label "in-line citation key"@en ;
    rdfs:domain ipo:Citation ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Canonical form for in-body citation reference. Default author-date: '(Surname, YYYY)' or '(Surname et al., YYYY)' for 3+ authors. IEEE: '[N]'."@en .

ipo:interactiveElementCount a owl:DatatypeProperty ;
    rdfs:label "interactive element count"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Measured count of interactive elements on a page (buttons, inputs, selects, focusable canvas, drop targets). Threshold-checked by Stage 4 SHACL gate."@en .

ipo:isNegativeReference a owl:DatatypeProperty ;
    rdfs:label "is negative reference"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Marks a reference template as a negative example (a known-failure anchor for the Stage 4 SHACL gate)."@en .

ipo:javascriptLOC a owl:DatatypeProperty ;
    rdfs:label "JavaScript lines of code"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Measured count of behavioural JavaScript lines inside <script> elements (excluding ld+json)."@en .

ipo:methodCoderCount a owl:DatatypeProperty ;
    rdfs:label "method coder count"@en ;
    rdfs:domain ipo:ResearchMethod ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Number of independent coders/analysts. 1 = single coder (IRR not computable); ≥2 = inter-rater reliability computable."@en .

ipo:methodInterRaterAgreement a owl:DatatypeProperty ;
    rdfs:label "method inter-rater agreement"@en ;
    rdfs:domain ipo:ResearchMethod ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Inter-rater reliability statistic. Format: 'Cohen κ=0.82, n=42 items' or 'Fleiss κ=0.74'. NOT applicable when methodCoderCount=1. For ontology-driven coding: SHACL validation = mechanical second rater."@en .

ipo:methodOntologyDrivenPreRegistration a owl:DatatypeProperty ;
    rdfs:label "method ontology-driven pre-registration"@en ;
    rdfs:domain ipo:ResearchMethod ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "For ontology-driven research: SHA256 or git commit hash of the hypothesis ABox snapshot taken BEFORE findings were authored. Functional equivalent of OSF pre-registration. Honest disclosure: this is a research-practice innovation; cite Altunel (2026) for the convention."@en .

ipo:methodReproducibilityParams a owl:DatatypeProperty ;
    rdfs:label "method reproducibility parameters"@en ;
    rdfs:domain ipo:ResearchMethod ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Concrete reproducibility parameters: tool names, version strings, input files, configuration. Sufficient to re-execute the method end-to-end."@en .

ipo:methodToolVersion a owl:DatatypeProperty ;
    rdfs:label "method tool version"@en ;
    rdfs:domain ipo:ResearchMethod ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Version strings of tools used. Example: 'pyshacl 0.25.0; rdflib 7.0.0; owlrl 6.0.2; Python 3.11'."@en .

ipo:minimumThreshold a owl:DatatypeProperty ;
    rdfs:label "minimum threshold"@en ;
    rdfs:domain ipo:InteractionConstraint ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:integer ;
    skos:definition "Minimum value the targetProperty must equal or exceed for the constraint to pass."@en .

ipo:notApplicable a owl:DatatypeProperty ;
    rdfs:label "not applicable"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a (specialization, dimension) pairing indicating Inapplicable severity."@en .

ipo:noveltyStatement a owl:DatatypeProperty ;
    rdfs:label "novelty statement"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:fillsKnowledgeGap,
        rdodi-research:opensFurtherQuestions,
        rdodi-research:reproducesExistingClaim ;
    skos:definition "Explicit statement of the report's originality contribution. Located in body text (typically §1.2). SHACL NoveltyStatementRequiredShape requires this triple."@en .

ipo:numericMeasuredValue a owl:DatatypeProperty ;
    rdfs:label "numeric measured value"@en ;
    rdfs:domain ipo:MeasuredValue ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:double .

ipo:numericTargetValue a owl:DatatypeProperty ;
    rdfs:label "numeric target value"@en ;
    rdfs:domain ipo:Target ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:double .

ipo:numericThresholdValue a owl:DatatypeProperty ;
    rdfs:label "numeric threshold value"@en ;
    rdfs:domain ipo:Threshold ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:double .

ipo:partOfDimension a owl:ObjectProperty ;
    rdfs:label "part of dimension"@en ;
    rdfs:domain ipo:QualitySubAspect ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:QualityDimension ;
    skos:definition "Links a QualitySubAspect to the parent QualityDimension it decomposes."@en .

ipo:participatesInJourney a owl:ObjectProperty ;
    rdfs:label "participates in journey"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:UserJourney .

ipo:primarySourceConceptCoverage a owl:DatatypeProperty ;
    rdfs:label "primary-source concept coverage"@en ;
    rdfs:domain ipo:InteractiveLearningSurface ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:decimal ;
    skos:definition "Measured fraction of primary-source-named concepts that are present at BOTH ontology level (a named class or NamedIndividual exists in the chapter foundations ontology) AND page level (a widget, table cell, or named heading demonstrates the concept on the page). Value is in [0.0, 1.0]. The denominator is the cardinality of the primary-source-concept inventory: the enumerable concepts named in the primary source — heading terms, defined terms, figure captions, enumerated lists (e.g., 'six estimation methods', 'five required elements'). The numerator counts concepts present at BOTH levels. The threshold is heuristic, not normative; it derives from the COM0463 Ch.5 incident where 0.62 was the post-remediation level with ~85% on user-facing concepts and lower on tail concepts (figure subscripts, footnote references). This property is asserted (typically) by an Activity that ran a measurement script against the source-concept inventory and the rendered page."@en .

ipo:primarySourceConceptInventorySize a owl:DatatypeProperty ;
    rdfs:label "primary-source concept inventory size"@en ;
    rdfs:domain ipo:InteractiveLearningSurface ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Asserted alongside the coverage value so that downstream consumers can reconstruct the numerator (= coverage × inventory_size)."@en .

ipo:provenanceGraphHash a owl:DatatypeProperty ;
    rdfs:label "provenance graph hash"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "SHA256 hash of the PROV-O provenance graph associated with this artefact. In ontology-driven research, this hash anchors the raw-data-equivalent: the immutable ontology state at publication time. Functional substitute for external raw-data hosting (per Altunel 2026 convention)."@en .

ipo:referenceOrdering a owl:DatatypeProperty ;
    rdfs:label "reference ordering"@en ;
    rdfs:domain ipo:ReferenceList ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Sort order of references in the reference list. Allowed values: 'chronological' (by citationYear ascending), 'alphabetical' (by first author surname), 'citation-order' (order of first appearance in body, IEEE convention)."@en .

ipo:rendersResearchPublication a owl:ObjectProperty ;
    rdfs:label "renders research publication"@en ;
    rdfs:domain ipo:ResearchReportPage ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range rdodi-research:Publication .

ipo:reportSectionOrder a owl:DatatypeProperty ;
    rdfs:label "report section order"@en ;
    rdfs:domain ipo:ResearchReportPage ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Comma-separated section names in their appearance order. Default IMRaD: 'Abstract,Introduction,Methods,Findings,Discussion,Limitations,References'. SHACL IMRaDOrderingShape verifies the declared order matches this template."@en .

ipo:reproducibilityChecklist a owl:DatatypeProperty ;
    rdfs:label "reproducibility checklist"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:hasProductionTraceability ;
    skos:definition "Reference to a filled reproducibility checklist (e.g., Nature, NeurIPS, PRISMA flow)."@en .

ipo:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requires capability"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.9"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Hard composition constraint: a Capability requires another (Annotation requires content to annotate). SHACL Violation if violated."@en .

ipo:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "review status"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:hasProductionProcessType ;
    skos:definition "Current review level of the artefact. Allowed values: 'self-reviewed', 'course-instructor-reviewed', 'internal-team-reviewed', 'external-peer-reviewed', 'editorial-board-accepted'. Functional substitute for external peer review declaration."@en .

ipo:satisfiesHeuristic a owl:ObjectProperty ;
    rdfs:label "satisfies heuristic"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:UsabilityHeuristic ;
    skos:definition "Links a Page to a UsabilityHeuristic it satisfies. Multi-valued; intended for SHACL validation of usability claims."@en .

ipo:sentenceCompleteness a owl:DatatypeProperty ;
    rdfs:label "sentence completeness"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:boolean ;
    skos:definition "Author assertion that body text consists of complete sentences (no orphan fragments outside intentional cases like headings, captions, list items). SHACL verifies presence; NLP verification of actual completeness is out of scope."@en .

ipo:supportsTask a owl:ObjectProperty ;
    rdfs:label "supports task"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Task .

ipo:systematicSearchStrategy a owl:DatatypeProperty ;
    rdfs:label "systematic search strategy"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:DiscoveryAttempt,
        rdodi-research:DiscoveryMethod,
        rdodi-research:RejectionCriterion,
        rdodi-research:hasExclusionCriterion,
        rdodi-research:hasInclusionCriterion,
        rdodi-research:hasSelectionStrategy ;
    skos:definition "Description of literature search strategy: databases queried, date range, inclusion/exclusion criteria. PRISMA-style flow numbers (identified, screened, included) recommended."@en .

ipo:targetProperty a owl:DatatypeProperty ;
    rdfs:label "target property"@en ;
    rdfs:domain ipo:InteractionConstraint ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Text expression naming the page property the constraint targets (e.g., 'count(button) + count(input)')."@en .

ipo:targetsPersona a owl:ObjectProperty ;
    rdfs:label "targets persona"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Persona .

ipo:theoreticalFramework a owl:DatatypeProperty ;
    rdfs:label "theoretical framework"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:ScopeFrame ;
    skos:definition "Named theoretical framework grounding the analysis. Examples: 'Bass-Clements-Kazman Quality Attribute Scenarios', 'Activity Theory', 'Distributed Cognition', 'OWL 2 RL Formal Semantics'."@en .

ipo:transitionAgent a owl:ObjectProperty ;
    rdfs:label "transition agent"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:LifecycleTransition ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso prov:Agent ;
    skos:definition "Agent who performed the transition. rdfs:seeAlso prov:Agent per Pattern 3."@en .

ipo:transitionTime a owl:DatatypeProperty ;
    rdfs:label "transition time"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:domain ipo:LifecycleTransition ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:dateTime ;
    skos:definition "When the transition occurred. xsd:dateTime per OWL 2 DL datatype map (Sprint 4 lesson)."@en .

ipo:typicallyPairedWith a owl:ObjectProperty ;
    rdfs:label "typically paired with"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.9"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Soft suggestion: a Capability is typically paired with another (Quiz typically pairs with Discussion in educational settings). Multi-valued. SHACL Warning if violated, not Violation."@en .

ipo:unitOfMeasure a owl:DatatypeProperty ;
    rdfs:label "unit of measure"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "ms, score-0-100, score-minus100-plus100, kilobytes, ratio, etc."@en .

ipo:usesCitationForm a owl:ObjectProperty ;
    rdfs:comment "links a CitationLink instance to the doc:CitationForm individual (Package 1) governing its in-text/reference-list rendering -- cross-namespace, reuses existing vocabulary, no duplication (L-64)."@en ;
    rdfs:domain ipo:CitationLink ;
    rdfs:range rdodi-document:CitationForm .

ipo:usesCitationStyle a owl:ObjectProperty ;
    rdfs:label "uses citation style"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:CitationStyle ;
    skos:definition "Declares the bibliographic citation style governing in-line citation keys and reference list formatting. SHACL InlineCitationFormatShape enforces pattern compliance."@en .

ipo:usesInstructionalWidget a owl:ObjectProperty ;
    rdfs:label "uses instructional widget"@en ;
    rdfs:domain ipo:InteractiveLearningSurface ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:InstructionalWidget ;
    skos:definition "Links an InteractiveLearningSurface to the InstructionalWidget instances it hosts."@en .

ipo:usesMethod a owl:ObjectProperty ;
    rdfs:label "uses method"@en ;
    rdfs:domain ipo:ResearchReport ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:ResearchMethod .

ipo:usesUIPattern a owl:ObjectProperty ;
    rdfs:label "uses UI pattern"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:UIPattern .

ipo:visualRepresentationCount a owl:DatatypeProperty ;
    rdfs:label "visual representation count"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Measured count of visual representations on a page (canvas, svg, table, chart-region)."@en .

ipo:voice a owl:DatatypeProperty ;
    rdfs:label "voice"@en ;
    rdfs:domain ipo:WPCArtifact ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:string ;
    skos:definition "Stylistic voice. Allowed values: 'active', 'passive', 'mixed'. Academic convention: active preferred for own work, passive for received methods."@en .

<http://example.org/rdodi/interactive-page-ontology/tbox> a owl:Ontology ;
    rdfs:label "RDODI Interactive Page Ontology tbox v1.9.1 (public edition)"@en ;
    dcterms:created "2026-05-20"^^xsd:date ;
    dcterms:creator <http://example.org/rdodi/agent/YusufAltunel> ;
    dcterms:description "RDODI Interactive Page Ontology tbox. Part of the four-subject RDODI ecosystem: Research, Domain, Document, Interactive Page."@en ;
    dcterms:identifier "interactive_page_ontology_tbox_v1_9_1" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-03"^^xsd:date ;
    dcterms:publisher <http://example.org/rdodi/agent/IstanbulKulturUniversity> ;
    dcterms:rights "Copyright (c) 2026 Yusuf Altunel. Licensed CC BY 4.0."@en ;
    dcterms:rightsHolder <http://example.org/rdodi/agent/YusufAltunel> ;
    rdfs:comment "RDODI tbox for the Interactive Page Ontology. Derived from 04-web-page-construction/web_page_construction_tbox_v7_0_0.ttl (SHA-256 1b70e55d80a3da8ba4406184196dfe743ecdc7af4b3724e4caabd7021bb9dc20). B4 CORRECTION (this release): the prior file, shipped as v1.8.0, carried this header unchanged since v1.0.1 (label/identifier/versionInfo/versionIRI all still read v1.0.1/1.1.0) while a separate, untyped duplicate metadata block elsewhere in the same file asserted versionInfo 1.8.0 on the bare ontology IRI. Consolidated into this single, internally-consistent declaration; the duplicate trailing block removed."@en ;
    owl:versionIRI <http://example.org/rdodi/interactive-page-ontology/tbox/public/1.9.1> ;
    owl:versionInfo "1.9.1" ;
    owl:priorVersion <http://example.org/rdodi/interactive-page-ontology/tbox/1.9.0> ;
    prov:wasAttributedTo <http://example.org/rdodi/agent/YusufAltunel> ;
    prov:wasGeneratedBy <http://example.org/rdodi/activity/RDODIOrigination_v1_0_1> .

ipo:APIFirstCMS a owl:Class ;
    rdfs:label "API-First CMS"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:APIFirstCMS ;
    rdfs:subClassOf ipo:HeadlessCMS ;
    skos:definition "Headless CMS designed with API as primary interface"@en .

ipo:AbbreviationsList a owl:Class ;
    rdfs:label "Abbreviations List"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:ContentRegion ;
    skos:definition "A dedicated ContentRegion (typically near the start or end of a document) that enumerates all Abbreviations used in the artefact, each with its full expansion."@en .

ipo:CDN a owl:Class ;
    rdfs:label "Content Delivery Network"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:CDN,
        ipo:InfrastructureConcept ;
    skos:definition "Distributed network for content delivery"@en .

ipo:CitationLink a owl:Class ;
    rdfs:label "Citation Link"@en ;
    dcterms:source "user's literal feature specification ('linked to external references'); InteractiveHTMLSurface_backlog_roadmap_v1_0_0.md (frozen f5b7be06...), Package S4."@en ;
    skos:definition "A clickable in-text citation marker that jumps to its corresponding entry in the reference list (and, ideally, back). References Package 1's EXISTING doc:CitationForm individuals via ipo:usesCitationForm, rather than duplicating citation-style vocabulary in the interactive-page ontology."@en .

ipo:ClientSideRendering a owl:Class ;
    rdfs:label "Client-Side Rendering"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ClientSideRendering ;
    rdfs:subClassOf ipo:ClientRendering ;
    skos:definition "Rendering content in browser with JavaScript (CSR)"@en .

ipo:CodeExample a owl:Class ;
    rdfs:label "Code Example"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An executable code listing in the SourceDocument or page (e.g., Dockerfile, YAML manifest, language snippet). For HTML pages must be in <pre><code>; inline <code> token references DO NOT count."@en .

ipo:ConversionGoal a owl:Class ;
    rdfs:label "conversion goal"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Defined business outcome of a Page (signup, contact, purchase intent)."@en .

ipo:CrossReferenceType a owl:Class ;
    rdfs:label "cross reference type"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The semantics of a CrossReference. Closed catalogue of 4 named individuals in Core: :relatedContent, :detailedExpansion, :summaryOf, :complementaryView."@en .

ipo:DecoupledCMS a owl:Class ;
    rdfs:label "Decoupled CMS"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:DecoupledCMS ;
    rdfs:subClassOf ipo:ContentManagementSystem ;
    skos:definition "Hybrid approach combining traditional CMS with API capabilities"@en .

ipo:Dialog a owl:Class ;
    rdfs:label "Dialog"@en ;
    dcterms:source "WAI-ARIA role=dialog and role=alertdialog; HTML5 <dialog>; Material Design Dialog (modal and non-modal variants); Apple HIG Sheets/Alerts"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Focused exchange with the user — a contained region where attention is drawn for a single decision or task. Includes both modal variants (Modal) and non-modal variants. Mirrors ARIA's alertdialog ⊆ dialog hierarchy."@en .

ipo:EdgeDeployment a owl:Class ;
    rdfs:label "Edge Deployment"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:EdgeDeployment ;
    rdfs:subClassOf ipo:DeploymentModel ;
    skos:definition "Deploying to edge locations globally"@en .

ipo:Form a owl:Class ;
    rdfs:label "form"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SemanticRegion ;
    skos:definition "A form region (data entry, lead capture, contact)."@en .

ipo:FrameworkAgnosticSSG a owl:Class ;
    rdfs:label "Framework-Agnostic SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:FrameworkAgnosticSSG ;
    rdfs:subClassOf ipo:StaticSiteGenerator ;
    skos:definition "SSG that works with multiple JavaScript frameworks"@en .

ipo:FrontendFramework a owl:Class ;
    rdfs:label "Frontend Framework"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:FrontendFramework,
        ipo:TechnologyArtifact ;
    skos:definition "JavaScript framework for building user interfaces"@en .

ipo:GitBasedCMS a owl:Class ;
    rdfs:label "Git-Based CMS"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:GitBasedCMS ;
    rdfs:subClassOf ipo:ContentManagementSystem ;
    skos:definition "CMS that stores content in Git repositories"@en .

ipo:GoBasedSSG a owl:Class ;
    rdfs:label "Go-Based SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:GoBasedSSG ;
    rdfs:subClassOf ipo:LanguageSpecificSSG ;
    skos:definition "Static site generator written in Go language"@en .

ipo:HostingProvider a owl:Class ;
    rdfs:label "Hosting Provider"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:HostingProvider,
        ipo:InfrastructureConcept ;
    skos:definition "Service for hosting and deploying web applications"@en .

ipo:IncrementalStaticRegeneration a owl:Class ;
    rdfs:label "Incremental Static Regeneration"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:IncrementalStaticRegeneration ;
    rdfs:subClassOf ipo:ServerRendering ;
    skos:definition "Update static pages after build without rebuilding entire site (ISR)"@en .

ipo:JAMstackArchitecture a owl:Class ;
    rdfs:label "JAMstack Architecture"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:JAMstackArchitecture ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "JavaScript, APIs, and Markup architecture pattern"@en .

ipo:MDXProcessor a owl:Class ;
    rdfs:label "MDX Processor"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:MDXProcessor ;
    rdfs:subClassOf ipo:DocumentProcessor ;
    skos:definition "Processor that handles MDX documents with JSX"@en .

ipo:MarkdownProcessor a owl:Class ;
    rdfs:label "Markdown Processor"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:MarkdownProcessor ;
    rdfs:subClassOf ipo:DocumentProcessor ;
    skos:definition "Processor that converts Markdown to HTML"@en .

ipo:MicroservicesArchitecture a owl:Class ;
    rdfs:label "Microservices Architecture"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:MicroservicesArchitecture ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "Application composed of small, independent services"@en .

ipo:MonolithicArchitecture a owl:Class ;
    rdfs:label "Monolithic Architecture"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:MonolithicArchitecture ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "All components in single, unified codebase"@en .

ipo:PartialHydration a owl:Class ;
    rdfs:label "Partial Hydration"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:PartialHydration ;
    rdfs:subClassOf ipo:ClientRendering ;
    skos:definition "Hydrate only interactive components"@en .

ipo:Persona a owl:Class ;
    rdfs:label "Persona"@en ;
    dcterms:source "Cooper, A. (1999) 'The Inmates Are Running the Asylum'"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An archetypal user with named goals, contexts, and constraints. Pages declare the personas they target."@en .

ipo:PrimarySourceProvenance a owl:Class ;
    rdfs:label "Primary Source Provenance"@en ;
    dcterms:source "WPC v6.1.0"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SourceProvenance ;
    skos:definition "The authoritative primary source for an InteractiveLearningSurface — typically the course-assigned textbook chapter or regulatory standard. Content tagged with PrimarySourceProvenance is examinable per the course/standard's stated criteria."@en .

ipo:ProgressiveHydration a owl:Class ;
    rdfs:label "Progressive Hydration"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ProgressiveHydration ;
    rdfs:subClassOf ipo:ClientRendering ;
    skos:definition "Gradually hydrate components as needed"@en .

ipo:QualitySubAspect a owl:Class ;
    rdfs:label "Quality Sub-Aspect"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "For example, AccessibilityCompliance decomposes into KeyboardOperability, ScreenReaderCompatibility, ColorContrastCompliance, FocusManagement, TextAlternativeAvailability, ReducedMotionSupport. This is the sibling form (not subclass of QualityDimension) preserving the canonical 8-dimension set, per OE_Ecosystem_Corrections §6.2."@en .

ipo:ReactBasedSSG a owl:Class ;
    rdfs:label "React-Based SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ReactBasedSSG ;
    rdfs:subClassOf ipo:FrameworkSpecificSSG ;
    skos:definition "Static site generator built on React framework"@en .

ipo:ResponsiveIntent a owl:Class ;
    rdfs:label "responsive intent"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Designed responsive strategy. 4 named individuals."@en .

ipo:ReviewQuestion a owl:Class ;
    rdfs:label "Review Question"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An end-of-section or end-of-chapter question posed by the SourceDocument."@en .

ipo:RubyBasedSSG a owl:Class ;
    rdfs:label "Ruby-Based SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:RubyBasedSSG ;
    rdfs:subClassOf ipo:LanguageSpecificSSG ;
    skos:definition "Static site generator built with Ruby"@en .

ipo:SecondarySourceProvenance a owl:Class ;
    rdfs:label "Secondary Source Provenance"@en ;
    dcterms:source "WPC v6.1.0"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:SourceProvenance ;
    skos:definition "Supplementary content beyond the primary source — drawn from contemporary literature, industry standards (e.g., PMBOK), vendor documentation, or post-publication research. Content tagged with SecondarySourceProvenance is NOT examinable on its own; it's contextual extension."@en .

ipo:ServerSideRendering a owl:Class ;
    rdfs:label "Server-Side Rendering"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ServerSideRendering ;
    rdfs:subClassOf ipo:ServerRendering ;
    skos:definition "Rendering HTML on server for each request (SSR)"@en .

ipo:ServerlessArchitecture a owl:Class ;
    rdfs:label "Serverless Architecture"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ServerlessArchitecture ;
    rdfs:subClassOf ipo:ArchitecturePattern ;
    skos:definition "Architecture using Function-as-a-Service (FaaS)"@en .

ipo:StaticGeneration a owl:Class ;
    rdfs:label "Static Generation"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:StaticGeneration ;
    rdfs:subClassOf ipo:ServerRendering ;
    skos:definition "Pre-rendering pages at build time (SSG)"@en .

ipo:StaticHosting a owl:Class ;
    rdfs:label "Static Hosting"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:StaticHosting ;
    rdfs:subClassOf ipo:DeploymentModel ;
    skos:definition "Hosting pre-built static files"@en .

ipo:Tabs a owl:Class ;
    rdfs:label "Tabs"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "Horizontal or vertical labelled selectors switching content panels."@en .

ipo:Task a owl:Class ;
    rdfs:label "Task"@en ;
    dcterms:source "ISO 9241-11:2018 task efficacy framing"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A goal-directed user activity the page is designed to support. Tasks have success criteria measurable as task-completion rate."@en .

ipo:TemplateEngine a owl:Class ;
    rdfs:label "Template Engine"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:TemplateEngine ;
    rdfs:subClassOf ipo:DocumentProcessor ;
    skos:definition "Engine for processing templates into HTML"@en .

ipo:Threshold a owl:Class ;
    rdfs:label "Threshold"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A boundary value defining pass/fail for an instrument. Below threshold = fail, above = pass (for higher-better metrics); opposite for lower-better metrics (CLS, latency)."@en .

ipo:TraditionalCMS a owl:Class ;
    rdfs:label "Traditional CMS"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:TraditionalCMS ;
    rdfs:subClassOf ipo:ContentManagementSystem ;
    skos:definition "Monolithic CMS where content management and presentation are tightly coupled"@en .

ipo:UsabilityHeuristic a owl:Class ;
    rdfs:label "usability heuristic"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3; Nielsen Norman Group 10 Usability Heuristics (modernized 2024)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A Nielsen Norman Group usability heuristic. 10 named individuals."@en .

ipo:UserJourney a owl:Class ;
    rdfs:label "User Journey"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A multi-page or multi-step path through tasks toward a goal. A page may participate in zero, one, or many journeys."@en .

ipo:VueBasedSSG a owl:Class ;
    rdfs:label "Vue-Based SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:VueBasedSSG ;
    rdfs:subClassOf ipo:FrameworkSpecificSSG ;
    skos:definition "Static site generator built on Vue.js framework"@en .

ipo:hasParent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has parent"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:Page ;
    skos:definition "Links a Page to its parent in the PageHierarchy. Functional — at most one parent."@en .

ipo:CaseStudy a owl:Class ;
    rdfs:label "Case Study"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A running example, opening case, or worked scenario in the SourceDocument."@en .

ipo:ChapterSection a owl:Class ;
    rdfs:label "Chapter Section"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A top-level section of a SourceDocument outline."@en .

ipo:HeadlessCMS a owl:Class ;
    rdfs:label "Headless CMS"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:HeadlessCMS ;
    rdfs:subClassOf ipo:ContentManagementSystem ;
    skos:definition "CMS that separates content repository (body) from presentation layer (head)"@en .

ipo:KeyTerm a owl:Class ;
    rdfs:label "Key Term"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A glossary-style term defined by the SourceDocument."@en .

ipo:LearningObjective a owl:Class ;
    rdfs:label "Learning Objective"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An explicitly stated learning outcome from the SourceDocument (educational sources)."@en .

ipo:MeasuredValue a owl:Class ;
    rdfs:label "Measured Value"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An observed value with timestamp. Bound to an instrument and a measurement context."@en .

ipo:Menu a owl:Class ;
    rdfs:label "Menu"@en ;
    dcterms:source "WAI-ARIA role=menu, role=menubar, role=menuitem; HTML5 <menu>; Material Design Menu (dropdown/context/command-palette variants); Apple HIG Menu"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:UIPattern ;
    skos:definition "List of selectable commands or destinations. Encompasses dropdown menus, context menus, command palettes. Subsumes Dropdown."@en .

ipo:Paragraph a owl:Class ;
    rdfs:label "Paragraph"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:ContentRegion ;
    skos:definition "A discourse unit: a sequence of sentences advancing one topic. Per Williams & Bizup (2017) Style: Lessons in Clarity and Grace, a cohesive paragraph has (a) a topic sentence stating the claim, (b) supporting sentences, (c) transitions to the next paragraph."@en .

ipo:ReferenceList a owl:Class ;
    rdfs:label "Reference List"@en ;
    dcterms:source "APA 7e §2.12 (reference list) / WPC_Ontology_Requirements_v1_0_2 §3.5 page content regions."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:ContentRegion ;
    skos:definition "A content region of a research report page that enumerates the full bibliographic entries cited in the work, rendered as an ordered or formatted list of references. Populated from the research-stage Publication set; its presence and completeness are checked by the reference-rule gate."@en .

ipo:SourceFigure a owl:Class ;
    rdfs:label "Source Figure"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A figure, diagram, or illustration referenced by number in the SourceDocument (e.g., 'Figure 7-3')."@en .

ipo:Target a owl:Class ;
    rdfs:label "Target"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A goal value for an instrument. Pages declare targets they intend to meet."@en .

ipo:DeploymentModel a owl:Class ;
    rdfs:label "Deployment Model"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:DeploymentModel,
        ipo:EngineeringProcess ;
    skos:definition "Method of deploying web applications"@en .

ipo:FrameworkSpecificSSG a owl:Class ;
    rdfs:label "Framework-Specific SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:FrameworkSpecificSSG ;
    rdfs:subClassOf ipo:StaticSiteGenerator ;
    skos:definition "A static site generator that is built upon and requires a specific JavaScript framework, coupling the build tool to the framework's component model and ecosystem."@en .

ipo:InteractionConstraint a owl:Class ;
    rdfs:label "Interaction Constraint"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A measurable constraint on the interactive behaviour or instructional structure of an InteractiveLearningSurface. Constraints fail the Stage 4 SHACL gate when the page's measured property is outside the constraint's prescribed range."@en .

ipo:InteractiveLearningSurface a owl:Class ;
    rdfs:label "Interactive Learning Surface"@en ;
    dcterms:source "WPC v6.1.0 — promotes a class that was previously referenced by Stage 4 ArtifactKindSpec and chapter-page ABoxes (e.g., COM0463 Ch.5 page) without a TBox declaration. v6.1.0 closes this latent vocabulary defect."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Page ;
    skos:definition "A Page rendering an instructional unit (textbook chapter, course module, training material) with interactive widgets that enforce the domain semantics they demonstrate. Examples: COM0463 Ch.5 page (Marchewka 2016 Scope + WBS), COM4061 Ch.6 page (Foundations for Systems Design), COM4061 Ch.7 page (System Architecture)."@en .

ipo:LanguageSpecificSSG a owl:Class ;
    rdfs:label "Language-Specific SSG"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:LanguageSpecificSSG ;
    rdfs:subClassOf ipo:StaticSiteGenerator ;
    skos:definition "A static site generator implemented in a specific programming language where the language choice significantly affects build performance, template capabilities, and plugin ecosystem availability."@en .

ipo:PageLifecycleState a owl:Class ;
    rdfs:label "page lifecycle state"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The current state of a Page in its lifecycle. Closed catalogue of 7 named individuals."@en .

ipo:QualityDimension a owl:Class ;
    rdfs:label "quality dimension"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A dimension along which a WPCArtifact (or Page) is assessed. 8 named individuals: SEOOptimization, PerformanceOptimization, AccessibilityCompliance, DiscoverabilityOptimization, SizeOptimization, SecurityCompliance, PrivacyCompliance, UsabilityOptimization. Each dimension's assessment carries severity per the 5 Specialization Profiles (declared in companion ontologies)."@en .

ipo:RenderingStrategy a owl:Class ;
    rdfs:label "Rendering Strategy"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:EngineeringProcess,
        ipo:RenderingStrategy ;
    skos:definition "Approach for rendering web pages"@en .

ipo:SourceProvenance a owl:Class ;
    rdfs:label "Source Provenance"@en ;
    dcterms:source "WPC v6.1.0 — generalised from COM0463 Ch.5 v2.0.0 provenance-tagging discipline for mixed-source instructional content."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Tags content with the tier of source it derives from, distinguishing primary-source content (the assigned textbook chapter, regulatory standard, customer brief) from secondary-source extensions (supplementary literature, industry standards, vendor documentation)."@en .

ipo:Abbreviation a owl:Class ;
    rdfs:label "Abbreviation"@en ;
    dcterms:source "ISO 80000-1:2009 §6 General principles for symbols and abbreviations; Chicago Manual of Style 17e §10.1 ff."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An abbreviation or acronym used in a WPC artefact. The first use in the artefact must spell out the full name; the artefact must ship an AbbreviationsList enumerating all Abbreviations."@en .

ipo:Cap_UsabilityMetering a owl:Class ;
    rdfs:label "Cap_UsabilityMetering"@en ;
    dcterms:source "Brooke (1996) SUS; Google Core Web Vitals (2024); Real User Monitoring industry practice"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WPCCapability ;
    skos:definition "A Page that declares this capability commits to runtime usability/performance metering: collecting Core Web Vitals, conducting SUS or other satisfaction surveys, recording task completion, or doing Real User Monitoring. Triggers UsabilityOptimization REQUIRED quality assessment via companion SHACL."@en .

ipo:ClientRendering a owl:Class ;
    rdfs:label "Client Rendering"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ClientRendering ;
    rdfs:subClassOf ipo:RenderingStrategy ;
    skos:definition "A family of rendering strategies where all or part of the HTML generation occurs in the user's browser, leveraging JavaScript execution to construct or enhance the page after the initial server response."@en .

ipo:CrossReference a owl:Class ;
    rdfs:label "cross reference"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A graph edge between two Pages, independent of hierarchy. Typed via :hasCrossReferenceType. Enables related-content lists, see-also navigation, etc."@en .

ipo:DocumentProcessor a owl:Class ;
    rdfs:label "Document Processor"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:DocumentProcessor,
        ipo:TechnologyArtifact ;
    skos:definition "Software that transforms documents into web-ready content"@en .

ipo:MeasurementInstrument a owl:Class ;
    rdfs:label "Measurement Instrument"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An instrument used to take a UX measurement against a quality dimension. Each instrument has standard targets and thresholds defined by its source (e.g., Core Web Vitals targets from Google; WCAG criteria from W3C)."@en .

ipo:RunnableCodeTool a owl:Class ;
    rdfs:label "Runnable Code Tool"@en ;
    dcterms:source "user's literal requirement: 'make it language or package independent as we have Python based code executions or any other languages next to SHACL.' Confirmed real gap: enterprise_agentic_kb_v3_39_1's SPARQL query playground (real in-browser interpreter + live graph/table/schema views), inspected this session."@en ;
    skos:definition "A widget that lets the reader write or select code/queries/constraints, EXECUTE them for real against sample data, and see live, synchronized results (table + relationship graph + schema, minimum) -- as distinct from ipo:CodeExample (static display) and ipo:Simulation (a fixed mechanism demo). Deliberately language/package-independent: this class commits to no specific execution technology. Concrete engines are its taxonomy members (rva:AlternativeWidgetRule, one-or-more may be present), not baked into this definition."@en .

ipo:ServerRendering a owl:Class ;
    rdfs:label "Server Rendering"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ServerRendering ;
    rdfs:subClassOf ipo:RenderingStrategy ;
    skos:definition "A family of rendering strategies where HTML is generated on the server or at build time before being delivered to the client, ensuring content is available without client-side JavaScript execution."@en .

ipo:StaticSiteGenerator a owl:Class ;
    rdfs:label "Static Site Generator"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:StaticSiteGenerator,
        ipo:TechnologyArtifact ;
    skos:definition "Tool that generates static HTML pages from templates and content at build time"@en .

ipo:ContentManagementSystem a owl:Class ;
    rdfs:label "Content Management System"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ContentManagementSystem,
        ipo:TechnologyArtifact ;
    skos:definition "System for managing and organizing content"@en .

ipo:ContentRegion a owl:Class ;
    rdfs:label "content region"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.2"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A region of a Page that holds content. Content is provided by Capabilities, by Report integration, or by external sources. Core does NOT prescribe a content typology; that emerges from Capabilities and Report integration per §3.2 lock-in."@en .

ipo:LifecycleTransition a owl:Class ;
    rdfs:label "lifecycle transition"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso prov:Activity ;
    skos:definition "An event in a Page's lifecycle: prior state → next state at a specific time, by a specific agent."@en .

ipo:ResearchReportPage a owl:Class ;
    rdfs:label "Research Report Page"@en ;
    dcterms:source "RDODI four-stage pipeline procedure v1.2.0 §4 (interactive-page stage) / APA 7e report structure."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:Page ;
    skos:definition "The top-level interactive page artifact produced by the RDODI interactive-page stage: a self-contained research report rendered as a navigable web page, composed of ordered report sections (abstract, body, reference list) and bound to the domain and research stage vocabularies that supply its content."@en .

ipo:SpecializedWPCArtifact a owl:Class ;
    rdfs:label "specialized WPC artifact"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §4"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WPCArtifact ;
    skos:definition "A WPCArtifact specialized via one of the 5 Specializations. Subclasses correspond to the 5 specialization profiles."@en .

ipo:Citation a owl:Class ;
    rdfs:label "Citation"@en ;
    dcterms:source "APA Publication Manual 7e; Chicago Manual of Style 17e; IEEE Editorial Style Manual"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:Citation ;
    skos:definition "A reference to an external source — book, paper, standard, web resource. Used by ResearchReports to support Findings and Hypotheses."@en .

ipo:CitationStyle a owl:Class ;
    rdfs:label "Citation Style"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "Bibliographic citation style enumeration. Pre-defined instances: APA7e, IEEE, ChicagoAuthorDate, Vancouver, ISO690. Custom styles MAY be defined as additional instances."@en .

ipo:Hypothesis a owl:Class ;
    rdfs:label "Hypothesis"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A research hypothesis stated and (eventually) tested by the report's Findings."@en .

ipo:ResearchMethod a owl:Class ;
    rdfs:label "Research Method"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:ResearchActivity ;
    skos:definition "A method used in a research investigation (e.g., literature review, content analysis, ontology-driven coding, frequency analysis, taxonomy mapping)."@en .

ipo:ResearchReport a owl:Class ;
    rdfs:label "Research Report"@en ;
    dcterms:source "IMRaD structure (ICMJE Recommendations 2019; APA Publication Manual 7e 2020)"@en ;
    rdfs:comment "DEPRECATED in WPC v6.0.0 per forensic audit v1.0.0. Declaration retained for backward compatibility with v1.0.0/v1.1.0 of the Ch.8 Research Report. New ABoxes should use the canonical property directly. Removal target: WPC v7.0.0."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:subClassOf ipo:WPCArtifact ;
    owl:deprecated true ;
    skos:closeMatch rdodi-research:Publication ;
    skos:definition "A structured research artefact reporting research on a SourceDocument or domain. Typically contains sections for Abstract, Introduction, Methodology, Findings, Discussion, References. May enumerate Findings, cite Citations, and use ResearchMethods."@en .

ipo:ArchitecturePattern a owl:Class ;
    rdfs:label "Architecture Pattern"@en ;
    dcterms:source "WebPageConstruction v2.1.2 extraction (Sprint 0); Audit Coverage Matrix §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:seeAlso ipo:ArchitecturePattern,
        ipo:DesignConcept ;
    skos:definition "Overall system architecture approach"@en .

ipo:QualityAssessment a owl:Class ;
    rdfs:label "quality assessment"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.7"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An assessment of a WPCArtifact along a QualityDimension. Carries severity, evidence, and the assessment date."@en .

ipo:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A discrete result from a research investigation. Each Finding may be supported by Citations and contribute to the report's conclusions."@en .

ipo:InstructionalWidget a owl:Class ;
    rdfs:label "Instructional Widget"@en ;
    dcterms:source "WPC v6.1.0 — generalises the widget patterns observed across COM0463 Ch.5, COM4061 Ch.6, and COM4061 Ch.7 instructional pages."@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A composite interactive UI element whose primary function is teaching a domain concept by ENFORCING the concept's semantics in the input → output behaviour."@en ;
    skos:example "Triple-constraint equilateral-coupled triangle: three sliders that move TOGETHER to preserve equilateral shape. Independent slider movement is mechanically impossible — that's what makes it an InstructionalWidget and not three UIPatterns."@en .

ipo:LayoutPattern a owl:Class ;
    rdfs:label "layout pattern"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A named visual-layout pattern. Closed catalogue of 8."@en .

ipo:SemanticRegion a owl:Class ;
    rdfs:label "semantic region"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.5"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "An HTML5-style landmark role classifying a region's purpose within a Page. Closed catalogue of 8."@en .

ipo:SourceDocument a owl:Class ;
    rdfs:label "Source Document"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "The Page is expected to faithfully represent the document content."@en .

ipo:MacroNavigationPattern a owl:Class ;
    rdfs:label "macro navigation pattern"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A high-level navigation pattern. Closed catalogue of 8: PrimaryNavigation, Breadcrumbs, TableOfContents, Pagination, FacetedNavigation, TagNavigation, RelatedContent, AnchorLinks. Pages declare which they include."@en .

ipo:WayfindingAffordance a owl:Class ;
    rdfs:label "wayfinding affordance"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.3"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A small UI affordance helping users orient and navigate. Closed catalogue of 10: Tooltip, ContextualPopup, HoverPreview, FocusIndicator, CurrentLocationIndicator, ScrollPositionMemory, ProgressIndicator, Tour, Spotlight, UndoAffordance."@en .

ipo:UIPattern a owl:Class ;
    rdfs:label "UI Pattern"@en ;
    dcterms:source "Tidwell, J. (2010) 'Designing Interfaces' (2nd ed.); UI Patterns library (uipatterns.com); Material Design pattern catalogue (Google 2021); WAI-ARIA Authoring Practices (W3C 2024); HTML Living Standard (WHATWG)"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A recurring interactive UI construct. v5.1.0 set: Wizard, Carousel, Accordion, Dialog (with Modal sub-pattern), Drawer, Tabs, Menu (with Dropdown sub-pattern), Toolbar, EmptyState, Skeleton, LoadingSpinner, Button, TextBox, RadioButton, CheckBox, ListBox, Slider, Icon. Each is a recognised pattern with conventional affordances and accessibility expectations."@en .

ipo:WPCArtifact a owl:Class ;
    rdfs:label "WPC artifact"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A single complete WPC product — a website, a web application, an interactive book, a demo. Top-level container. Consists of multiple Pages organized in a PageHierarchy with optional CrossReferences forming a graph overlay."@en .

ipo:Page a owl:Class ;
    rdfs:label "page"@en ;
    dcterms:source "WPC_Ontology_Requirements_v1_0_2 §3.1"@en ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    skos:definition "A single navigable page within a WPCArtifact. Has zero or more ContentRegions, may carry an optional PageLifecycleState (when the artifact's :hasLifecycleAffordance is true), and participates in PageHierarchy (parent/child relations) and CrossReferences (graph overlay)."@en .

<http://example.org/rdodi/interactive-page-ontology> dcterms:bibliographicCitation "Altunel, Y. (2026). MAJOR consolidation release v7.0.0."@en ;
    rdfs:comment "This bare IRI is the WPCArtifact-level ontology identity, distinct from the formally-typed .../tbox owl:Ontology node above. Retained as a citation/lineage anchor only; version tracking for this file lives on the .../tbox node."@en ;
    prov:wasRevisionOf <http://example.org/rdodi/interactive-page-ontology/6.3.0> .

# ---- v1.9.0 addition: Path A (full) — DownloadableResource wiring ----
# Closes PROPOSAL_rdodi_downloadableresource_unwired_REFERENCE_ONLY_NOT_A_RELEASE.md
# (filed by a parallel workstream, 2026-07-06). Trial-verified: SHACL conforms (pyshacl),
# OWL-RL closure raises no contradiction (owlrl; no HermiT jar in this container).

ipo:resourceLocation a owl:DatatypeProperty ;
    rdfs:label "resource location"@en ;
    rdfs:domain ipo:DownloadableResource ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range xsd:anyURI ;
    dcterms:source "PROPOSAL_rdodi_downloadableresource_unwired_REFERENCE_ONLY_NOT_A_RELEASE.md, item 1"@en ;
    skos:definition "The actual location (URL or file path) of a DownloadableResource's content. Absent this property, a DownloadableResource individual could be declared but never actually reached."@en .

ipo:hasDownloadableResource a owl:ObjectProperty ;
    rdfs:label "has downloadable resource"@en ;
    rdfs:domain ipo:Page ;
    rdfs:isDefinedBy <http://example.org/rdodi/interactive-page-ontology> ;
    rdfs:range ipo:DownloadableResource ;
    dcterms:source "PROPOSAL_rdodi_downloadableresource_unwired_REFERENCE_ONLY_NOT_A_RELEASE.md, item 2"@en ;
    skos:definition "Links a Page to a DownloadableResource it references or offers -- e.g. an externally-synthesized artifact (such as an externally synthesized interactive HTML demo) attached to this page. Distinct from ipo:hasOutboundLink (a bare xsd:anyURI on Page with no resource typing): this property preserves the DownloadableResource's own metadata (label, provenance, format) rather than reducing it to a URL string."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( ipo:PrimarySourceProvenance ipo:SecondarySourceProvenance ) .

