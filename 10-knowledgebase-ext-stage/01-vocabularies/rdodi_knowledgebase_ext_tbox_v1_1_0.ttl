@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kb: <http://example.org/rdodi/knowledgebase#> .
@prefix kbx: <http://example.org/rdodi/knowledgebase-ext#> .

<http://example.org/rdodi/knowledgebase-ext> a owl:Ontology ;
    rdfs:label "RDODI Knowledgebase External-Knowledge Extension (Stage KB-EXT, ecosystem v1.12.0)"@en ;
    skos:definition "MINOR v1.1.0 of the KB-EXT vocabulary: additive extension adding the CatalogueAuthorityTier class with four ordered tiers (Definitive > High > Moderate > Low), the hasAuthorityTier property assigning every BibliographicCatalogue to a tier, the tierRank datatype property giving a total order, and the resolvedAtTier property recording the highest authority tier a CatalogueRecord actually reached. Formalises as queryable RDF the DEFINITIVE/HIGH/MODERATE/LOW language previously held only in free-text catalogueAuthorityNote. v1.0.1 surface preserved unchanged (BP-D7 additive MINOR)."@en ;
    owl:versionInfo "1.1.0" ;
    owl:versionIRI <http://example.org/rdodi/knowledgebase-ext/1.1.0> ;
    owl:priorVersion <http://example.org/rdodi/knowledgebase-ext/1.0.0> ;
    owl:priorVersion <http://example.org/rdodi/knowledgebase-ext/1.0.1> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Copyright 2026 Yusuf Altunel. CC BY 4.0."@en ;
    dcterms:rightsHolder <https://example.org/agent/yusuf-altunel> ;
    dcterms:publisher <https://example.org/org/iku-ce> ;
    dcterms:creator <https://example.org/agent/yusuf-altunel> ;
    dcterms:created "2026-05-28"^^xsd:date ;
    dcterms:modified "2026-05-29"^^xsd:date ;
    dcterms:identifier "knowledgebase-ext" ;
    prov:wasGeneratedBy <http://example.org/rdodi/knowledgebase-ext/activity/release-1.1.0> .

<http://example.org/rdodi/knowledgebase-ext/activity/release-1.0.1> a prov:Activity ;
    rdfs:label "KB-EXT TBox PATCH release 1.0.1"@en ;
    prov:startedAtTime "2026-05-29T00:00:00Z"^^xsd:dateTime ;
    skos:definition "Additive PATCH adding catalogue-resolution layer; v1.0.0 classes/properties/individuals unchanged."@en .

# ============================================================
# v1.0.0 TBox surface preserved verbatim
# ============================================================

# ---- External knowledge item ----
kbx:ExternalKnowledgeItem a owl:Class ; rdfs:label "ExternalKnowledgeItem"@en ;
    skos:definition "An ExternalKnowledgeItem is a standard, methodology, tool, best practice, or empirical study originating outside the RDODI pipeline that supplies relevant guidance, verification, or empirical evidence for one or more stages."@en .

kbx:Standard a owl:Class ; rdfs:label "Standard"@en ; rdfs:subClassOf kbx:ExternalKnowledgeItem ;
    skos:definition "A Standard is a formal specification issued by a recognised standards body (ISO, W3C, IETF, IEEE, NIST, OASIS) that the RDODI pipeline can claim alignment with under disciplined evidence."@en .
kbx:Methodology a owl:Class ; rdfs:label "Methodology"@en ; rdfs:subClassOf kbx:ExternalKnowledgeItem ;
    skos:definition "A Methodology is a named procedure or framework guiding how a stage's work is performed (such as PRISMA for systematic review or METHONTOLOGY for ontology engineering)."@en .
kbx:Tool a owl:Class ; rdfs:label "Tool"@en ; rdfs:subClassOf kbx:ExternalKnowledgeItem ;
    skos:definition "A Tool is a concrete software implementation that operationalises a method (Protégé, Sphinx, axe-core, Playwright)."@en .
kbx:BestPractice a owl:Class ; rdfs:label "BestPractice"@en ; rdfs:subClassOf kbx:ExternalKnowledgeItem ;
    skos:definition "A BestPractice is a recognised guideline whose authority derives from community consensus rather than formal standardisation (Nielsen's heuristics, Diátaxis framework)."@en .
kbx:EmpiricalStudy a owl:Class ; rdfs:label "EmpiricalStudy"@en ; rdfs:subClassOf kbx:ExternalKnowledgeItem ;
    skos:definition "An EmpiricalStudy is a published research finding whose results inform pipeline practice (Accelerate's delivery-performance correlations, the cognitive-load-theory literature)."@en .

# ---- Stage applicability ----
kbx:PipelineStage a owl:Class ; rdfs:label "PipelineStage"@en ;
    skos:definition "PipelineStage enumerates the RDODI four-stage pipeline plus a cross-stage governance level so items can be linked to where they best apply."@en .
kbx:Stage1Research a kbx:PipelineStage ; rdfs:label "Stage 1 — Research"@en ;
    skos:definition "Stage 1 produces the research artefact: inventory of named concepts, citation set, scope statement."@en .
kbx:Stage2DomainOntology a kbx:PipelineStage ; rdfs:label "Stage 2 — Domain Ontology"@en ;
    skos:definition "Stage 2 produces the domain ontology: TBox of concepts and properties, ABox of competency-question exemplars, SHACL safeguard."@en .
kbx:Stage3Document a kbx:PipelineStage ; rdfs:label "Stage 3 — Document"@en ;
    skos:definition "Stage 3 produces the human-readable document mapped from domain ontology to chapter sections."@en .
kbx:Stage4InteractivePage a kbx:PipelineStage ; rdfs:label "Stage 4 — Interactive Page"@en ;
    skos:definition "Stage 4 produces the interactive learning surface with widgets, glossary, assessment, and accessibility scaffolding."@en .
kbx:CrossStageGovernance a kbx:PipelineStage ; rdfs:label "Cross-stage Governance"@en ;
    skos:definition "Cross-stage Governance covers items that apply across the pipeline (SemVer, ISO/IEC 25010, CMMI, reproducibility frameworks)."@en .

kbx:appliesToStage a owl:ObjectProperty ; rdfs:label "appliesToStage"@en ;
    skos:definition "The appliesToStage property relates an ExternalKnowledgeItem to one or more PipelineStage individuals where it supplies guidance."@en .

# ---- Knowledge kind ----
kbx:KnowledgeKind a owl:Class ; rdfs:label "KnowledgeKind"@en ;
    skos:definition "KnowledgeKind partitions external items by what they supply so the catalogue does not collapse procedural and verification knowledge into one class."@en .
kbx:ProcessKnowledge a kbx:KnowledgeKind ; rdfs:label "ProcessKnowledge"@en ;
    skos:definition "ProcessKnowledge supplies how-to-do-it guidance (PRISMA, METHONTOLOGY, Diátaxis)."@en .
kbx:StructuralKnowledge a kbx:KnowledgeKind ; rdfs:label "StructuralKnowledge"@en ;
    skos:definition "StructuralKnowledge supplies vocabulary or schema (ISO/IEC 25010, OWL 2, WCAG 2.2 success criteria)."@en .
kbx:VerificationKnowledge a kbx:KnowledgeKind ; rdfs:label "VerificationKnowledge"@en ;
    skos:definition "VerificationKnowledge supplies checking discipline (SHACL, axe-core, OQuaRE)."@en .
kbx:ToolingKnowledge a kbx:KnowledgeKind ; rdfs:label "ToolingKnowledge"@en ;
    skos:definition "ToolingKnowledge supplies concrete implementations (Protégé, Sphinx, Playwright, Pandoc)."@en .
kbx:EmpiricalKnowledge a kbx:KnowledgeKind ; rdfs:label "EmpiricalKnowledge"@en ;
    skos:definition "EmpiricalKnowledge supplies measured findings about practice (Accelerate, cognitive-load studies, Boehm)."@en .

kbx:knowledgeKind a owl:ObjectProperty ; rdfs:label "knowledgeKind"@en ;
    skos:definition "The knowledgeKind property relates an item to its KnowledgeKind."@en .

# ---- Consultation status (v1.0.0 surface preserved) ----
kbx:ConsultationStatus a owl:Class ; rdfs:label "ConsultationStatus"@en ;
    skos:definition "ConsultationStatus mirrors Stage AA's source-consultation discipline for external knowledge: an item is Consulted (verified against the original or against a running implementation), Reconstructed (Claude's account drawn from training-time knowledge, not directly verified), or RequiresConsultation (the reconstructed account is too thin to publish without a primary-source check). PATCH v1.0.1 adds CatalogueVerified as an intermediate tier."@en .
kbx:Consulted a kbx:ConsultationStatus ; rdfs:label "Consulted"@en ;
    skos:definition "Consulted means the item has been verified against its original source or against its running implementation in the current ecosystem (e.g. SHACL is consulted because the pipeline runs pySHACL against published shape graphs)."@en .
kbx:Reconstructed a kbx:ConsultationStatus ; rdfs:label "Reconstructed"@en ;
    skos:definition "Reconstructed means Claude's account of the item is drawn from training-time knowledge without direct consultation of the original at authoring time; the title, purpose, and applicability are recorded but specific claims about content must be verified."@en .
kbx:RequiresConsultation a kbx:ConsultationStatus ; rdfs:label "RequiresConsultation"@en ;
    skos:definition "RequiresConsultation means the reconstructed account is too thin to be relied on; a primary-source check is required before the item can inform a build decision."@en .

kbx:consultationStatus a owl:ObjectProperty ; rdfs:label "consultationStatus"@en ;
    skos:definition "The consultationStatus property relates an ExternalKnowledgeItem to its ConsultationStatus; a missing value is a SHACL Violation by design."@en .

# ---- Bibliographic anchors (v1.0.0) ----
kbx:anchorURL a owl:DatatypeProperty ; rdfs:label "anchorURL"@en ;
    skos:definition "The anchorURL property carries the canonical URL or DOI of the item's primary source."@en .
kbx:standardsBody a owl:DatatypeProperty ; rdfs:label "standardsBody"@en ;
    skos:definition "The standardsBody property names the issuing body of a Standard (ISO, W3C, IETF, IEEE, NIST, OASIS)."@en .
kbx:firstPublished a owl:DatatypeProperty ; rdfs:label "firstPublished"@en ;
    skos:definition "The firstPublished property records the year an item was first published or released."@en .

kbx:contrastsWith a owl:ObjectProperty ; rdfs:label "contrastsWith"@en ;
    skos:definition "The contrastsWith property relates two ExternalKnowledgeItems whose comparison is informative for a build decision."@en ;
    rdfs:domain kbx:ExternalKnowledgeItem ;
    rdfs:range kbx:ExternalKnowledgeItem .

kbx:applicabilityNote a owl:DatatypeProperty ; rdfs:label "applicabilityNote"@en ;
    skos:definition "The applicabilityNote property carries a short verbatim recommendation describing where and how the item best applies in the RDODI pipeline."@en .

# ============================================================
# v1.0.1 ADDITIONS — catalogue resolution layer
# ============================================================

# ---- CatalogueVerified consultation tier ----
kbx:CatalogueVerified a kbx:ConsultationStatus ; rdfs:label "CatalogueVerified"@en ;
    skos:definition "CatalogueVerified means the item's bibliographic metadata (title, author, year, identifier) has been confirmed against an authoritative bibliographic catalogue at a recorded time, but the content of the item has not been directly consulted; CatalogueVerified is a strictly weaker claim than Consulted and is structurally distinct in the ontology so silent promotion is impossible."@en .

# ---- BibliographicCatalogue class ----
kbx:BibliographicCatalogue a owl:Class ; rdfs:label "BibliographicCatalogue"@en ;
    skos:definition "A BibliographicCatalogue is an authoritative external index or database against which an ExternalKnowledgeItem's bibliographic metadata can be confirmed (e.g. ACM Digital Library, IEEE Xplore, Crossref, arXiv, DBLP, W3C TR, IETF RFC index, ISO Online Browsing Platform); a catalogue is itself an ExternalKnowledgeItem of class Tool or Standard, additionally typed BibliographicCatalogue to indicate its resolution role."@en .

kbx:catalogueScope a owl:DatatypeProperty ; rdfs:label "catalogueScope"@en ;
    skos:definition "The catalogueScope property carries a short description of what kinds of works the catalogue indexes (conferences, journals, books, standards, preprints, theses, patents)."@en .
kbx:catalogueAccessModel a owl:DatatypeProperty ; rdfs:label "catalogueAccessModel"@en ;
    skos:definition "The catalogueAccessModel property carries the access model (Open, Subscription, Mixed, NationalBody)."@en .
kbx:catalogueOperator a owl:DatatypeProperty ; rdfs:label "catalogueOperator"@en ;
    skos:definition "The catalogueOperator property carries the operating organisation of the catalogue."@en .
kbx:catalogueAuthorityNote a owl:DatatypeProperty ; rdfs:label "catalogueAuthorityNote"@en ;
    skos:definition "The catalogueAuthorityNote property carries an honest disclosure of the catalogue's curation status; Google Scholar's lack of curation, ResearchGate's deposit-driven model, and similar caveats belong here so a ratifier reading the graph knows what a catalogue hit does and does not prove."@en .

# ---- CatalogueRecord — the intermediate-evidence individual ----
kbx:CatalogueRecord a owl:Class ; rdfs:label "CatalogueRecord"@en ;
    skos:definition "A CatalogueRecord records that an ExternalKnowledgeItem was located in a BibliographicCatalogue at a specific time with a specific resolver identifier; it is the audit-trail evidence behind a kbx:CatalogueVerified status and carries the resolution timestamp (kbx:resolvedAtUTC) so future re-verification can detect drift."@en .

kbx:resolvedIn a owl:ObjectProperty ; rdfs:label "resolvedIn"@en ;
    skos:definition "The resolvedIn property relates a CatalogueRecord to the BibliographicCatalogue in which the item was located."@en .
kbx:resolvedAtUTC a owl:DatatypeProperty ; rdfs:label "resolvedAtUTC"@en ;
    skos:definition "The resolvedAtUTC property carries the ISO-8601 UTC timestamp at which the catalogue resolution was confirmed; required so a future re-check can detect drift if the catalogue record subsequently changes."@en .
kbx:resolvedIdentifier a owl:DatatypeProperty ; rdfs:label "resolvedIdentifier"@en ;
    skos:definition "The resolvedIdentifier property carries the identifier returned by the catalogue (DOI, ISBN, ISSN, arXiv ID, RFC number, W3C TR shortname, ISO catalogue number, DBLP key, ACM DL number)."@en .
kbx:resolvedURL a owl:DatatypeProperty ; rdfs:label "resolvedURL"@en ;
    skos:definition "The resolvedURL property carries the canonical URL returned by the catalogue at the time of resolution."@en .
kbx:resolvedTitle a owl:DatatypeProperty ; rdfs:label "resolvedTitle"@en ;
    skos:definition "The resolvedTitle property carries the title as returned by the catalogue; comparing this to the item's rdfs:label is the basic metadata-correctness check."@en .
kbx:resolvedAuthors a owl:DatatypeProperty ; rdfs:label "resolvedAuthors"@en ;
    skos:definition "The resolvedAuthors property carries the authors as returned by the catalogue, in the catalogue's own format."@en .
kbx:resolvedYear a owl:DatatypeProperty ; rdfs:label "resolvedYear"@en ;
    skos:definition "The resolvedYear property carries the publication year as returned by the catalogue."@en .
kbx:resolverNote a owl:DatatypeProperty ; rdfs:label "resolverNote"@en ;
    skos:definition "The resolverNote property carries optional honest disclosure about the resolution (e.g. partial match, multiple editions, ambiguous record); a manual ratifier can use this field to flag concerns without blocking the resolution."@en .

kbx:catalogueResolution a owl:ObjectProperty ; rdfs:label "catalogueResolution"@en ;
    skos:definition "The catalogueResolution property relates an ExternalKnowledgeItem to one or more CatalogueRecord individuals; an item with kbx:CatalogueVerified status must have at least one catalogueResolution by SHACL (PATCH v1.0.1)."@en ;
    rdfs:domain kbx:ExternalKnowledgeItem ;
    rdfs:range kbx:CatalogueRecord .

# ============================================================
# v1.1.0 ADDITIVE: Catalogue Authority Tier vocabulary
# Formalises the DEFINITIVE/HIGH/MODERATE/LOW authority levels
# that were previously only free-text in kbx:catalogueAuthorityNote.
# ============================================================

kbx:CatalogueAuthorityTier a owl:Class ;
    rdfs:label "Catalogue Authority Tier"@en ;
    skos:definition "A ranked trust level for a BibliographicCatalogue, expressing how much weight a resolution verdict from that catalogue carries. Four tiers form a total order: Definitive (issuing/registration authority for the work, or content-addressed) > High (curated, editorially controlled index for its venue) > Moderate (aggregated or crowd-edited; useful for triangulation, weaker on exact metadata) > Low (uncurated discovery tool, or commercial sales listing; confirms existence only, never metadata correctness). A CatalogueVerified verdict MUST record the highest tier it actually reached so that downstream consumers can see whether 'verified' rests on an authority or merely on a sales listing."@en .

kbx:hasAuthorityTier a owl:ObjectProperty ;
    rdfs:label "has authority tier"@en ;
    rdfs:domain kbx:BibliographicCatalogue ;
    rdfs:range kbx:CatalogueAuthorityTier ;
    skos:definition "Assigns a BibliographicCatalogue to exactly one CatalogueAuthorityTier."@en .

kbx:tierRank a owl:DatatypeProperty ;
    rdfs:label "tier rank"@en ;
    rdfs:domain kbx:CatalogueAuthorityTier ;
    rdfs:range xsd:integer ;
    skos:definition "Total-order rank of an authority tier. Lower number = higher authority. Definitive=1, High=2, Moderate=3, Low=4. Enables SPARQL ordering and 'highest tier reached' computation."@en .

kbx:resolvedAtTier a owl:ObjectProperty ;
    rdfs:label "resolved at tier"@en ;
    rdfs:domain kbx:CatalogueRecord ;
    rdfs:range kbx:CatalogueAuthorityTier ;
    skos:definition "Records the CatalogueAuthorityTier of the catalogue in which this CatalogueRecord's resolution was actually obtained. This is the audit-trail anchor that prevents a Low-tier (commercial listing) resolution from being presented as if it were a High/Definitive verdict."@en .

# The four tier individuals (a SKOS-style ordered code list)

kbx:Tier_Definitive a kbx:CatalogueAuthorityTier ;
    rdfs:label "Definitive"@en ;
    kbx:tierRank 1 ;
    skos:definition "The catalogue IS the issuing, registration, or standards authority for the work, or the identifier is content-addressed (hash-based). A hit is conclusive for existence and for the authority-controlled metadata. Examples: Library of Congress for US-market books (LCCN), ISO OBP for ISO standards, IETF RFC Index, USPTO for US patents, Software Heritage (SWHID)."@en .

kbx:Tier_High a kbx:CatalogueAuthorityTier ;
    rdfs:label "High"@en ;
    kbx:tierRank 2 ;
    skos:definition "A curated, editorially controlled index that is canonical for its venue or discipline, with stable identifiers and human curation. A hit confirms existence and is reliable (not conclusive) for metadata. Examples: Crossref (DOI), DBLP (CS), IEEE Xplore, ACM DL, WorldCat, PubMed, JSTOR, publisher platforms."@en .

kbx:Tier_Moderate a kbx:CatalogueAuthorityTier ;
    rdfs:label "Moderate"@en ;
    kbx:tierRank 3 ;
    skos:definition "An aggregated or crowd-edited source useful for triangulation but weaker on exact metadata correctness. A hit supports existence; metadata should be cross-checked against a High or Definitive source. Examples: OpenAlex, Open Library, Semantic Scholar, Wikidata."@en .

kbx:Tier_Low a kbx:CatalogueAuthorityTier ;
    rdfs:label "Low"@en ;
    kbx:tierRank 4 ;
    skos:definition "An uncurated discovery tool or a commercial sales listing. A hit confirms only that something with that title/identifier exists or is sold at crawl time; it certifies NOTHING about metadata correctness and is never sufficient on its own for a CatalogueVerified verdict at High or above. Examples: Google Scholar, commercial booksellers (Amazon, AbeBooks, Biblio), Goodreads."@en .
