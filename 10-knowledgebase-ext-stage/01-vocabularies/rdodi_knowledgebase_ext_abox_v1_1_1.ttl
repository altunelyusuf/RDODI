# ------------------------------------------------------------
# v1.1.0 ADDITIVE: commercial/crowd-sourced sources as Low-tier
# catalogues (previously used as resolution sources without being
# registered, letting a sales listing pass as CatalogueVerified).
# ------------------------------------------------------------

kbxi:cat_amazon a kbx:BibliographicCatalogue ;
    rdfs:label "Amazon Books"@en ;
    kbx:catalogueAuthorityNote "Commercial bookseller listing. Confirms a sellable edition exists with an ISBN/ASIN at crawl time; metadata is seller-supplied and frequently conflates editions. Never sufficient alone for a High-tier metadata claim."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .

kbxi:cat_abebooks a kbx:BibliographicCatalogue ;
    rdfs:label "AbeBooks"@en ;
    kbx:catalogueAuthorityNote "Commercial used-book marketplace aggregating many sellers; per-listing metadata varies and is not editorially controlled."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .

kbxi:cat_biblio a kbx:BibliographicCatalogue ;
    rdfs:label "Biblio"@en ;
    kbx:catalogueAuthorityNote "Commercial used/rare-book marketplace; same caveat as AbeBooks. LoC fields it copies must be confirmed at the Library of Congress to count as Definitive."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .

kbxi:cat_goodreads a kbx:BibliographicCatalogue ;
    rdfs:label "Goodreads"@en ;
    kbx:catalogueAuthorityNote "Crowd-sourced social-cataloging site (Amazon-owned); user-created edition records, inconsistently merged. Discovery only."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .

kbxi:cat_internet_archive a kbx:BibliographicCatalogue ;
    rdfs:label "Internet Archive / Open Library scans"@en ;
    kbx:catalogueAuthorityNote "Confirms a borrowable scan exists; embedded catalog fields are imported from OCLC/LoC and, where attributed, can be promoted to that source once confirmed there. On its own, Low for metadata."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .

kbxi:cat_publisher_site a kbx:BibliographicCatalogue ;
    rdfs:label "Publisher product page (generic)"@en ;
    kbx:catalogueAuthorityNote "Publisher landing/sales page. For the publisher's own works can be High (issuer of record); for third-party works it is a sales page. Defaults Low when used as a generic web hit; promote per-resolution only when the publisher is the work's actual publisher."@en ;
    kbx:hasAuthorityTier kbx:Tier_Low .


# v1.1.1 PATCH: complete SHACL-required catalogue properties on the 6 commercial catalogues

kbxi:cat_amazon dcterms:source <https://www.amazon.com/> ;
    kbx:catalogueAccessModel "Open (interface)" ;
    kbx:catalogueOperator "Amazon.com, Inc." ;
    kbx:catalogueScope "Commercial retail listings for in-print and many out-of-print books; seller-supplied metadata."@en ;
    kbx:applicabilityNote "Commercial/crowd-sourced source used ONLY as a Low-tier discovery pre-filter; any positive hit must be confirmed in a higher-tier catalogue before a metadata claim (R11)."@en ;
    kbx:appliesToStage kbx:Stage1Research ;
    kbx:knowledgeKind kbx:VerificationKnowledge ;
    kbx:consultationStatus kbx:RequiresConsultation ;
    skos:definition "Amazon.com (Amazon.com, Inc.) — registered at Tier_Low so that a resolution resting on it is visibly low-authority and never mistaken for an authoritative (Definitive/High) verdict."@en .

