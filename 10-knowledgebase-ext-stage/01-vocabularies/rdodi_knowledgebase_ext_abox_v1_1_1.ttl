    dcterms:rightsHolder <https://example.org/agent/yusuf-altunel> ;
    dcterms:source "Additive PATCH to v1.0.0 ABox; loaded together at runtime."@en,
        "Compiled from training-time knowledge of canonical standards bodies and methodology references; each item carries a consultationStatus tag (Consulted/Reconstructed/RequiresConsultation) reflecting BP-D41/L-40 honesty."@en ;
    owl:priorVersion <http://example.org/rdodi/knowledgebase-ext/instance/1.0.0> ;
    owl:versionIRI <http://example.org/rdodi/knowledgebase-ext/instance/1.0.0>,
