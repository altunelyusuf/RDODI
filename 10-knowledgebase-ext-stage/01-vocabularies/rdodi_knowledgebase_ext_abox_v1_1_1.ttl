    kbx:standardsBody "ACM" ;
    dcterms:source "https://www.acm.org/publications/authors/reference-formatting"@en ;
    skos:definition "The ACM Reference Format is mandated for ACM publications and uses a specific numeric or author-year format depending on conference."@en .

