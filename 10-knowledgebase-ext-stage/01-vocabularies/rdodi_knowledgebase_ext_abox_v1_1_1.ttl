<http://example.org/rdodi/knowledgebase-ext/instance> a owl:Ontology ;
    rdfs:label "RDODI KB-EXT ABox PATCH v1.0.1 — catalogues + resolution records"@en,
        "RDODI KB-EXT ABox v1.0.0 — 60 external knowledge items"@en ;
    dcterms:created "2026-05-28"^^xsd:date,
        "2026-05-29"^^xsd:date ;
    dcterms:creator <https://example.org/agent/yusuf-altunel> ;
    dcterms:identifier "knowledgebase-ext/instance" ;
