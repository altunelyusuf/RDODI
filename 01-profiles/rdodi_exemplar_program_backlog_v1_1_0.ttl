# Open (honestly Proposed, unscored)
#################################################################

rex:EP4 a backlog:Epic ;
    rdfs:label "Ratification decision on R16-R21"@en ;
    backlog:hasIdentifier "REX-EP4" ;
    backlog:hasTitle "Governor decides Ratified vs Proposed for the six adopted patterns (with R5, R7, R8, R12, R14 also awaiting)"@en ;
    backlog:hasRationale "kb_gates audit lists 11 patterns AWAITING RATIFICATION after v1.75.0; ratification is a governance decision, not a session decision."@en ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer rex:Backlog ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:contributesToMilestone rex:MS1 ;
    backlog:hasEvidence rex:EV2 ;
    backlog:deliveredInRelease "1.78.0" ;
    backlog:appliesDefinitionOfDone backlog:DoD_Baseline .

rex:EP5 a backlog:Epic ;
    rdfs:label "Wire the R21 gate chain as bootstrap default (Enhancement Plan item C2)"@en ;
    backlog:hasIdentifier "REX-EP5" ;
    backlog:hasTitle "rdodi_bootstrap scaffolds a new byproduct with the four-program chain pre-instantiated from the templates"@en ;
    backlog:hasRationale "Proposal section 7 recommendation; depends on EP4 (making a Proposed pattern the enforced default would front-run ratification)."@en ;
    backlog:hasState backlog:Done ;
    backlog:memberOfContainer rex:Backlog ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:contributesToMilestone rex:MS1 ;
