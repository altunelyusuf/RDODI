rex:EP6 a backlog:Epic ;
    rdfs:label "First post-exemplar byproduct"@en ;
    backlog:hasIdentifier "REX-EP6" ;
    backlog:hasTitle "Run a new byproduct from template instantiation to clean closure healthcheck against the exemplar standard"@en ;
    backlog:hasRationale "The standard is only proven transferable when a byproduct that did not invent the mechanisms passes the bar using them."@en ;
    backlog:hasState backlog:InProgress ;
    backlog:memberOfContainer rex:Backlog ;
    backlog:scheduledInHorizon backlog:Now ;
    backlog:contributesToMilestone rex:MS1 ;
    backlog:notYetScoreable true ;
    backlog:hasScoreabilityReason "Commissioned 2026-08-06: agentic-systems. v0.1.0 scaffold -> v0.2.0 domain ontology -> v0.3.0 Stage 3/4 draft (fidelity 21/21) -> v0.9.0 -> v0.11.0: proceeded with Stage3/4 content per governor. EP10: 5 sections authored for the generator-invisible classes, coverage genuinely 8/8 (one false-negative in own check caught before reporting). Found and reversed a real regression: EP5 had stripped sources verified only against pyshacl, never the real validator gates - restoring them fixed 2 genuine FAILs the fix had silently introduced. All 10 real validator gates now PASS, run directly, not assumed. Roadmap: nothing startable - register genuinely complete." .

rex:EV2 a backlog:ReleaseEvidence ;
    rdfs:label "v1.78.0 ratification + bootstrap-default evidence"@en ;
    backlog:hasIdentifier "REX-EV-2" ;
    skos:definition "EP4: R16-R21 Proposed -> Ratified in rdodi_knowledgebase_abox_v1_6_0.ttl on the governor's 2026-08-06 instruction (recorded in the abox ratification block); kb_gates_v1_1_0 re-run: CERTIFIED, counts Ratified:6, Proposed:5, AlreadyAdoptedAtGateLevel:10. EP5: rdodi_bootstrap_v1_2_0.py scaffolds the R21 four-program chain into every new byproduct by default; PROVEN BY EXECUTION against scp_domain_tbox_v3_17_0 - 03-tooling/ (release_check.sh, healthcheck.py, gate_suite/) plus fitgap_backlog_v0_1_0.ttl delivered into the bootstrapped output, full pipeline ran with its honest advisory items intact. Package hash below is the SHA-256 of MANIFEST_SHA256_v1_77_0.txt, the verified predecessor state (same non-self-reference rule as REX-EV-1); v1.78.0's own manifest hash is recorded in the next changelog."@en ;
    backlog:hasReleaseVersion "1.78.0" ;
    backlog:hasPackageSHA256 "dcdbb7738b1496d18b2910ea79d0d0c87ab4d6d9c8d257779f63f65e10e8a5da" .
