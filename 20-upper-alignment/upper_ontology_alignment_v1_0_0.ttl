@prefix align: <http://example.org/rdodi/upper-alignment#> .
@prefix doc:  <http://example.org/rdodi/document-ontology#> .
@prefix ip:   <http://example.org/rdodi/interactive-page-ontology#> .
@prefix gen:  <http://example.org/rdodi/gen#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

align: a owl:Ontology ; owl:versionInfo "1.0.0" ;
  dct:source "Anchors attributed to BFO (ISO/IEC 21838-2) and IAO." ;
  rdfs:comment "CITE-NOT-IMPORT alignment (L-64): uses skos mapping predicates only; does NOT owl:imports BFO/IAO and imports no upper-ontology axioms. Mappings are PROPOSED — alignment is interpretive; verify the anchor IRIs and the correspondences before any external use."@en .

# Information artifacts -> Information Content Entity (IAO_0000030). PROPOSED, verify.
doc:ReportGenerationArtifact skos:closeMatch obo:IAO_0000030 ;
  rdfs:comment "proposed: a generated document is an information content entity"@en .
ip:Page skos:closeMatch obo:IAO_0000030 ;
  rdfs:comment "proposed: an interactive page is an information content entity"@en .

# Generation activity -> process (BFO_0000015). Already prov:Activity. PROPOSED, verify.
gen:GenerationActivity skos:closeMatch obo:BFO_0000015 ;
  rdfs:comment "proposed: the generation activity is a process"@en .
