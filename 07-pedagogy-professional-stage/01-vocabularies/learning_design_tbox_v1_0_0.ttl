@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix ld: <http://example.org/rdodi/learning-design#> .
<http://example.org/rdodi/learning-design> a owl:Ontology ; rdfs:label "RDODI Learning-Design Vocabulary"@en ;
  owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/rdodi/learning-design/1.0.0> ;
