@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix sc: <http://example.org/rdodi/standards-conformance#> .
<http://example.org/rdodi/standards-conformance> a owl:Ontology ; rdfs:label "RDODI Standards-Conformance Vocabulary (ISO/IEC 25010 + OQuaRE anchored)"@en ;
  owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/rdodi/standards-conformance/1.0.0> ;
